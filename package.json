{
  "name": "markethink",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4322",
    "build": "astro build && node src/scripts/restore-author-portrait-assets.mjs && node src/scripts/generate-ai-discovery.mjs",
    "verify:b2b-editorial-images": "node --experimental-strip-types src/scripts/verify-b2b-editorial-images.mjs",
    "verify:blog-author-attribution": "node --experimental-strip-types src/scripts/verify-blog-author-attribution.mjs",
    "verify:author-profile-attribution": "node --experimental-strip-types src/scripts/verify-author-profile-and-attribution.mjs",
    "verify:guide-contrast": "node src/scripts/verify-guide-contrast.mjs",
    "verify:strategy-library": "node --experimental-strip-types src/scripts/verify-strategy-library.mjs && node --experimental-strip-types src/scripts/verify-new-website-launch-checklist.mjs",
    "verify:website-launch-checklist": "node --experimental-strip-types src/scripts/verify-new-website-launch-checklist.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4322",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.0.5",
    "gsap": "^3.14.2",
    "lenis": "^1.3.19"
  }
}
