<script is:inline>
  const initV6Interactions = () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('v6-interactions-ready');

    const mobileMenu = document.querySelector('[data-mobile-menu]');
    const mobileMenuOpen = document.querySelector('[data-mobile-menu-open]');
    if (mobileMenu && mobileMenuOpen && mobileMenu.dataset.ready !== 'true') {
      mobileMenu.dataset.ready = 'true';
      const closeControls = [...mobileMenu.querySelectorAll('[data-mobile-menu-close]')];
      const setMenu = (open, restoreFocus = false) => {
        mobileMenu.classList.toggle('is-open', open);
        mobileMenu.setAttribute('aria-hidden', String(!open));
        mobileMenuOpen.setAttribute('aria-expanded', String(open));
        mobileMenuOpen.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        document.documentElement.classList.toggle('mobile-menu-open', open);
        if (open) window.setTimeout(() => mobileMenu.querySelector('a,button')?.focus(), reduce ? 0 : 360);
        else if (restoreFocus) mobileMenuOpen.focus();
      };
      mobileMenuOpen.addEventListener('click', () => setMenu(true));
      closeControls.forEach((control) => control.addEventListener('click', () => setMenu(false, control.matches('button'))));
      document.addEventListener('keydown', (event) => {
        if (!mobileMenu.classList.contains('is-open')) return;
        if (event.key === 'Escape') { setMenu(false, true); return; }
        if (event.key !== 'Tab') return;
        const focusable = [...mobileMenu.querySelectorAll('a[href],button:not([disabled])')];
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      });
      window.addEventListener('resize', () => { if (window.innerWidth > 980 && mobileMenu.classList.contains('is-open')) setMenu(false); }, { passive: true });
    }

    const responsiveDashboard = document.querySelector('.hero-dashboard-stage');
    const responsiveHero = document.querySelector('[data-scroll-hero]');
    if (responsiveDashboard && responsiveHero) {
      const fitResponsiveDashboard = () => {
        if (window.innerWidth > 760) {
          responsiveHero.style.removeProperty('--mobile-dashboard-scale');
          responsiveHero.style.removeProperty('--mobile-dashboard-height');
          return;
        }
        const scale = Math.min(1, Math.max(.25, (window.innerWidth - 28) / 1100));
        responsiveHero.style.setProperty('--mobile-dashboard-scale', scale.toFixed(4));
        responsiveHero.style.setProperty('--mobile-dashboard-height', `${Math.round(720 * scale)}px`);
      };
      fitResponsiveDashboard();
      window.addEventListener('resize', fitResponsiveDashboard, { passive: true });
    }

    const trustMarquee = document.querySelector('.trust-marquee');
    if (trustMarquee && trustMarquee.dataset.edgeMotionReady !== 'true') {
      trustMarquee.dataset.edgeMotionReady = 'true';
      const trustLogos = [...trustMarquee.querySelectorAll('.trust-logo')];
      let trustRailVisible = true;

      const paintTrustEdges = () => {
        const marqueeRect = trustMarquee.getBoundingClientRect();
        trustLogos.forEach((logo) => {
          const logoRect = logo.getBoundingClientRect();
          const progress = (logoRect.left + logoRect.width * .5 - marqueeRect.left) / marqueeRect.width;
          if (progress < 0 || progress > 1) {
            logo.style.setProperty('--trust-edge-opacity', '0');
            logo.style.setProperty('--trust-edge-blur', '18px');
            logo.style.setProperty('--trust-edge-scale', '.84');
            return;
          }
          const edgeDistance = Math.min(progress, 1 - progress);
          const edgeMix = Math.max(0, Math.min(1, edgeDistance / .14));
          const easedEdge = edgeMix * edgeMix * (3 - 2 * edgeMix);
          logo.style.setProperty('--trust-edge-opacity', String((.78 * easedEdge).toFixed(3)));
          logo.style.setProperty('--trust-edge-blur', `${((1 - easedEdge) * 18).toFixed(2)}px`);
          logo.style.setProperty('--trust-edge-scale', String((.84 + easedEdge * .16).toFixed(3)));
        });
      };

      if (reduce) {
        trustLogos.forEach((logo) => {
          logo.style.setProperty('--trust-edge-opacity', '.78');
          logo.style.setProperty('--trust-edge-blur', '0px');
          logo.style.setProperty('--trust-edge-scale', '1');
        });
      } else {
        if ('IntersectionObserver' in window) {
          const trustObserver = new IntersectionObserver(([entry]) => {
            trustRailVisible = entry.isIntersecting;
            if (trustRailVisible) paintTrustEdges();
          }, { rootMargin: '80px 0px' });
          trustObserver.observe(trustMarquee);
        }
        const animateTrustEdges = () => {
          if (trustRailVisible) paintTrustEdges();
          requestAnimationFrame(animateTrustEdges);
        };
        paintTrustEdges();
        requestAnimationFrame(animateTrustEdges);
      }
    }

    const connectionsStage = document.querySelector('[data-connections-ecosystem] .connections-stage');
    if (connectionsStage && connectionsStage.dataset.streamReady !== 'true') {
      connectionsStage.dataset.streamReady = 'true';
      const platforms = [...connectionsStage.querySelectorAll('.connection-platform')];
      const cycleMs = 76000;
      const visibleWindow = .70;
      let pathLookup = [];
      let pathWidth = 0;
      let pathHeight = 0;

      const buildPath = () => {
        const rect = connectionsStage.getBoundingClientRect();
        pathWidth = rect.width;
        pathHeight = rect.height;
        const rx = pathWidth * .30;
        const cx = pathWidth * .5;
        const crown = pathHeight * .14;
        const endpoint = pathHeight * .78;
        const drop = endpoint - crown;
        const samples = 720;
        const points = [];
        let total = 0;
        for (let index = 0; index <= samples; index += 1) {
          const progress = index / samples;
          const u = progress * 2 - 1;
          const x = cx + rx * u;
          const y = endpoint - drop * Math.sqrt(Math.max(0, 1 - u * u));
          if (points.length) total += Math.hypot(x - points.at(-1).x, y - points.at(-1).y);
          points.push({ x, y, distance: total });
        }
        pathLookup = points.map((point) => ({ ...point, distance: point.distance / total }));
      };

      const pointAtDistance = (distance) => {
        let low = 0;
        let high = pathLookup.length - 1;
        while (low < high) {
          const middle = Math.floor((low + high) / 2);
          if (pathLookup[middle].distance < distance) low = middle + 1;
          else high = middle;
        }
        const next = pathLookup[low];
        const previous = pathLookup[Math.max(0, low - 1)];
        const span = Math.max(.000001, next.distance - previous.distance);
        const mix = Math.max(0, Math.min(1, (distance - previous.distance) / span));
        return { x: previous.x + (next.x - previous.x) * mix, y: previous.y + (next.y - previous.y) * mix };
      };

      const paintPlatform = (platform, progress) => {
        const point = pointAtDistance(Math.max(0, Math.min(1, progress)));
        const edgeDistance = Math.min(progress, 1 - progress);
        const edgeMix = Math.max(0, Math.min(1, edgeDistance / .14));
        const easedEdge = edgeMix * edgeMix * (3 - 2 * edgeMix);
        platform.style.left = `${point.x}px`;
        platform.style.top = `${point.y}px`;
        platform.style.setProperty('--stream-opacity', easedEdge.toFixed(3));
        platform.style.setProperty('--stream-blur', `${((1 - easedEdge) * 18).toFixed(2)}px`);
        platform.style.setProperty('--stream-scale', (.84 + easedEdge * .16).toFixed(3));
        platform.style.pointerEvents = easedEdge > .8 ? 'auto' : 'none';
      };

      const paintStatic = () => {
        buildPath();
        platforms.forEach((platform, index) => {
          if (index >= 14) return;
          paintPlatform(platform, .055 + index * .0685);
        });
      };

      const animateStream = (time) => {
        if (window.innerWidth <= 680) {
          platforms.forEach((platform) => platform.removeAttribute('style'));
          requestAnimationFrame(animateStream);
          return;
        }
        if (!pathLookup.length || connectionsStage.clientWidth !== pathWidth || connectionsStage.clientHeight !== pathHeight) buildPath();
        const base = (time % cycleMs) / cycleMs;
        platforms.forEach((platform, index) => {
          const phase = (base + index / platforms.length) % 1;
          const windowStart = (1 - visibleWindow) / 2;
          const progress = (phase - windowStart) / visibleWindow;
          if (progress < 0 || progress > 1) {
            platform.style.setProperty('--stream-opacity', '0');
            platform.style.setProperty('--stream-blur', '18px');
            platform.style.setProperty('--stream-scale', '.84');
            platform.style.pointerEvents = 'none';
            return;
          }
          paintPlatform(platform, progress);
        });
        requestAnimationFrame(animateStream);
      };

      if (window.innerWidth > 680) {
        if (reduce) paintStatic();
        else requestAnimationFrame(animateStream);
      }
      window.addEventListener('resize', () => {
        pathLookup = [];
        if (reduce && window.innerWidth > 680) paintStatic();
      }, { passive: true });
    }

    const scrollHero = document.querySelector('[data-scroll-hero]');
    if (scrollHero) {
      const updateHero = () => {
        if (reduce || window.innerWidth <= 760) {
          scrollHero.style.setProperty('--hero-progress', '1');
          return;
        }
        const rect = scrollHero.getBoundingClientRect();
        const distance = Math.max(1, rect.height - window.innerHeight);
        const progress = Math.min(1, Math.max(0, -rect.top / distance));
        scrollHero.style.setProperty('--hero-progress', progress.toFixed(4));
      };
      updateHero();
      window.addEventListener('scroll', updateHero, { passive: true });
      window.addEventListener('resize', updateHero, { passive: true });
    }

    const heroResponse = document.querySelector('[data-hero-response]');
    document.querySelectorAll('[data-hero-capability]:not([aria-hidden="true"])').forEach((card) => {
      const activate = () => {
        document.querySelectorAll('[data-hero-capability]').forEach((item) => item.setAttribute('aria-pressed', String(item === card || item.dataset.heroCapability === card.dataset.heroCapability)));
        const title = card.querySelector('strong')?.textContent;
        if (heroResponse && title) heroResponse.textContent = title;
      };
      card.addEventListener('mouseenter', activate);
      card.addEventListener('focus', activate);
      card.addEventListener('click', activate);
    });

    const workMotion = document.querySelector('[data-work-motion]');
    if (workMotion) {
      const setWorkMotionState = (visible) => workMotion.classList.toggle('is-work-visible', visible);
      if (reduce || !('IntersectionObserver' in window)) setWorkMotionState(true);
      else {
        const workObserver = new IntersectionObserver(([entry]) => {
          setWorkMotionState(entry.isIntersecting && entry.intersectionRatio >= .18);
        }, { threshold: [0, .18, .36], rootMargin: '-8% 0px -8% 0px' });
        workObserver.observe(workMotion);
      }
    }

    const founderSection = document.querySelector('[data-founder-reveal]');
    if (founderSection) {
      const setFounderState = (visible) => founderSection.classList.toggle('is-founder-visible', visible);
      if (reduce || !('IntersectionObserver' in window)) setFounderState(true);
      else {
        const founderObserver = new IntersectionObserver(([entry]) => {
          setFounderState(entry.isIntersecting && entry.intersectionRatio >= .14);
        }, { threshold: [0, .14, .3], rootMargin: '-6% 0px -6% 0px' });
        founderSection.classList.add('founder-motion-armed');
        founderObserver.observe(founderSection);
      }
    }

    const root = document.querySelector('[data-capability-console]');
    if (root) {
      const tabs = [...root.querySelectorAll('[data-capability-tab]')];
      const panels = [...root.querySelectorAll('[data-capability-panel]')];
      const activate = (key) => {
        tabs.forEach((tab) => { const active = tab.dataset.capabilityTab === key; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; });
        panels.forEach((panel) => { const active = panel.dataset.capabilityPanel === key; panel.classList.toggle('is-active', active); panel.setAttribute('aria-hidden', String(!active)); });
      };
      tabs.forEach((tab, index) => {
        ['mouseenter','focus','click'].forEach((event) => tab.addEventListener(event, () => activate(tab.dataset.capabilityTab)));
        tab.addEventListener('keydown', (event) => { if (!['ArrowDown','ArrowUp','ArrowRight','ArrowLeft'].includes(event.key)) return; event.preventDefault(); const direction = ['ArrowDown','ArrowRight'].includes(event.key) ? 1 : -1; const next = tabs[(index + direction + tabs.length) % tabs.length]; next.focus(); activate(next.dataset.capabilityTab); });
      });
      const setLaneCardsState = (visible) => root.classList.toggle('is-visible', visible);
      const setAllLaneCardsVisible = () => tabs.forEach((tab) => tab.classList.add('is-scroll-visible'));
      if (reduce || !('IntersectionObserver' in window)) {
        setLaneCardsState(true);
        setAllLaneCardsVisible();
      }
      else {
        const laneObserver = new IntersectionObserver(([entry]) => {
          setLaneCardsState(entry.isIntersecting && entry.intersectionRatio >= .1);
        }, { threshold: [0, .1, .22], rootMargin: '-5% 0px -5% 0px' });
        laneObserver.observe(root);
        const laneCardObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-scroll-visible', entry.isIntersecting && entry.intersectionRatio >= .12);
          });
        }, { threshold: [0, .12, .3], rootMargin: '-7% 0px -7% 0px' });
        tabs.forEach((tab) => laneCardObserver.observe(tab));
      }
    }

    const changeSection = document.querySelector('[data-change-cards]');
    if (changeSection) {
      const changeCards = [...changeSection.querySelectorAll('.change-card')];
      const changeTimers = new WeakMap();
      const setChangeCardState = (card, visible) => {
        window.clearTimeout(changeTimers.get(card));
        if (!visible) {
          card.classList.remove('is-revealed');
          return;
        }
        const index = changeCards.indexOf(card);
        changeTimers.set(card, window.setTimeout(() => card.classList.add('is-revealed'), index * 120));
      };
      if (reduce || !('IntersectionObserver' in window)) changeCards.forEach((card) => setChangeCardState(card, true));
      else {
        const changeObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => setChangeCardState(entry.target, entry.isIntersecting && entry.intersectionRatio >= .12));
        }, { threshold: [0, .12, .3], rootMargin: '-7% 0px -7% 0px' });
        changeCards.forEach((card) => changeObserver.observe(card));
      }
    }

    const scrollRevealTargets = [
      ['.trust-strip', 'vertical'],
      ['.change-heading', 'vertical'],
      ['.real-work > .wrap', 'vertical'],
      ['.founder > .wrap', 'vertical'],
      ['.lane-center', 'vertical'],
      ['.lane-side-left', 'left'],
      ['.lane-side-right', 'right'],
      ['.connections-heading', 'vertical'],
      ['.connections-stage', 'vertical'],
      ['.connections-foot', 'vertical'],
      ['.operating-flow > .container', 'vertical'],
      ['.faq-heading', 'left'],
      ['.accordions', 'right'],
      ['.footer-audit-form', 'vertical'],
      ['.closing-cta', 'vertical'],
      ['.closing-footer', 'vertical'],
    ].flatMap(([selector, direction]) => [...document.querySelectorAll(selector)].map((element) => ({ element, direction })));

    if (scrollRevealTargets.length) {
      scrollRevealTargets.forEach(({ element, direction }) => {
        element.classList.add('scroll-reveal-item', `scroll-reveal-${direction}`, 'is-below');
      });
      document.documentElement.classList.add('v6-scroll-reveal-ready');

      if (reduce || !('IntersectionObserver' in window)) {
        scrollRevealTargets.forEach(({ element }) => element.classList.add('is-in-view'));
      } else {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const viewportMiddle = entry.rootBounds
              ? entry.rootBounds.top + entry.rootBounds.height / 2
              : window.innerHeight / 2;
            const isVisible = entry.isIntersecting && entry.intersectionRatio >= .06;
            entry.target.classList.toggle('is-in-view', isVisible);
            if (isVisible) {
              entry.target.classList.remove('is-above', 'is-below');
              return;
            }
            const isAbove = entry.boundingClientRect.top < viewportMiddle;
            entry.target.classList.toggle('is-above', isAbove);
            entry.target.classList.toggle('is-below', !isAbove);
          });
        }, { threshold: [0, .06, .16], rootMargin: '-7% 0px -7% 0px' });
        scrollRevealTargets.forEach(({ element }) => revealObserver.observe(element));
      }
    }

    const memory = document.querySelector('[data-memory-demo]');
    if (memory && !reduce) {
      const notes = [...memory.querySelectorAll('[data-memory-step]')]; let active = 0;
      const show = (index) => notes.forEach((note, i) => note.classList.toggle('is-active', i <= index));
      notes.forEach((note, index) => ['mouseenter','focus','click'].forEach((event) => note.addEventListener(event, () => { active = index; show(index); })));
      const observer = new IntersectionObserver(([entry]) => { if (!entry.isIntersecting) return; const timer = setInterval(() => { active = (active + 1) % notes.length; show(active); }, 1800); setTimeout(() => clearInterval(timer), 6500); observer.disconnect(); }, { threshold: .5 });
      observer.observe(memory);
    }
  };
  document.addEventListener('DOMContentLoaded', initV6Interactions, { once: true });
  if (document.readyState !== 'loading') initV6Interactions();
</script>

<style>
