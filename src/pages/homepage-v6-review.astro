---
import Layout from "../layouts/Layout.astro";
import OperatingFlow from "../components/OperatingFlow.astro";
import ReviewHowItWorks from "../components/ReviewHowItWorks.astro";

const heroImage = "/images/hero-v6-reference-phone.svg";
const workImage = "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-work-v1.webp";
const expertsImage = "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-experts-v1.webp";
const changeCards = [
  {
    title: "One business context",
    description: "Your voice, offers, priorities, and approval rules stay connected to the work.",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink-homepage-v6-one-business-context-v1.jpg",
    alt: "A business leader working with connected brand, offer, and approval context",
    tone: "wash",
  },
  {
    title: "One shipping rhythm",
    description: "Website, campaigns, content, and follow-up move as one managed operation.",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink-homepage-v6-one-shipping-rhythm-v1.jpg",
    alt: "Two marketers coordinating a connected production workflow across mobile and desktop",
    tone: "green",
  },
  {
    title: "One accountable team",
    description: "Expert marketers direct and review the work. You keep the final say.",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink-homepage-v6-one-accountable-team-v1.jpg",
    alt: "An expert team reviewing decisions and next steps around a shared workflow",
    tone: "cream",
  },
];

const services = [
  ["Social content", "Written, designed, and published in your brand voice."],
  ["Landing pages and website updates", "Built to convert, shipped to your connected site."],
  ["Email campaigns", "Written, designed, and sent when email is in your plan."],
  ["Advertising", "Managed inside budget limits you approve up front."],
  ["Leads and follow-up", "Capture, CRM, and follow-up running through the channels you connect."],
  ["Reporting with receipts", "Work, approvals, and results, tracked in your dashboard."],
];

const capabilityScenes = [
  { key: "social", image: "/images/homepage-v6-lanes/social-content.svg", title: "Social content", kicker: "From brief to approved post", body: "A channel-ready content set, shaped around your voice and reviewed before it moves.", status: "Ready for review", artifact: "4:5 campaign post" },
  { key: "web", image: "/images/homepage-v6-lanes/web-landing-pages.svg", title: "Web and landing pages", kicker: "From offer to conversion path", body: "A focused page update with the message, hierarchy, and next step working together.", status: "Conversion pass", artifact: "Landing page update" },
  { key: "email", image: "/images/homepage-v6-lanes/email-campaigns.svg", title: "Email campaigns", kicker: "From angle to send-ready", body: "Subject, structure, creative, and call to action prepared as one connected campaign piece.", status: "Approval pending", artifact: "Campaign email" },
  { key: "ads", image: "/images/homepage-v6-lanes/advertising.svg", title: "Advertising", kicker: "From campaign to managed test", body: "Creative and campaign structure prepared inside the scope and budget you approve.", status: "Test plan ready", artifact: "Paid campaign" },
  { key: "leads", image: "/images/homepage-v6-lanes/leads-follow-up.svg", title: "Leads and follow-up", kicker: "From response to next step", body: "New opportunities organized with context, ownership, and the next useful action visible.", status: "Next step assigned", artifact: "Lead follow-up" },
  { key: "reporting", image: "/images/homepage-v6-lanes/reporting-receipts.svg", title: "Reporting with receipts", kicker: "From activity to decisions", body: "Work, approvals, and results stay connected so the next decision starts with evidence.", status: "Decision brief", artifact: "Weekly review" },
];

const heroCapabilities = [
  { icon: "web", title: "Websites & landing pages", note: "Conversion-ready pages" },
  { icon: "campaign", title: "Campaign concepts", note: "One connected idea" },
  { icon: "social", title: "Social content", note: "Designed in your voice" },
  { icon: "email", title: "Email campaigns", note: "From subject to send" },
  { icon: "ads", title: "Paid advertising", note: "Creative built to perform" },
  { icon: "leads", title: "Lead lists", note: "Organized opportunities" },
  { icon: "crm", title: "CRM & follow-up", note: "Every next step visible" },
  { icon: "seo", title: "SEO & content", note: "Built around real intent" },
  { icon: "reporting", title: "Reporting & learnings", note: "Results sharpen the work" },
];

const heroCapabilityRail = [...heroCapabilities, ...heroCapabilities];

const connectedPlatforms = [
  { name: "Google Ads", icon: "/brand-logos/connections/google-ads.svg", mark: null, ring: "outer", x: "7%", y: "18%", delay: "0s" },
  { name: "Meta Ads", icon: "/brand-logos/connections/meta.svg", mark: null, ring: "inner", x: "25%", y: "7%", delay: ".15s" },
  { name: "HubSpot", icon: "/brand-logos/connections/hubspot.svg", mark: null, ring: "outer", x: "49%", y: "2%", delay: ".3s" },
  { name: "Salesforce", icon: "/brand-logos/connections/salesforce.svg", mark: null, ring: "inner", x: "72%", y: "8%", delay: ".45s" },
  { name: "LinkedIn", icon: "/brand-logos/connections/linkedin.svg", mark: null, ring: "outer", x: "91%", y: "20%", delay: ".6s" },
  { name: "Instagram", icon: "/brand-logos/connections/instagram.svg", mark: null, ring: "inner", x: "14%", y: "38%", delay: ".75s" },
  { name: "Facebook", icon: "/brand-logos/connections/facebook.svg", mark: null, ring: "outer", x: "5%", y: "57%", delay: ".9s" },
  { name: "TikTok", icon: "/brand-logos/connections/tiktok.svg", mark: null, ring: "inner", x: "82%", y: "36%", delay: "1.05s" },
  { name: "YouTube", icon: "/brand-logos/connections/youtube.svg", mark: null, ring: "outer", x: "94%", y: "54%", delay: "1.2s" },
  { name: "Mailchimp", icon: "/brand-logos/connections/mailchimp.svg", mark: null, ring: "inner", x: "14%", y: "68%", delay: "1.35s" },
  { name: "Klaviyo", icon: null, mark: "K", ring: "outer", x: "7%", y: "86%", delay: "1.5s" },
  { name: "Shopify", icon: "/brand-logos/connections/shopify.svg", mark: null, ring: "inner", x: "32%", y: "84%", delay: "1.65s" },
  { name: "Google Search Console", icon: "/brand-logos/connections/google-search-console.svg", mark: null, ring: "outer", x: "49%", y: "89%", delay: "1.8s" },
  { name: "Pipedrive", icon: "/brand-logos/connections/pipedrive.svg", mark: null, ring: "inner", x: "67%", y: "84%", delay: "1.95s" },
  { name: "WordPress", icon: "/brand-logos/connections/wordpress.svg", mark: null, ring: "outer", x: "92%", y: "84%", delay: "2.1s" },
  { name: "Webflow", icon: "/brand-logos/connections/webflow.svg", mark: null, ring: "inner", x: "84%", y: "68%", delay: "2.25s" },
  { name: "ActiveCampaign", icon: null, mark: "A", ring: "inner", x: "30%", y: "26%", delay: "2.4s" },
  { name: "Brevo", icon: "/brand-logos/connections/brevo.svg", mark: null, ring: "inner", x: "69%", y: "25%", delay: "2.55s" },
  { name: "PostHog", icon: "/brand-logos/connections/posthog.svg", mark: null, ring: "inner", x: "29%", y: "68%", delay: "2.7s" },
  { name: "Stripe", icon: "/brand-logos/connections/stripe.svg", mark: null, ring: "inner", x: "70%", y: "68%", delay: "2.85s" },
];

const trustLogoPlaceholders = [
  { mark: "diamond", label: "Logo 01" },
  { mark: "bars", label: "Logo 02" },
  { mark: "circle", label: "Logo 03" },
  { mark: "slash", label: "Logo 04" },
  { mark: "hex", label: "Logo 05" },
  { mark: "square", label: "Logo 06" },
  { mark: "ring", label: "Logo 07" },
  { mark: "spark", label: "Logo 08" },
];

const faq = [
  ["Who actually does the work?", "The Markethink team directs strategy, reviews priority work, and stays accountable. The AI marketing system supports production and continuity. You control what ships and set the approval rules."],
  ["Will it sound like my brand?", "That is the first thing the preview proves. When something is off, say so in plain words, in chat. It revises, and it remembers why."],
  ["Do I have to learn new software or replace my tools?", "No. Approvals happen in your connected chat channel, the dashboard is there when you want receipts, and Markethink connects to what you already run. No platform migration is required to get started."],
  ["What does it cost?", "Packages depend on scope. After a walkthrough, you receive a clear recommendation based on the channels, volume, and support your business needs."],
  ["What if the work is not good?", "Reject it and say why. The work is revised, and the correction becomes useful context for what comes next."],
  ["How is this different from an agency or a freelancer?", "Good ones exist. The difference is structural: with Markethink the strategy, production, publishing, and follow-up run as one operation, the knowledge compounds in a business memory instead of leaving with a person or an account team, and every deliverable is timestamped in your dashboard."],
  ["Is my business information safe?", "Client work and business context stay isolated to the appropriate account and approved access."],
  ["What happens when new AI models come out?", "The Markethink team evaluates improvements to the system over time. Your business context remains the foundation, while the operation continues to improve."],
  ["Do you work in Spanish?", "English is the primary language today. Spanish support is available when scoped for the work."],
  ["What do you not do?", "Large rebuilds, migrations, and custom development are scoped separately. Day to day, we ship consistent marketing that compounds, and we are honest about scope."],
];
---

<Layout
  title="Markethink homepage v6 - private review"
  description="Private review of the approved Markethink conversion rewrite."
  canonical="https://markethink.ai/homepage-v6-review/"
  image={heroImage}
  noindex={true}
>
  <div class="review-page">
    <header class="site-header">
      <a class="logo" href="#top" aria-label="Markethink home"><img src="/images/logo-white.svg" alt="Markethink" /></a>
      <nav aria-label="Primary navigation">
        <a href="#how-it-works">How it works</a>
        <a href="#real-work">Real work</a>
        <a href="/blog/">Insights</a>
        <a href="#spanish">ES</a>
        <a href="https://dashboard.markethink.ai/">Log in</a>
      </nav>
      <a class="button button-small button-roll" href="#preview-form"><span class="button-label"><span>Get a campaign preview</span><span aria-hidden="true">Get a campaign preview</span></span></a>
      <button class="mobile-menu-toggle" type="button" aria-label="Open navigation" aria-controls="mobile-menu" aria-expanded="false" data-mobile-menu-open>
        <span></span><span></span>
      </button>
    </header>

    <div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile navigation" aria-hidden="true" data-mobile-menu>
      <div class="mobile-menu-shell">
        <div class="mobile-menu-top">
          <a class="mobile-menu-logo" href="#top" aria-label="Markethink home" data-mobile-menu-close><img src="/images/logo-white.svg" alt="Markethink" /></a>
          <button class="mobile-menu-close" type="button" aria-label="Close navigation" data-mobile-menu-close><span></span><span></span></button>
        </div>
        <nav class="mobile-menu-nav" aria-label="Mobile navigation links">
          <a href="#how-it-works" data-mobile-menu-close><small>01</small><span>How it works</span></a>
          <a href="#real-work" data-mobile-menu-close><small>02</small><span>Real work</span></a>
          <a href="/blog/" data-mobile-menu-close><small>03</small><span>Insights</span></a>
          <a href="#spanish" data-mobile-menu-close><small>04</small><span>Español</span></a>
        </nav>
        <div class="mobile-menu-footer">
          <a class="button mobile-menu-cta" href="#preview-form" data-mobile-menu-close>Get a campaign preview</a>
          <a class="mobile-menu-login" href="https://dashboard.markethink.ai/" data-mobile-menu-close>Log in <span>↗</span></a>
          <p>Powered by AI. Managed by expert marketers.</p>
        </div>
      </div>
    </div>

    <main id="top">
      <section class="hero" data-scroll-hero>
        <div class="hero-sticky">
          <div class="hero-atmosphere" aria-hidden="true">
            <span class="hero-aurora hero-aurora-one"></span>
            <span class="hero-aurora hero-aurora-two"></span>
            <span class="hero-grid"></span>
            <span class="hero-horizon"></span>
          </div>
          <div class="hero-content wrap">
            <p class="eyebrow">Powered by AI. Managed by expert marketers.</p>
            <h1>Your marketing operation,<br /><em>moving every day.</em></h1>
            <p class="hero-copy">Markethink learns your business, ships the work across your channels, and connects every campaign to the pipeline. A real marketing team directs, reviews, and stays accountable.</p>
            <div class="hero-actions">
              <a class="button button-roll" href="#preview-form"><span class="button-label"><span>Get a campaign preview</span><span aria-hidden="true">Get a campaign preview</span></span></a>
              <a class="button button-outline button-roll" href="/schedule-a-walkthrough/"><span class="button-label"><span>Book a walkthrough</span><span aria-hidden="true">Book a walkthrough</span></span></a>
            </div>
          </div>

          <div class="hero-dashboard-stage" aria-label="Illustrative Markethink marketing dashboard">
            <div class="hero-dashboard-glow" aria-hidden="true"></div>
            <div class="hero-depth-panel hero-depth-panel-left" aria-hidden="true">
              <small>Campaign brief</small>
              <strong>One priority, connected work</strong>
              <div><span>Website</span><span>Social</span><span>Email</span></div>
              <em><i></i> In production</em>
            </div>
            <div class="hero-depth-panel hero-depth-panel-right" aria-hidden="true">
              <small>Pipeline connected</small>
              <strong>Campaign to next step</strong>
              <div class="depth-flow"><span></span><i></i><span></span><i></i><span></span></div>
              <em><i></i> Follow-up ready</em>
            </div>
            <div class="hero-dashboard-frame">
              <div class="dashboard-topbar">
                <div class="dashboard-brand"><img src="/images/logo-white.svg" alt="" /><span>Marketing operation</span></div>
                <div class="dashboard-status"><i></i> Work moving now</div>
                <div class="dashboard-avatar" aria-hidden="true">MT</div>
              </div>
              <div class="dashboard-body">
                <aside class="dashboard-sidebar" aria-hidden="true">
                  <span class="is-active">Overview</span><span>Campaigns</span><span>Website</span><span>Social</span><span>Leads</span><span>Approvals</span>
                  <b>Expert team online</b>
                </aside>
                <div class="dashboard-main">
                  <div class="dashboard-heading"><div><small>Thursday overview</small><h2>Good morning. Here is what is moving.</h2></div><button type="button" tabindex="-1">Request new work <span>↗</span></button></div>
                  <div class="dashboard-kpis">
                    <article><small>In production</small><strong>Campaign work</strong><span><i></i> Moving</span></article>
                    <article><small>Needs your decision</small><strong>Approvals</strong><span class="is-warm"><i></i> Ready</span></article>
                    <article><small>Pipeline</small><strong>Lead follow-up</strong><span><i></i> Connected</span></article>
                  </div>
                  <div class="dashboard-grid">
                    <section class="dashboard-work">
                      <div class="panel-title"><div><small>Live production</small><strong>Work moving now</strong></div><span>This week</span></div>
                      <div class="work-row"><i class="work-thumb thumb-web"></i><div><small>Website</small><strong>Campaign landing page</strong><span>Conversion review</span></div><b>In review</b></div>
                      <div class="work-row"><i class="work-thumb thumb-social"></i><div><small>Social</small><strong>Launch content set</strong><span>Creative production</span></div><b>In progress</b></div>
                      <div class="work-row"><i class="work-thumb thumb-email"></i><div><small>Email</small><strong>Follow-up sequence</strong><span>Copy and delivery</span></div><b>Ready</b></div>
                    </section>
                    <section class="dashboard-pipeline">
                      <div class="panel-title"><div><small>Connected pipeline</small><strong>From campaign to next step</strong></div><span>Live</span></div>
                      <div class="pipeline-flow" aria-hidden="true"><span><i></i><b>Campaign</b></span><em></em><span><i></i><b>Lead</b></span><em></em><span><i></i><b>Follow-up</b></span></div>
                      <div class="decision-card"><small>Latest decision applied</small><strong>Lead with the product. Use less copy.</strong><span>Carried into the next deliverable</span></div>
                    </section>
                  </div>
                </div>
              </div>
            </div>
            <p class="dashboard-note"><span></span> Illustrative Markethink workspace</p>
          </div>
          <div class="scroll-cue" aria-hidden="true"><span></span> Scroll to enter the operation</div>
        </div>
      </section>

      <section class="proof-strip section-light" aria-labelledby="proof-title" data-change-cards>
        <div class="wrap">
          <div class="trust-strip" aria-labelledby="trust-title">
            <h2 id="trust-title">They trust us.</h2>
            <div class="trust-marquee" aria-label="Approved client logo placeholders">
              <div class="trust-track">
                <div class="trust-logo-set">
                  {trustLogoPlaceholders.map((logo) => (
                    <span class="trust-logo" role="img" aria-label="Client logo placeholder">
                      <i class={`trust-mark trust-mark-${logo.mark}`} aria-hidden="true"></i>
                      <b>{logo.label}</b>
                    </span>
                  ))}
                </div>
                <div class="trust-logo-set" aria-hidden="true">
                  {trustLogoPlaceholders.map((logo) => (
                    <span class="trust-logo">
                      <i class={`trust-mark trust-mark-${logo.mark}`} aria-hidden="true"></i>
                      <b>{logo.label}</b>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="change-heading">
            <p class="eyebrow dark">What changes</p>
            <h2 id="proof-title">Marketing stops living in separate tabs.</h2>
          </div>
          <div class="change-cards" aria-label="What changes with Markethink">
            {changeCards.map((card, index) => (
              <article class={`change-card change-card-${card.tone}`} tabindex="0" style={`--card-order:${index}`}>
                <div class="change-card-media"><img src={card.image} alt={card.alt} loading="lazy" /></div>
                <div class="change-card-copy">
                  <h3>{card.title}</h3>
                  <p>{card.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

            <section class="real-work" id="real-work" aria-labelledby="work-title">
        <div class="wrap">
          <div class="work-stage" data-work-motion>
            <img class="work-stage-image" src={workImage} alt="An illustrative Markethink campaign workflow with a landing page, campaign system, and coordinated deliverables" loading="lazy" />
            <div class="work-stage-shade" aria-hidden="true"></div>
            <div class="work-stage-content">
              <p class="eyebrow">Work in motion</p>
              <h2 id="work-title">One request.<br /><em>A connected set of finished work.</em></h2>
              <p class="work-stage-lead">Markethink turns the priority into coordinated work across your channels, with expert review before anything moves.</p>
              <div class="work-lanes" aria-label="How work moves through Markethink">
                <article tabindex="0" style="--work-lane-order:0">
                  <span class="work-lane-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h10 M4 12h7 M4 17h6 M16 5l3 3-6.5 6.5-3.5.5.5-3.5z"></path></svg></span>
                  <div><small>Direction</small><strong>The brief resolves the useful move.</strong></div>
                </article>
                <article tabindex="0" style="--work-lane-order:1">
                  <span class="work-lane-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 6h8v5H8z M3 14h6v5H3z M15 14h6v5h-6z M12 11v3 M6 14v-1h12v1"></path></svg></span>
                  <div><small>Connected production</small><strong>The campaign, page, and follow-up share one idea.</strong></div>
                </article>
                <article tabindex="0" style="--work-lane-order:2">
                  <span class="work-lane-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12l5 5L20 6 M4 6h7 M4 18h12"></path></svg></span>
                  <div><small>Expert review</small><strong>The team closes the gap before you approve.</strong></div>
                </article>
              </div>
              <a class="button button-roll" href="#preview-form"><span class="button-label"><span>See what we would ship</span><span aria-hidden="true">See what we would ship</span></span></a>
            </div>
            <p class="work-stage-note"><span></span> Illustrative Markethink workflow</p>
          </div>
        </div>
      </section>

            <section class="founder section-light" aria-labelledby="founder-title" data-founder-reveal>
        <div class="wrap founder-grid">
          <figure class="founder-photo founder-photo-live founder-reveal" style="--founder-order:0">
            <img src="https://dashboard.markethink.ai/generated/landing/markethink/markethink/human-accountability-real-team-v1.jpg" alt="A marketing expert guiding a live review from his workspace" loading="lazy" decoding="async" />
            <span class="founder-green-arc" aria-hidden="true"></span>
          </figure>
          <div class="founder-copy"><p class="eyebrow dark founder-reveal" style="--founder-order:1">Human accountability</p><h2 id="founder-title" class="founder-reveal" style="--founder-order:2">AI carries the volume. People own the calls.</h2><p class="founder-reveal" style="--founder-order:3">Markethink was built for businesses that need consistent execution without losing judgment. A real marketing team directs strategy, reviews priority work, and stays accountable for what moves.</p><p class="founder-reveal" style="--founder-order:4">You approve the commercial decisions. The system keeps the business context, production, and next steps connected.</p><a class="button button-outline button-roll founder-reveal" style="--founder-order:5" href="/schedule-a-walkthrough/"><span class="button-label"><span>Meet the operation</span><span aria-hidden="true">Meet the operation</span></span></a></div>
        </div>
      </section>

      <section class="manages lane-orbit" aria-labelledby="manages-title" data-capability-console>
        <div class="lane-orbit-shell">
          <div class="lane-side lane-side-left" role="tablist" aria-label="Marketing capabilities, first group">
            {capabilityScenes.slice(0, 3).map((scene, index) => (
              <button class="lane-card" type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? "0" : "-1"} data-capability-tab={scene.key} style={`--lane-order:${index}`}>
                <img class="lane-card-image" src={scene.image} alt="" loading="lazy" decoding="async" /><span class="lane-card-copy"><small>{scene.artifact}</small><strong>{scene.title}</strong><em>{scene.kicker}</em></span>
              </button>
            ))}
          </div>

          <div class="lane-center">
            <p class="eyebrow">One connected operation</p>
            <h2 id="manages-title">Choose a lane.<br />See what moves with it.</h2>
            <p class="lane-intro">Each capability is useful alone. The advantage comes from sharing the same context, approvals, and next step.</p>
            <div class="lane-response" aria-live="polite">
              {capabilityScenes.map((scene, index) => (
                <article class={index === 0 ? "is-active" : ""} role="tabpanel" data-capability-panel={scene.key} aria-hidden={index === 0 ? "false" : "true"} style={`--lane-response-image:url("${scene.image}")`}>
                  <small>{scene.status}</small><strong>{scene.kicker}</strong><p>{scene.body}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="lane-side lane-side-right" role="tablist" aria-label="Marketing capabilities, second group">
            {capabilityScenes.slice(3).map((scene, index) => (
              <button class="lane-card" type="button" role="tab" aria-selected="false" tabindex="-1" data-capability-tab={scene.key} style={`--lane-order:${index}`}>
                <img class="lane-card-image" src={scene.image} alt="" loading="lazy" decoding="async" /><span class="lane-card-copy"><small>{scene.artifact}</small><strong>{scene.title}</strong><em>{scene.kicker}</em></span>
              </button>
            ))}
          </div>
        </div>
      </section>

      <section class="connections-ecosystem" aria-labelledby="connections-title" data-connections-ecosystem>
        <div class="wrap connections-heading">
          <p class="eyebrow">Your existing stack</p>
          <h2 id="connections-title">Keep the tools your business already uses.</h2>
          <p>Connections are scoped around your existing channels and approved access. No platform migration is required to begin.</p>
        </div>
        <div class="connections-stage wrap" aria-label="Platforms Markethink can work around, based on approved access and scope">
          <div class="connection-core">
            <span class="connection-core-mark"><img src="/images/logo.svg" alt="" /></span>
            <strong>One connected<br />marketing operation</strong>
