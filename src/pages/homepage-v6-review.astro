---
import Layout from "../layouts/Layout.astro";
import ReviewHowItWorks from "../components/ReviewHowItWorks.astro";
import OperatingFlow from "../components/OperatingFlow.astro";

const outcomes = [
  ["Website", "Pages, offers, landing experiences, and conversion updates"],
  ["Social", "Channel planning, creative, approvals, and publishing rhythm"],
  ["Content", "Campaign copy, articles, email, and brand storytelling"],
  ["Campaigns", "One connected brief across the channels the launch needs"],
  ["Advertising", "Paid campaign planning, creative, and active management"],
  ["Leads", "Opportunity research, lead capture, and commercial next steps"],
  ["CRM + follow-up", "Pipeline visibility, follow-up support, and conversion context"],
];

const questions = [
  ["Is this just another AI tool?", "No. Markethink is an AI marketing system managed by expert marketers. AI supports speed, production, organization, and consistency. A real marketing team owns strategy, review, judgment, and accountability."],
  ["What does it actually manage?", "Depending on scope: website work, social, content, campaigns, advertising, lead capture, CRM support, follow-up, and conversion. The audit identifies the strongest place to start."],
  ["Will the work sound like us?", "Markethink builds from your business context, approved references, voice, visual rules, and feedback. Every approval and correction adds context for the next round."],
  ["Do I have to approve everything?", "You set the approval rules. The Markethink team reviews the work before it reaches you, and final client approval stays with you where required."],
  ["Can it work with our current setup?", "The first step is to map what you already use, what should stay, and what is creating friction. Scope and connections are confirmed before work begins."],
  ["How is our business kept separate?", "Each business operates in its own scoped workspace and context. Access and deliverables stay tied to that business rather than being mixed across client operations."],
  ["What does it cost?", "Packages depend on scope. We recommend the right starting point after reviewing the business, the operating gap, and the channels that matter most."],
];
---

<Layout
  title="Markethink Homepage V6 Review"
  description="Private no-index homepage conversion prototype for Markethink."
  canonical="https://markethink.ai/homepage-v6-review/"
  noindex={true}
>
  <div class="review-ribbon">Private conversion prototype · noindex</div>

  <nav class="review-nav" aria-label="Review page navigation">
    <div class="review-nav-shell">
      <a class="review-logo" href="#top" aria-label="Markethink homepage review top"><img src="/images/logo-white.svg" alt="Markethink" /></a>
      <div class="review-links">
        <a href="#what-it-runs">What it runs</a>
        <a href="#how-it-works">How it works</a>
        <a href="#why-markethink">Why Markethink</a>
      </div>
      <a class="review-cta" href="/schedule-a-walkthrough/">Book a walkthrough</a>
    </div>
  </nav>

  <main id="top">
    <section class="review-hero">
      <figure class="review-hero-media" aria-hidden="true"><img src="/images/hero-phone-workspace.svg" alt="" width="1280" height="720" /></figure>
      <div class="review-hero-scrim"></div>
      <div class="review-container hero-grid">
        <div class="hero-copy">
          <p class="kicker"><span>✦</span> AI marketing system managed by expert marketers</p>
          <h1>Marketing that runs.<br /><em>Not another tool to manage.</em></h1>
          <p class="hero-lead">Markethink learns your business, runs your marketing day to day, and connects the work to leads, follow-up, and conversion.</p>
          <p class="hero-support">Powered by AI for speed and consistency. Directed, reviewed, and managed by a real marketing team.</p>
          <div class="hero-actions">
            <a class="button" href="/schedule-a-walkthrough/">Book a 30-minute walkthrough</a>
            <a class="text-link" href="#how-it-works">See how the operation works <span>↓</span></a>
          </div>
          <p class="scope-note">Packages depend on scope. We start with the clearest operating gap.</p>
        </div>
      </div>
    </section>

    <section class="evidence-gate" aria-label="Launch readiness note">
      <div class="review-container evidence-grid">
        <p><span>PROOF LAYER</span><strong>Reserved for verified work only.</strong></p>
        <p>Client logos, outcomes, testimonials, and named case studies remain out of this prototype until attribution and permission are approved.</p>
      </div>
    </section>

    <section class="outcomes" id="what-it-runs">
      <div class="review-container">
        <header class="split-heading">
          <div><p class="section-label">ONE CONNECTED MARKETING OPERATION</p><h2>Tell Markethink what the business needs. The operation carries it forward.</h2></div>
          <p>Instead of coordinating a collection of disconnected tools and vendors, you work from one business context, one approval rhythm, and one accountable team.</p>
        </header>
        <div class="outcome-grid">
          {outcomes.map(([title, description], index) => (
            <article class={index === 0 || index === 6 ? "outcome-card is-wide" : "outcome-card"}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <i aria-hidden="true">↗</i>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ReviewHowItWorks />

    <section class="operation-intro">
      <div class="review-container split-heading is-dark">
        <div><p class="section-label">FROM REQUEST TO RESULT</p><h2>One request enters. The whole operation starts moving.</h2></div>
        <p>The strongest part of the current homepage stays in place: a clear visual path from request to planning, production, expert review, approval, pipeline, and learning.</p>
      </div>
    </section>
    <OperatingFlow sectionId="request-to-result" includeInstagram={false} />

    <section class="difference" id="why-markethink">
      <div class="review-container">
        <header class="center-heading">
          <p class="section-label">WHY THE WORK GETS SHARPER</p>
          <h2>Marketing usually resets.<br />Markethink builds memory.</h2>
          <p>Most marketing loses context between people, tools, and projects. Markethink is designed to carry what the business has already approved into what happens next.</p>
        </header>
        <div class="memory-grid">
          <article><span>01</span><h3>It remembers</h3><p>Your offers, audience, voice, visual rules, decisions, and approval history stay connected to the operation.</p></article>
          <article class="featured"><span>02</span><h3>It applies</h3><p>That context shapes briefs, campaigns, website work, content, follow-up, and the next commercial action.</p></article>
          <article><span>03</span><h3>It compounds</h3><p>Every approval, correction, and result helps the next round start with more useful context.</p></article>
        </div>

        <div class="comparison-wrap">
          <div class="comparison-head"><p class="section-label">A FAIR COMPARISON</p><h3>Different operating models solve different problems.</h3></div>
          <div class="comparison-table" role="table" aria-label="Marketing operating model comparison">
            <div class="comparison-row comparison-labels" role="row"><span role="columnheader">Model</span><span role="columnheader">Strongest fit</span><span role="columnheader">Where the burden sits</span></div>
            <div class="comparison-row" role="row"><strong role="cell">In-house hire</strong><span role="cell">Deep internal ownership</span><span role="cell">Hiring, tools, specialist gaps, and management remain internal</span></div>
            <div class="comparison-row" role="row"><strong role="cell">Traditional agency</strong><span role="cell">Campaign expertise and external perspective</span><span role="cell">Scope, handoffs, and business context often stay fragmented</span></div>
            <div class="comparison-row" role="row"><strong role="cell">Freelancers + tools</strong><span role="cell">Flexible specialist support</span><span role="cell">You coordinate the work and carry the operating context</span></div>
            <div class="comparison-row is-markethink" role="row"><strong role="cell">Markethink</strong><span role="cell">A connected day-to-day marketing operation</span><span role="cell">AI handles volume while experts own direction, review, and accountability</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="first-month" id="first-30-days">
      <div class="review-container">
        <header class="split-heading">
          <div><p class="section-label">YOUR FIRST 30 DAYS</p><h2>Start useful. Then build the operating rhythm.</h2></div>
          <p>The first month focuses on understanding the business, organizing the context, shipping the first priority, and making the next move clear.</p>
        </header>
        <div class="month-grid">
          <article><span>DAY 1</span><h3>Build the foundation</h3><p>Map the website, offers, audience, voice, visuals, priorities, and approval rules.</p></article>
          <article><span>WEEK 1</span><h3>Ship the first work</h3><p>Move the agreed first priority from brief to expert review and approval.</p></article>
          <article><span>EVERY WEEK</span><h3>Run the operation</h3><p>Keep campaigns, pages, content, and follow-up moving within the agreed scope.</p></article>
          <article><span>OVER TIME</span><h3>Carry context forward</h3><p>Use approvals, corrections, and results to sharpen what happens next.</p></article>
        </div>
        <div class="roles-band">
          <div><span>AI supports</span><strong>Research, drafts, production, organization, and consistency</strong></div>
          <div><span>Expert marketers own</span><strong>Strategy, review, judgment, priorities, and accountability</strong></div>
          <div><span>You control</span><strong>Approvals, corrections, commercial decisions, and final direction</strong></div>
        </div>
      </div>
    </section>

    <section class="fit-section">
      <div class="review-container fit-grid">
        <div class="fit-copy"><p class="section-label">WHO THIS IS FOR</p><h2>For businesses ready to replace fragmented effort with a real operating rhythm.</h2><p>Markethink is built for growing brands and agency partners that need consistent execution without leaving strategy and quality control to a self-serve tool.</p></div>
        <div class="fit-cards">
          <article><span>GROWING BRANDS</span><h3>Run marketing without building every capability in-house.</h3><p>Connect the website, campaigns, content, advertising, leads, and follow-up around one business context.</p></article>
          <article><span>AGENCY PARTNERS</span><h3>Add delivery capacity without adding client chaos.</h3><p>Give each client a scoped operation while your agency keeps the relationship and commercial direction.</p></article>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="review-container faq-grid">
        <div><p class="section-label">COMMON QUESTIONS</p><h2>Clear answers before the walkthrough.</h2><p>No invented guarantees. No self-serve AI pitch. Just the operating model, the boundaries, and the next step.</p></div>
        <div class="faq-list">
          {questions.map(([question, answer], index) => (
            <details open={index === 0}><summary>{question}<span>+</span></summary><p>{answer}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="review-container final-grid">
        <div><p class="section-label">YOUR MARKETING OPERATION</p><h2>See what Markethink would run first.</h2><p>Bring the current website, the growth target, and the bottleneck. We will map the strongest starting point and the scope needed to support it.</p></div>
        <div class="final-actions"><a class="button" href="/schedule-a-walkthrough/">Book a 30-minute walkthrough</a><span>Packages depend on scope.</span></div>
      </div>
    </section>
  </main>

  <footer class="review-footer"><div class="review-container"><img src="/images/logo-white.svg" alt="Markethink" /><p>Your marketing operation, powered by AI and managed by experts.</p><a href="/privacy/">Privacy</a></div></footer>
</Layout>

<style>
  .review-container { width: min(1180px, calc(100% - 2rem)); margin-inline: auto; }
  .review-ribbon { position: fixed; z-index: 1200; top: 0; left: 0; right: 0; min-height: 1.7rem; display: grid; place-items: center; padding: 0.3rem 1rem; background: #69d254; color: #0f1213; font-size: 0.64rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .review-nav { position: absolute; z-index: 1100; top: 1.7rem; left: 0; right: 0; padding: 1rem; }
  .review-nav-shell { width: min(1240px, 100%); min-height: 4.7rem; margin-inline: auto; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 2rem; padding: 0.75rem 1rem; border: 1px solid rgba(255,255,255,.14); border-radius: 1.25rem; background: rgba(15,18,19,.78); backdrop-filter: blur(20px); }
  .review-logo img { width: 175px; }
  .review-links { display: flex; justify-content: center; gap: clamp(1rem,3vw,2.6rem); font-size: .85rem; font-weight: 650; }
  .review-cta { padding: .78rem 1.1rem; border-radius: .7rem; background: #69d254; color: #0f1213; font-size: .82rem; font-weight: 800; }
  .review-hero { position: relative; min-height: min(62rem, 100svh); display: flex; align-items: center; overflow: hidden; background: #f5f5f1; color: #0f1213; }
  .review-hero-media { position: absolute; inset: 0; margin: 0; }
  .review-hero-media img { width: 100%; height: 100%; object-fit: cover; }
  .review-hero-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(245,245,241,.98) 0%, rgba(245,245,241,.91) 30%, rgba(245,245,241,.38) 51%, transparent 68%); }
  .hero-grid { position: relative; z-index: 2; padding-top: 7rem; }
  .hero-copy { max-width: 34rem; }
  .kicker { display: inline-flex; align-items: center; gap: .55rem; margin-bottom: 1.3rem; padding: .55rem .8rem; border-radius: 999px; background: rgba(237,244,234,.8); color: #299b2c; font-size: .65rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .review-hero h1 { font-size: clamp(3.55rem, 6.1vw, 6.6rem); line-height: .9; letter-spacing: -.06em; }
  .review-hero h1 em { color: #35aa35; font-style: normal; }
  .hero-lead { max-width: 31rem; margin-top: 1.5rem; font-size: clamp(1.08rem,1.35vw,1.25rem); font-weight: 680; line-height: 1.55; }
  .hero-support { max-width: 29.5rem; margin-top: .7rem; color: rgba(15,18,19,.62); line-height: 1.65; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.1rem; margin-top: 1.8rem; }
  .text-link { color: #0f1213; font-size: .9rem; font-weight: 750; }
  .text-link span { margin-left: .4rem; color: #299b2c; }
  .scope-note { margin-top: 1rem; color: rgba(15,18,19,.44); font-size: .72rem; }
  .evidence-gate { padding: 1.25rem 0; background: #edf4ea; color: #0f1213; border-block: 1px solid rgba(15,18,19,.08); }
  .evidence-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 2rem; align-items: center; }
  .evidence-grid p { color: rgba(15,18,19,.56); font-size: .78rem; line-height: 1.55; }
  .evidence-grid p:first-child { display: flex; align-items: center; gap: .8rem; color: #0f1213; }
  .evidence-grid p span { color: #299b2c; font-size: .62rem; font-weight: 850; letter-spacing: .1em; }
  .outcomes, .difference, .first-month, .faq-section { padding: clamp(5rem,9vw,8rem) 0; background: #f5f5f1; color: #0f1213; }
  .split-heading { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(18rem,.62fr); gap: 3rem; align-items: end; margin-bottom: 3rem; }
  .split-heading h2, .center-heading h2, .fit-copy h2, .faq-grid h2, .final-grid h2 { margin-top: .85rem; font-size: clamp(2.9rem,5vw,5rem); line-height: .96; letter-spacing: -.04em; }
  .split-heading > p { color: rgba(15,18,19,.6); line-height: 1.72; }
  .section-label { color: #299b2c; font-size: .68rem; font-weight: 850; letter-spacing: .12em; }
  .outcome-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .85rem; }
  .outcome-card { position: relative; min-height: 16rem; padding: 1.25rem; overflow: hidden; border: 1px solid rgba(15,18,19,.08); border-radius: 1.2rem; background: #edf4ea; }
  .outcome-card.is-wide { grid-column: span 2; background: #0f1213; color: #f5f5f1; }
  .outcome-card > span { color: #299b2c; font-size: .68rem; font-weight: 800; }
  .outcome-card.is-wide > span { color: #69d254; }
  .outcome-card h3 { margin-top: 2.7rem; font-size: 2rem; }
  .outcome-card p { max-width: 26rem; margin-top: .65rem; color: rgba(15,18,19,.58); font-size: .86rem; line-height: 1.6; }
  .outcome-card.is-wide p { color: rgba(245,245,241,.6); }
  .outcome-card i { position: absolute; right: 1rem; top: 1rem; color: #299b2c; font-style: normal; }
  .operation-intro { padding: 6rem 0 0; background: #0f1213; color: #f5f5f1; }
  .split-heading.is-dark { margin-bottom: 0; }
  .split-heading.is-dark > p { color: rgba(245,245,241,.62); }
  .center-heading { max-width: 58rem; margin-inline: auto; text-align: center; }
  .center-heading > p:last-child { max-width: 44rem; margin: 1.2rem auto 0; color: rgba(15,18,19,.6); line-height: 1.7; }
  .memory-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: .9rem; margin-top: 3rem; }
  .memory-grid article { min-height: 21rem; padding: 1.4rem; border: 1px solid rgba(15,18,19,.09); border-radius: 1.35rem; background: #edf4ea; }
  .memory-grid article.featured { transform: translateY(-1rem); background: #0f1213; color: #f5f5f1; box-shadow: 0 26px 60px rgba(15,18,19,.16); }
  .memory-grid span { display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border-radius: 50%; background: #69d254; color: #0f1213; font-size: .7rem; font-weight: 850; }
  .memory-grid h3 { margin-top: 5rem; font-size: 2.4rem; }
  .memory-grid p { margin-top: .8rem; color: rgba(15,18,19,.6); font-size: .88rem; line-height: 1.65; }
  .memory-grid .featured p { color: rgba(245,245,241,.64); }
  .comparison-wrap { margin-top: 5rem; padding: clamp(1.2rem,3vw,2rem); border-radius: 1.5rem; background: #edf4ea; }
  .comparison-head { display: grid; grid-template-columns: .5fr 1fr; gap: 2rem; align-items: end; margin-bottom: 1.5rem; }
  .comparison-head h3 { font-size: clamp(2rem,3.2vw,3.2rem); line-height: 1; }
  .comparison-table { overflow: hidden; border: 1px solid rgba(15,18,19,.09); border-radius: 1rem; background: #f5f5f1; }
  .comparison-row { display: grid; grid-template-columns: .55fr .8fr 1.35fr; gap: 1rem; padding: 1rem; border-top: 1px solid rgba(15,18,19,.08); font-size: .82rem; line-height: 1.5; }
  .comparison-row:first-child { border-top: 0; }
  .comparison-labels { color: rgba(15,18,19,.46); font-size: .64rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .comparison-row.is-markethink { background: #0f1213; color: #f5f5f1; }
  .month-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: .8rem; }
  .month-grid article { min-height: 18rem; padding: 1.2rem; border: 1px solid rgba(15,18,19,.08); border-radius: 1.15rem; background: #edf4ea; }
  .month-grid span, .roles-band span, .fit-cards span { color: #299b2c; font-size: .65rem; font-weight: 850; letter-spacing: .1em; }
  .month-grid h3 { margin-top: 4rem; font-family: var(--font-body); font-size: 1.05rem; font-weight: 750; }
  .month-grid p { margin-top: .7rem; color: rgba(15,18,19,.58); font-size: .82rem; line-height: 1.62; }
  .roles-band { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 1rem; overflow: hidden; border-radius: 1.2rem; background: #0f1213; color: #f5f5f1; }
  .roles-band div { min-height: 10rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; padding: 1.2rem; border-left: 1px solid rgba(255,255,255,.1); }
  .roles-band div:first-child { border-left: 0; }
  .roles-band span { color: #69d254; }
  .roles-band strong { color: rgba(245,245,241,.7); font-size: .82rem; line-height: 1.55; }
  .fit-section { padding: clamp(5rem,9vw,8rem) 0; background: #edf4ea; color: #0f1213; }
  .fit-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem,6vw,5rem); align-items: start; }
  .fit-copy { position: sticky; top: 4rem; }
  .fit-copy p:last-child { margin-top: 1rem; color: rgba(15,18,19,.6); line-height: 1.7; }
  .fit-cards { display: grid; gap: 1rem; }
  .fit-cards article { min-height: 20rem; padding: clamp(1.3rem,3vw,2rem); border-radius: 1.4rem; background: #f5f5f1; }
  .fit-cards article:last-child { background: #0f1213; color: #f5f5f1; }
  .fit-cards article:last-child span { color: #69d254; }
  .fit-cards h3 { max-width: 34rem; margin-top: 4.5rem; font-size: clamp(2.1rem,3.5vw,3.4rem); line-height: 1; }
  .fit-cards p { max-width: 33rem; margin-top: .9rem; color: rgba(15,18,19,.58); line-height: 1.65; }
  .fit-cards article:last-child p { color: rgba(245,245,241,.62); }
  .faq-section { background: #f5f5f1; }
  .faq-grid { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem,7vw,6rem); }
  .faq-grid > div:first-child { position: sticky; top: 4rem; align-self: start; }
  .faq-grid > div:first-child > p:last-child { margin-top: 1rem; color: rgba(15,18,19,.58); line-height: 1.7; }
  .faq-list details { border-top: 1px solid rgba(15,18,19,.12); }
  .faq-list details:last-child { border-bottom: 1px solid rgba(15,18,19,.12); }
  .faq-list summary { display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem 0; cursor: pointer; font-weight: 720; list-style: none; }
  .faq-list summary span { color: #299b2c; font-size: 1.1rem; }
  .faq-list details p { max-width: 42rem; padding: 0 2rem 1.25rem 0; color: rgba(15,18,19,.58); font-size: .9rem; line-height: 1.65; }
  .final-cta { padding: clamp(5rem,9vw,8rem) 0; background: #0f1213; color: #f5f5f1; }
  .final-grid { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: end; }
  .final-grid > div:first-child > p:last-child { max-width: 41rem; margin-top: 1rem; color: rgba(245,245,241,.62); line-height: 1.7; }
  .final-actions { display: grid; gap: .8rem; justify-items: start; }
  .final-actions span { color: rgba(245,245,241,.42); font-size: .72rem; }
  .review-footer { padding: 2rem 0; border-top: 1px solid rgba(255,255,255,.08); background: #0f1213; }
  .review-footer .review-container { display: flex; align-items: center; gap: 2rem; }
  .review-footer img { width: 150px; }
  .review-footer p { flex: 1; color: rgba(245,245,241,.4); font-size: .72rem; text-align: center; }
  .review-footer a { color: rgba(245,245,241,.58); font-size: .72rem; }

  @media (max-width: 900px) {
    .review-links { display: none; }
    .review-nav-shell { grid-template-columns: 1fr auto; }
    .review-hero { min-height: auto; padding-top: 8rem; align-items: flex-start; }
    .review-hero-media { top: auto; height: 28rem; }
    .review-hero-scrim { background: linear-gradient(180deg,#f5f5f1 0%,#f5f5f1 58%,rgba(245,245,241,.55) 73%,transparent 90%); }
    .hero-grid { padding: 2rem 0 28rem; }
    .hero-copy { margin-inline: auto; text-align: center; }
    .hero-actions { justify-content: center; }
    .split-heading, .fit-grid, .faq-grid, .final-grid { grid-template-columns: 1fr; gap: 1.3rem; }
    .outcome-grid { grid-template-columns: repeat(2,1fr); }
    .outcome-card.is-wide { grid-column: span 1; }
    .memory-grid, .month-grid { grid-template-columns: repeat(2,1fr); }
    .memory-grid article.featured { transform: none; }
    .fit-copy, .faq-grid > div:first-child { position: static; }
    .final-actions { margin-top: 1rem; }
  }

  @media (max-width: 640px) {
    .review-nav { padding: .65rem; }
