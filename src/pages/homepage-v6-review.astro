                convert: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-phone-crm-v1.jpg",
                learn: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-phone-learn-v1.jpg",
