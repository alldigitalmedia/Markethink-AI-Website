  :global(body){margin:0;background:#0F1213;color:#F5F5F1;font-family:Inter,system-ui,sans-serif}
  :global(*){box-sizing:border-box}
  .review-page{overflow-x:clip;background:#0F1213}
  .wrap{width:min(1200px,calc(100% - 48px));margin:0 auto}
