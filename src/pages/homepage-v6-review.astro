8|const expertsImage = "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-verbatim-experts.png";
9|
10|const services = [
11|  ["Social content", "Written, designed, and published in your brand voice."],
12|  ["Landing pages and website updates", "Built to convert, shipped to your connected site."],
13|  ["Email campaigns", "Written, designed, and sent when email is in your plan."],
14|  ["Advertising", "Managed inside budget limits you approve up front."],
15|  ["Leads and follow-up", "Capture, CRM, and follow-up running through the channels you connect."],
16|  ["Reporting with receipts", "Work, approvals, and results, tracked in your dashboard."],
17|];
18|
19|const heroCapabilities = [
20|  { icon: "web", title: "Websites & landing pages", note: "Conversion-ready pages" },
21|  { icon: "campaign", title: "Campaign concepts", note: "One connected idea" },
22|  { icon: "social", title: "Social content", note: "Designed in your voice" },
23|  { icon: "email", title: "Email campaigns", note: "From subject to send" },
24|  { icon: "ads", title: "Paid advertising", note: "Creative built to perform" },
25|  { icon: "leads", title: "Lead lists", note: "Organized opportunities" },
26|  { icon: "crm", title: "CRM & follow-up", note: "Every next step visible" },
27|  { icon: "seo", title: "SEO & content", note: "Built around real intent" },
28|  { icon: "reporting", title: "Reporting & learnings", note: "Results sharpen the work" },
29|];
30|
31|const heroCapabilityRail = [...heroCapabilities, ...heroCapabilities];
32|
33|const faq = [
34|  ["Who actually does the work?", "AI grounded in your business context and memory handles production. Senior marketing, design, web, and advertising specialists direct the work and review what ships; nothing goes out as raw AI output. You control what ships and set the approval rules. The preview shows you how it sounds before you pay anything."],
35|  ["Will it sound like my brand?", "That is the first thing the preview proves. When something is off, say so in plain words, in chat. It revises, and it remembers why."],
36|  ["Do I have to learn new software or replace my tools?", "No. Approvals happen in your connected chat channel, the dashboard is there when you want receipts, and Markethink connects to what you already run. No platform migration is required to get started."],
37|  ["What does it cost?", "A monthly plan scoped to your business. You get your exact number after one 30-minute walkthrough, before any commitment. For comparison, agencies delivering this work typically charge $3,000 to $15,000 a month."],
38|  ["What if the work is not good?", "Reject it in one tap and say why. The system revises and learns your standard. [First-month commitment terms, once finalized.]"],
39|  ["How is this different from an agency or a freelancer?", "Good ones exist. The difference is structural: with Markethink the strategy, production, publishing, and follow-up run as one operation, the knowledge compounds in a business memory instead of leaving with a person or an account team, and every deliverable is timestamped in your dashboard."],
40|  ["Is my business information safe?", "Each client's agent workspace and data access are tenant-isolated. Your data, voice, and strategy are never shared across clients."],
41|  ["What happens when new AI models come out?", "That is our job, not yours. We continuously evaluate the best AI systems across reasoning, creative, image, and video, and integrate what wins into Markethink. Your business memory stays, the work gets sharper, and you are already on whatever wins."],
42|  ["Do you work in Spanish?", "Sí. English, Spanish, or both, native in each."],
43|  ["What do you not do?", "Large rebuilds, migrations, and custom development are scoped separately. Day to day, we ship consistent marketing that compounds, and we are honest about scope."],
44|];
