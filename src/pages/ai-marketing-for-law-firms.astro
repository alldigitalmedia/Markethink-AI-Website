---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Law Firm Marketing, Powered by AI and Managed by Experts | Markethink";
const pageDescription = "Law firm marketing for SEO, practice-area pages, Google Ads, local visibility, content, and intake follow-up, directed by expert marketers and approved by your firm.";
const lastUpdated = "September 2026";
const canonicalUrl = "https://markethink.ai/ai-marketing-for-law-firms/";
const walkthroughHref = "/schedule-a-walkthrough/?source=ai-marketing-for-law-firms";

const keywords = [
  "law firm marketing",
  "legal marketing",
  "law firm SEO",
  "attorney marketing",
  "AI marketing for law firms",
  "legal intake",
];

const painPoints = [
  ["Prospective clients need clarity before they call", "A visitor may compare several firms in one sitting. If the practice-area page is vague, the attorney bio feels generic, or the next step is hard to find, the easier-to-understand firm has the advantage."],
  ["Attorney knowledge is valuable but hard to publish consistently", "The answers attorneys give every week can inform useful pages, FAQs, articles, newsletters, and social posts. The difficult part is turning that knowledge into accurate, review-ready marketing without adding another job to the firm's day."],
  ["An inquiry can lose its source and urgency", "Intake works better when the team can see which page, search, or campaign prompted the inquiry, what service the person asked about, who owns the response, and what should happen next."],
];

const systemPieces = [
  ["Practice-area and service pages", "Page plans, copy, FAQs, internal links, and calls to action built around how prospective clients search and decide."],
  ["Attorney bios and local visibility", "Clearer attorney profiles, location-page direction, trust content, and Google Business Profile recommendations that reflect the firm accurately."],
  ["Paid-search support", "Google Ads direction, ad-message development, and focused landing-page copy aligned with the searcher's question and the firm's intake path."],
  ["Articles, newsletters, and social", "Useful content developed from attorney knowledge, recurring client questions, firm updates, and approved campaign priorities."],
  ["Intake and follow-up", "Source-aware inquiry notes, response drafts, ownership, and next-step direction so marketing context reaches the people handling the lead."],
  ["Expert review and firm approval", "AI supports research and production. Expert marketers direct and review the work, and the firm approves sensitive public language before publication."],
];

const useCases = [
  ["Law firm SEO and answer-ready content", "Plan useful pages around practice-area searches and real client questions. Improve headings, internal links, FAQs, local relevance, and clear next steps for traditional and AI-assisted search."],
  ["Website and practice-area pages", "Clarify services, strengthen attorney bios, improve conversion paths, and turn thin or confusing pages into useful explanations a prospective client can act on."],
  ["Google Ads and paid-search landing pages", "Match ad intent with focused landing-page copy, a clear reason to contact the firm, and an intake handoff that retains the campaign source."],
  ["Local visibility", "Coordinate location-page direction, Google Business Profile recommendations, review-request messaging, and consistent firm information across local discovery."],
  ["Attorney content and campaigns", "Develop articles, newsletters, email copy, and social posts from approved firm knowledge instead of publishing generic legal content."],
  ["Legal intake and follow-up", "Carry the inquiry source, service context, response owner, and next step into follow-up so the first reply is informed and the conversation does not start from zero."],
];

const practiceAreas = [
  "Family law",
  "Business and corporate law",
  "Estate planning",
  "Employment law",
  "Immigration",
  "Real estate law",
  "Criminal defense",
  "Personal injury",
];

const auditItems = [
  ["Search and AI visibility", "How clearly the firm answers priority practice-area, local, and question-based searches."],
  ["Website clarity", "Where service pages, attorney bios, FAQs, proof, and calls to action make the decision harder than it needs to be."],
  ["Local visibility", "How location pages, firm information, reviews, and Google Business Profile direction support a consistent local presence."],
  ["Paid-search readiness", "Whether Google Ads intent, landing-page language, inquiry paths, and source attribution work together."],
  ["Content opportunities", "Which attorney questions and firm priorities can become useful pages, articles, newsletters, email, and social content."],
  ["Intake and follow-up", "Where inquiry source, service context, response ownership, and next-step communication become disconnected."],
];

const comparisonRows = [
  ["Website and SEO", "Practice-area page plans, copy, FAQs, internal links, attorney-bio improvements, and local page direction.", "Your firm supplies source knowledge and approves sensitive public language."],
  ["Paid search", "Google Ads direction, message development, landing-page copy, and source-aware intake recommendations.", "Your firm confirms priorities, service fit, and the correct inquiry path."],
  ["Content", "Articles, newsletters, social posts, email copy, and campaign assets developed from real firm topics.", "Attorneys or designated reviewers correct the substance and approve publication."],
  ["Intake follow-up", "Recommended response drafts, source context, ownership, and next-step language for new inquiries.", "Your intake team decides the response and routes legal questions to the appropriate attorney."],
];

const implementationSteps = [
  ["1", "Choose the business priority", "Start with the practice area, location, search opportunity, campaign, or intake problem that matters most to the firm."],
  ["2", "Gather the right source material", "Use existing pages, attorney input, approved firm language, common questions, and current campaign information as the working source."],
  ["3", "Prepare the marketing work", "Develop the page, campaign, content, ad, or follow-up materials around that priority instead of creating isolated drafts."],
  ["4", "Review before publication", "Expert marketers check the work for clarity and consistency. The firm approves sensitive claims and public language."],
  ["5", "Carry feedback forward", "Approved edits, voice preferences, and business context inform the next assignment. Firm materials and context stay isolated to the appropriate account and approved access."],
];

const faqs = [
  { question: "What should law firm marketing prioritize?", answer: "Start with the decisions that matter to a prospective client: whether the firm handles the relevant matter, why the attorneys are credible, what the next step is, and how quickly the inquiry receives a useful response. SEO, local visibility, paid search, content, and intake should support those decisions rather than operate as separate projects." },
  { question: "How does law firm SEO work?", answer: "Law firm SEO improves the technical clarity, content, internal links, local relevance, and usefulness of pages that answer practice-area and location-based searches. Strong pages explain the service plainly, show who provides it, address common questions, and guide the visitor toward an appropriate next step. Rankings are not guaranteed, and the work improves through ongoing review of search behavior and page performance." },
  { question: "How can a law firm improve visibility in AI search?", answer: "Publish clear, well-structured answers to the questions prospective clients ask, keep firm and attorney information consistent, make important pages easy to discover through internal links, and support public claims with accurate source material. AI-search visibility builds on sound SEO and useful content. There is no special markup that guarantees inclusion in an AI-generated answer." },
  { question: "How does expert review work?", answer: "AI can support research, outlines, drafting, and continuity across the work. Expert marketers set the priority, shape the message, review quality, and prepare the material for firm approval. The firm retains control over sensitive public language before it is published." },
  { question: "How does content stay in the firm's voice?", answer: "Work begins with the firm's existing pages, attorney input, approved language, audience, and prior edits. Those decisions guide future drafts so articles, practice-area pages, email, and social content sound consistent without forcing every piece through the same generic template." },
  { question: "What should happen after a prospective client submits an inquiry?", answer: "A practical intake workflow should preserve the inquiry source and service context, assign a response owner, and make the next step clear. Response drafts should acknowledge the inquiry and explain what happens next rather than offer legal advice. The firm's intake team decides how to respond and when an attorney should become involved." },
  { question: "How does a law firm get started with Markethink?", answer: "Request available walkthrough times. We will discuss the firm's current website, search visibility, content, paid campaigns, intake, and follow-up, then identify the clearest area where an expert-managed marketing workflow could help." },
];

const structuredData = [
  { "@context": "https://schema.org", "@type": "WebPage", name: "AI Marketing for Law Firms", description: pageDescription, url: canonicalUrl, inLanguage: "en", dateModified: "2026-09-20", reviewedBy: { "@type": "Organization", name: "Markethink marketing team" }, publisher: { "@type": "Organization", name: "Markethink", url: "https://markethink.ai/", logo: "https://markethink.ai/images/logo.svg" } },
  { "@context": "https://schema.org", "@type": "Service", name: "AI Marketing for Law Firms", serviceType: "Expert-managed law firm marketing for SEO, content, paid search, local visibility, intake, and follow-up", areaServed: "United States", provider: { "@type": "Organization", name: "Markethink", url: "https://markethink.ai/" }, audience: { "@type": "Audience", audienceType: "Law firms, attorneys, and legal service practices" }, description: "Markethink supports law firm marketing across practice-area pages, SEO, Google Ads, local visibility, content, and intake follow-up, with AI-assisted production directed by expert marketers and approved by the firm." },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://markethink.ai/" }, { "@type": "ListItem", position: 2, name: "AI Marketing for Law Firms", item: canonicalUrl }] },
];
---

<Layout title={pageTitle} description={pageDescription} image="/images/ai-marketing-law-firms-hero-v3.svg" canonical={canonicalUrl} structuredData={structuredData}>
  <Navbar ctaLabel="Request available times" ctaHref={walkthroughHref} />
  <main class="law-page">
    <section class="law-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="subtitle animate-fade-up">AI MARKETING FOR LAW FIRMS</p>
          <h1 class="animate-fade-up">Law firm marketing, powered by AI and managed by experts.</h1>
          <p class="hero-description animate-fade-up">
            Markethink helps law firms turn attorney knowledge and business priorities into stronger practice-area pages, law firm SEO, Google Ads landing pages, local visibility, content, and intake follow-up. AI supports research and production. Expert marketers direct and review the work, and your firm approves sensitive public language.
          </p>
          <div class="button-group animate-fade-up">
            <a href={walkthroughHref} class="button">Request available times</a>
            <a href="#system" class="button is-secondary">See what your firm receives</a>
          </div>
          <div class="outcome-row animate-fade-up" aria-label="Law firm marketing capabilities">
            <span>SEO + local visibility</span>
            <span>Google Ads + intake</span>
            <span>Expert-managed AI</span>
          </div>
          <p class="review-line">Serving law firms across the United States · Updated {lastUpdated}</p>
        </div>
        <div class="hero-visual">
          <img src="/images/ai-marketing-law-firms-hero-v3.svg" alt="Law firm leaders and expert marketers reviewing search, campaign, and intake work" width="1536" height="1024" />
        </div>
      </div>
    </section>

    <section class="section light-green intent-section">
      <div class="container two-column">
        <div>
          <p class="subtitle">THE WORK THAT MATTERS</p>
          <h2>What should law firm marketing actually do?</h2>
        </div>
        <div class="rich-copy">
          <p>Law firm marketing should make it easier for the right prospective client to find the firm, understand its services, trust the people behind it, and know what to do next.</p>
          <p>That means a practice-area page should answer the question that brought someone to search. An attorney bio should help the visitor understand who they may work with. A paid-search landing page should continue the message in the ad. An inquiry should reach intake with useful source and service context.</p>
          <p>AI can speed up research, outlines, first drafts, and continuity across this work. Expert marketers still decide what deserves attention, improve the message, and review the finished material. The firm approves sensitive public language.</p>
          <p>This approach keeps legal marketing focused on useful work instead of producing more disconnected content for attorneys to review.</p>
        </div>
      </div>
      <div class="container pain-grid animate-stagger">
        {painPoints.map(([title, copy]) => (
          <article>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section dark" id="system">
      <div class="container">
        <div class="section-header text-center">
          <p class="subtitle">WHAT YOUR FIRM RECEIVES</p>
          <h2>Useful marketing work, prepared around your firm.</h2>
          <p class="section-description dark-copy">The work starts with the firm's real services, locations, attorneys, business priorities, and inquiry process. Each deliverable has a job to do for the prospective client and the firm.</p>
        </div>
        <div class="system-stage">
          <img src="/images/ai-marketing-law-firms-system-v3.svg" alt="Expert marketers and law firm leaders reviewing search, content, and intake work" width="1536" height="1024" loading="lazy" />
          <div class="system-caption">
            <span>AI supports the work</span>
            <strong>Expert marketers direct and review it.</strong>
          </div>
        </div>
        <div class="system-grid">
          {systemPieces.map(([title, copy], index) => (
            <article class="system-card">
              <span class="card-number">0{index + 1}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section visual-section">
      <div class="container visual-grid">
        <div class="workflow-visual">
          <img src="/images/ai-marketing-law-firms-search-v2.svg" alt="Attorney and marketing strategist organizing law firm search pages and FAQs" width="1536" height="1024" loading="lazy" />
        </div>
        <div class="workflow-copy">
          <p class="subtitle">WHERE AI HELPS</p>
          <h2>AI should reduce the blank-page work, not replace judgment.</h2>
          <p>Used well, AI helps the marketing team review source material, organize topics, compare pages, prepare outlines, draft variations, and carry approved context into the next assignment.</p>
          <ul>
            <li>Practice-area pages built around real search and decision questions.</li>
            <li>Attorney bios and FAQs that are clearer and easier to review.</li>
            <li>Landing-page and campaign drafts shaped for a specific audience and next step.</li>
            <li>Follow-up language that acknowledges the inquiry and explains what happens next.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section light-green use-case-section">
      <div class="container">
        <div class="section-header">
          <p class="subtitle">DAY-TO-DAY LAW FIRM MARKETING</p>
          <h2>The core work, from search visibility to intake follow-up.</h2>
          <p class="section-description">Markethink brings together the work a firm usually has to coordinate across different vendors, tools, and internal reviewers. The goal is not more output for its own sake. It is clearer marketing that reaches the right person and supports the next operational step.</p>
        </div>
        <div class="use-case-grid">
          {useCases.map(([title, copy], index) => (
            <article>
              <span class="service-keyword">0{index + 1}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
        <div class="mid-page-cta">
          <p>Not sure whether the first priority is search, paid traffic, content, or intake?</p>
          <a href="#audit" class="button">See what the review covers</a>
        </div>
      </div>
    </section>

    <section class="section practice-section">
      <div class="container two-column">
        <div>
          <p class="subtitle">PRACTICE-AREA CONTEXT</p>
          <h2>Marketing should reflect the services your firm actually handles.</h2>
          <p class="section-description">Markethink organizes the work around the firm's real services, locations, client questions, attorneys, tone, and intake path. These examples show the kind of context the marketing may need. They are not claims of legal expertise.</p>
        </div>
        <div class="practice-grid" aria-label="Example law firm practice areas">
          {practiceAreas.map((area) => <span>{area}</span>)}
        </div>
      </div>
    </section>

    <section class="pipeline-section">
      <div class="pipeline-image">
        <img src="/images/ai-marketing-law-firms-pipeline-v2.svg" alt="Law firm intake team organizing inquiry source, ownership, and follow-up" width="1536" height="1024" loading="lazy" />
      </div>
      <div class="container pipeline-copy">
        <p class="subtitle">FROM INQUIRY TO FOLLOW-UP</p>
        <h2>A better inquiry handoff starts with useful context.</h2>
        <p>A recommended intake workflow preserves the source, the page or campaign, the service requested, the response owner, and the next step. Response drafts should acknowledge the inquiry and explain what happens next rather than offer legal advice. The firm's team decides the response and routes substantive questions to the appropriate attorney.</p>
        <div class="pipeline-steps" aria-label="Connected law firm lead workflow">
          <span>01 · Inquiry</span><span>02 · Source context</span><span>03 · Owner</span><span>04 · Next step</span>
        </div>
      </div>
    </section>

    <section class="section dark comparison-section">
      <div class="container">
        <div class="section-header">
          <p class="subtitle">DELIVERABLES AND REVIEW</p>
          <h2>What does a law firm receive from Markethink?</h2>
          <p class="section-description dark-copy">The exact mix depends on the firm's priorities. These are the work categories Markethink can prepare and the decisions that remain with the firm.</p>
        </div>
        <div class="comparison-table">
          <div class="table-head"><span>Work area</span><span>What is prepared</span><span>How your firm is involved</span></div>
          {comparisonRows.map(([category, prepared, involvement]) => (
            <div class="table-row"><span>{category}</span><span>{prepared}</span><span>{involvement}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section class="section light-green seo-section">
      <div class="container two-column">
        <div>
          <p class="subtitle">LAW FIRM SEO AND AI SEARCH</p>
          <h2>How law firm SEO earns useful visibility.</h2>
        </div>
        <div class="rich-copy">
          <p><strong>Law firm SEO</strong> starts with pages that match the reason someone searched. A useful practice-area page explains the service in plain language, answers the questions that shape the decision, identifies the relevant attorneys or firm, and provides a clear next step.</p>
          <p>Technical clarity, internal links, local relevance, attorney bios, FAQs, and consistent firm information help search engines and people understand the page. For AI search, the same foundation matters: direct answers, accurate source material, clear page relationships, and claims that can be supported. No special markup guarantees visibility.</p>
          <p>Markethink uses AI to support research and production while expert marketers direct the SEO work, review quality, and prepare changes for firm approval.</p>
          <div class="supporting-link">
            <p>Related guidance:</p>
            <ul>
              <li><a href="/blog/how-to-show-up-in-ai-search/">How to show up in AI search</a></li>
              <li><a href="/blog/brand-memory-feedback-approved-campaigns/">How brand memory turns feedback into faster approved campaigns</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section dark process-section">
      <div class="container">
        <div class="section-header text-center">
          <p class="subtitle">HOW THE WORK MOVES</p>
          <h2>From firm knowledge to approved marketing.</h2>
          <p class="section-description dark-copy">A clear workflow gives attorneys a focused review instead of a blank page, keeps expert marketers accountable for the quality of the work, and carries approved decisions into what comes next.</p>
        </div>
        <div class="process-grid">
          {implementationSteps.map(([number, title, copy]) => (
            <article>
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section light-green fit-section">
      <div class="container fit-grid">
        <div class="fit-card">
          <p class="subtitle">A PRACTICAL FIT</p>
          <h2>For firms ready to improve the work behind their marketing.</h2>
          <ul>
            <li>You have defined services and want clearer practice-area pages, attorney marketing, and local visibility.</li>
            <li>You want paid campaigns and content to connect to the way your team handles inquiries.</li>
            <li>You value faster production, expert marketing direction, and firm approval before sensitive public language is published.</li>
          </ul>
        </div>
        <div class="fit-card muted">
          <p class="subtitle">NOT A SHORTCUT</p>
          <h2>A poor fit for unsupported promises and generic volume.</h2>
          <ul>
            <li>You want guaranteed rankings, cases, leads, revenue, or another outcome no marketer can honestly promise.</li>
            <li>You want large amounts of generic legal content without attorney or firm review.</li>
            <li>You only need a self-serve writing tool and do not want expert marketing direction.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section audit-section" id="audit">
      <div class="container">
        <div class="section-header">
          <p class="subtitle">LAW FIRM MARKETING REVIEW</p>
          <h2>Start with the clearest marketing constraint.</h2>
          <p class="section-description dark-copy">A useful review looks at where prospective clients find the firm, what they see, how the message continues across campaigns, and what happens after they contact the firm. It helps identify the first area where Markethink could support the work.</p>
        </div>
        <div class="audit-grid">
          {auditItems.map(([title, copy]) => (
            <article><h3>{title}</h3><p>{copy}</p></article>
          ))}
        </div>
        <div class="audit-action">
          <p>Request a walkthrough to discuss the firm's current marketing, priorities, and intake path.</p>
          <a href={walkthroughHref} class="button">Request available times</a>
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-grid">
        <div>
          <p class="subtitle">FAQ</p>
          <h2>Questions firm owners and managing partners ask.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="law-final-cta">
      <div class="container final-panel">
        <p class="subtitle">REQUEST A WALKTHROUGH</p>
        <h2>See how Markethink would support your firm's marketing.</h2>
        <p>Discuss the website, search visibility, practice-area priorities, Google Ads, content, intake, and follow-up with the expert marketers who would direct the work.</p>
        <a href={walkthroughHref} class="button">Request available times</a>
      </div>
    </section>
  </main>
  <Footer walkthroughLabel="Request available times" walkthroughHref={walkthroughHref} />
</Layout>

<style>
  .law-page { background: #f5f5f1; color: #0f1213; overflow: clip; }
  .law-page .section { padding: clamp(6rem, 9vw, 9rem) 0; }
  .law-hero { min-height: 960px; display: flex; align-items: center; position: relative; overflow: hidden; background: #0f1213; }
  .law-hero::after { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(5,10,14,.98) 0%, rgba(5,10,14,.92) 28%, rgba(5,10,14,.48) 57%, rgba(5,10,14,.1) 100%), linear-gradient(0deg, rgba(5,10,14,.52), transparent 40%); pointer-events: none; }
  .hero-grid { width: 100%; position: relative; z-index: 2; }
  .hero-copy { position: relative; z-index: 3; display: flex; flex-direction: column; gap: 1.25rem; max-width: min(48rem, 53vw); margin-left: clamp(1.25rem, 4vw, 4rem); padding: 9rem 0 5rem; }
  .hero-copy h1 { color: #f5f5f1; font-size: clamp(3.25rem, 5.45vw, 5.7rem); line-height: .94; letter-spacing: -.055em; text-wrap: balance; }
  .hero-description { max-width: 41rem; color: rgba(245,245,241,.76); font-size: 1.08rem; line-height: 1.75; }
  .hero-visual { position: absolute; inset: 0; z-index: 0; }
  .hero-visual img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .button-group, .outcome-row { display: flex; flex-wrap: wrap; gap: .75rem; }
  .outcome-row { margin-top: .5rem; }
  .outcome-row span { border: 1px solid rgba(245,245,241,.2); border-radius: 999px; padding: .65rem .9rem; color: rgba(245,245,241,.82); background: rgba(7,14,23,.42); backdrop-filter: blur(12px); font-size: .78rem; letter-spacing: .04em; }
  .hero-copy .subtitle { color: #aee8a0; }
  .review-line { color: rgba(245,245,241,.48); font-size: .76rem; letter-spacing: .02em; }

  .hero-grid, .two-column, .visual-grid, .fit-grid, .faq-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .section-header { max-width: 960px; margin-bottom: 3.2rem; }
  .section-header h2, .workflow-copy h2, .fit-card h2, .faq-grid h2, .intent-section h2, .seo-section h2, .final-panel h2, .pipeline-copy h2 { font-size: clamp(2.7rem, 5.1vw, 5.35rem); line-height: .96; letter-spacing: -.052em; text-wrap: balance; }
  .text-center { text-align: center; margin-left: auto; margin-right: auto; }
  .section-description, .rich-copy, .workflow-copy { color: rgba(15,18,19,.7); line-height: 1.78; font-size: 1rem; }
  .rich-copy p + p, .workflow-copy p + ul { margin-top: 1rem; }

  .intent-section { background: #edf4ea; }
  .pain-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-top: 3.5rem; }
  .pain-grid article, .use-case-grid article { border: 1px solid rgba(15,18,19,.11); border-radius: 1.35rem; background: rgba(245,245,241,.86); padding: 1.5rem; }
  .pain-grid article { min-height: 13rem; display: flex; flex-direction: column; justify-content: space-between; }
  .pain-grid h3, .system-card h3, .use-case-grid h3, .process-grid h3 { font-family: var(--font-body); font-size: 1.08rem; margin-bottom: .7rem; }
  .pain-grid p, .use-case-grid p { color: rgba(15,18,19,.68); line-height: 1.68; }

