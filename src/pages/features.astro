---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FeatureDeliverable from '../components/FeatureDeliverable.astro';
import ToolLogo from '../components/ToolLogo.astro';
import ToolList from '../components/ToolList.astro';
import { featureGroups, connectionGroups } from '../data/features';
import { featureTools, meetingTools } from '../data/tools';
import vividPhotography from '../data/featureVividPhotography.json';
import '../styles/features.css';
import '../styles/features-editorial.css';
import '../styles/features-catalog.css';
import '../styles/inner-motion.css';
const sections = [{ id: 'experts', label: 'Managed by experts' }, { id: 'your-agent', label: 'Your AI agent' }, { id: 'capabilities', label: 'All features' }, { id: 'meetings', label: 'Meeting intelligence' }, { id: 'connections', label: 'Connections' }];
const featureVisuals: Record<string, { image: string; alt: string; label: string; title: string }> = {
  create: { image: 'marketing-production.webp', alt: 'Illustrative designer reviewing website and campaign layouts across a laptop and printed proofs', label: 'CREATIVE THAT GETS NOTICED', title: 'Make the first impression count.' },
  grow: { image: 'outbound-business-photo.webp', alt: 'Illustrative café owner preparing to open a business with a forest-green storefront', label: 'FROM INTEREST TO OPPORTUNITY', title: 'Give the next conversation a head start.' },
  coordinate: { image: 'expert-team-photo.webp', alt: 'Illustrative marketing team collaborating around campaign materials in a creative studio', label: 'PEOPLE, CONTEXT & MOMENTUM', title: 'Great work is a team effort.' },
  learn: { image: 'campaign-review-photo.webp', alt: 'Illustrative strategist reviewing website layouts, social campaign proofs, and business photography on a studio wall', label: 'EVERY ROUND BUILDS ON THE LAST', title: 'Keep the knowledge. Sharpen the next brief.' },
};
---

<Layout title="Features - Your marketing, connected and managed | Markethink" description="Your dedicated AI marketing agent, managed by expert marketers. Explore web, design, social publishing, meeting recording, lead research, CRM, SEO, advertising, and connected workflows." canonical="https://markethink.ai/features/">
  <div class="features-page">
    <a class="features-skip" href="#features-main">Skip to content</a>
    <Navbar />
    <main id="features-main">
      <section class="features-hero" aria-labelledby="features-title">
        <div class="hero-cinematic" aria-hidden="true"><img src="/images/features/marketing-studio-photo.webp" width="1536" height="1024" alt="" fetchpriority="high" /></div>
        <div class="features-wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> AI-powered. Expert-managed.</p>
            <h1 id="features-title"><span>Your marketing.</span><em>In full motion.</em></h1>
            <p class="hero-description">Big ideas, beautiful creative, and the operation to make them happen. Your dedicated AI agent and <strong>expert marketing team</strong>, working as one.</p>
            <div class="features-actions"><a class="features-button" href="/schedule-a-walkthrough/">Book A Demo <span aria-hidden="true">↗</span></a><a class="text-link" href="#capabilities">Explore the features <span aria-hidden="true">↓</span></a></div>
          </div>
          <div class="hero-stamp"><span class="stamp-star" aria-hidden="true">✳</span><div>Creative intelligence.<br /><strong>Human perspective.</strong></div></div>
        </div>
        <div class="features-wrap hero-footnote"><span>Your dedicated AI agent</span><span>Your expert marketing team</span><span>Your connected marketing operation</span></div>
      </section>

      <nav class="feature-index" aria-label="Explore features"><div class="features-wrap">{sections.map((section, index) => <a href={`#${section.id}`}><span>0{index + 1}</span>{section.label}</a>)}</div></nav>

      <section class="feature-section expert-section" id="experts" aria-labelledby="experts-title">
        <div class="features-wrap two-columns expert-grid">
          <figure class="expert-photo" data-image-reveal><img src="/images/features/expert-team-photo.webp" width="1536" height="1024" alt="Three creative strategists reviewing campaign materials in a sunlit studio" loading="lazy" decoding="async" /><figcaption><span class="photo-star" aria-hidden="true">✳</span><div>The human side of your marketing.<span>Expert direction is part of the operation.</span></div></figcaption></figure>
          <div class="feature-copy" data-reveal><p class="eyebrow"><span class="section-number">01</span> Managed by experts</p><h2 id="experts-title">AI moves the work.<br /><em>People own the judgment.</em></h2><p>You get more than access to AI. Expert marketers shape your strategy, guide the production, review the quality, and keep the work moving with purpose.</p><div class="expert-roles"><div><strong>Your agent</strong><span>Researches, prepares, creates, and keeps the context.</span></div><div><strong>Your team</strong><span>Sets direction, reviews the work, and stays accountable.</span></div><div><strong>You</strong><span>Set the priorities and approve the important decisions.</span></div></div><p class="expert-note">One connected operation, with a real marketing team behind it.</p></div>
        </div>
      </section>

      <section class="feature-section agent-section" id="your-agent" aria-labelledby="agent-title">
        <div class="features-wrap two-columns"><div class="feature-copy" data-reveal><p class="eyebrow"><span class="section-number">02</span> Your dedicated AI agent</p><h2 id="agent-title">Trained on your business.<br /><em>Directed by your team.</em></h2><p>A dedicated AI marketing agent configured around your offers, audience, brand voice, and visual identity. It works with your team, remembers approved feedback, and carries that context into the next assignment.</p><ul class="feature-checks"><li>Business knowledge, guidelines, and creative references</li><li>Shared chat with your agent and marketing team</li><li>Approved decisions and feedback that stay with the work</li><li>Connected tools, with access scoped to your business</li></ul><p class="feature-note">Less re-explaining. More understanding. A stronger starting point for every new brief.</p></div>
          <div class="agent-visual" data-reveal aria-label="Brand context example"><figure class="agent-context-image"><img src={`/images/features/inner/${vividPhotography['brand-book'].file}.webp`} alt={vividPhotography['brand-book'].alt} width="1536" height="1024" loading="lazy" decoding="async" /></figure><div class="brand-file"><div class="brand-file-heading"><span class="file-icon" aria-hidden="true">✳</span><div><small>YOUR AGENT'S FOUNDATION</small><h3>Your business. Remembered.</h3></div></div><div class="reference-chips"><span>Brand voice</span><span>Audience</span><span>Approved work</span></div><div class="memory-feedback"><span aria-hidden="true">↳</span><div><small>YOUR FEEDBACK</small><p>“Lead with the benefit. Keep it conversational.”</p><span class="applied-note">✓ Context for the next brief</span></div></div></div></div>
        </div>
      </section>

      <section class="feature-section capabilities-section" id="capabilities" aria-labelledby="capabilities-title"><div class="features-wrap"><div class="section-heading" data-reveal><div><p class="eyebrow"><span class="section-number">03</span> The full feature set</p><h2 id="capabilities-title">From the big picture<br /><em>to the last little detail.</em></h2></div><p>Web, design, marketing, research, and daily coordination. Explore what your agent and expert team can put to work for your business.</p></div>
        <div class="feature-browser">
          <div class="feature-tabs" aria-label="Feature categories">{featureGroups.map(group => <a href={`#features-${group.id}`} id={`tab-${group.id}`} data-feature-tab={group.id}>{group.label}</a>)}</div>
          <div class="feature-panels">{featureGroups.map(group => <section id={`features-${group.id}`} class={`feature-panel panel-${group.id}`} data-feature-panel={group.id}>
            <div class="feature-spotlight">
              <div class="spotlight-copy"><span class="eyebrow">{featureVisuals[group.id].label}</span><h3>{featureVisuals[group.id].title}</h3><p>{group.description}</p></div>
            </div>
            <div class="feature-catalog" id={`catalog-${group.id}`}>
              <div class="capability-grid">{group.features.map((feature, index) => <article class="capability-card">
                <FeatureDeliverable group={group.id} index={index} />
                <div class="capability-copy"><h4>{featureTools[feature.title] && <ToolLogo id={featureTools[feature.title]} />}<span class="capability-link-label">{feature.title}</span></h4>
                <p>{feature.description}</p><span class="capability-detail">{feature.detail}</span></div>
              </article>)}</div>
            </div>
          </section>)}</div>
        </div>
        <p class="scope-note">Your services, volume, connections, and approval rules are agreed together. Some capabilities require account activation or additional setup. <a href="/shipped/">See examples of real work ↗</a></p>
      </div></section>

      <section class="feature-section meeting-section" id="meetings" aria-labelledby="meetings-title"><div class="features-wrap two-columns"><div class="feature-copy" data-reveal><p class="eyebrow"><span class="section-number">04</span> Meeting intelligence</p><h2 id="meetings-title">The call ends.<br /><em>The context stays.</em></h2><p>Invite your notetaker to a specific meeting. Record the conversation, capture the transcript, and bring the decisions and action items back into the marketing work.</p><ul class="feature-checks"><li>Meeting recording and transcription</li><li>Recaps, decisions, and follow-up actions</li><li>Useful business context for your agent and team</li></ul><ToolList items={meetingTools} label="Meeting platforms" /><p class="meeting-note">Available for requested calls, with recording enabled for your account.</p></div><div class="meeting-visual" data-reveal aria-label="Illustrative meeting transcript and action items"><div class="meeting-visual-head"><div><h3>New service kickoff</h3><small>Illustrative meeting recap</small></div><span>Recorded</span></div><div class="meeting-transcript"><div><time>04:12</time><p><strong>YOUR TEAM</strong>Let’s lead with the problem this service solves.</p></div><div><time>04:38</time><p><strong>YOU</strong>Exactly. Start with a landing page and a short launch campaign.</p></div><div><time>05:06</time><p><strong>YOUR TEAM</strong>We’ll bring the message and creative direction back for review.</p></div></div><div class="meeting-outcome"><span>FROM CONVERSATION TO NEXT STEPS</span><p><span>↗</span> Prepare the landing page brief</p><p><span>↗</span> Develop the launch campaign direction</p><p><span>↗</span> Bring the work back for your review</p></div></div></div></section>

      <section class="feature-section connections-section" id="connections" aria-labelledby="connections-title"><div class="features-wrap"><div class="section-heading" data-reveal><div><p class="eyebrow"><span class="section-number">05</span> Your existing tools, connected</p><h2 id="connections-title">Your tools.<br /><em>One working rhythm.</em></h2></div><p>Your business already has a stack. Markethink works through the accounts and platforms included in your scope, with the access you approve.</p></div><div class="connection-groups">{connectionGroups.map((group, index) => <article class="connection-group" data-reveal style={`--card-index:${index}`}><h3>{group.title}</h3><p>{group.description}</p><ToolList items={group.apps} label={group.title} /><p class="connection-others">{group.note}</p></article>)}</div><p class="connection-scope">Connections and actions are enabled for your selected services and account permissions. Publishing formats, recording, sending, and other actions depend on the connected platform and agreed setup.</p></div></section>

      <section class="features-final-cta" aria-labelledby="final-title"><div class="cta-art" aria-hidden="true"><img src="/images/features/marketing-production.webp" width="1536" height="1024" alt="" loading="lazy" /></div><div class="features-wrap" data-reveal><p class="eyebrow">Put the whole operation to work</p><h2 id="final-title">Your next<br /><em>big move.</em></h2><p>Bring the ambition. We’ll bring the AI,<br />the creative, and the people to move it forward.</p><a class="features-button" href="/schedule-a-walkthrough/">Book A Demo <span aria-hidden="true">↗</span></a><span class="final-signoff">Powered by AI. Managed by expert marketers.</span></div></section>
    </main>
    <Footer />
    <button class="motion-toggle" type="button" aria-pressed="false" hidden>Pause motion <span aria-hidden="true">Ⅱ</span></button>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const page = document.querySelector<HTMLElement>('.features-page');
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-feature-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-feature-panel]'));
  const tabList = document.querySelector('.feature-tabs');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let motionPaused = reducedMotion.matches;
  if (tabList && tabs.length && panels.length) {
    tabList.setAttribute('role', 'tablist');
    function activateTab(index: number, moveFocus = false, animate = true) {
      tabs.forEach((tab, tabIndex) => {
        const active = index === tabIndex;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[tabIndex].hidden = !active;
      });
      if (moveFocus) tabs[index].focus();
      if (animate && !motionPaused) {
        gsap.fromTo(panels[index].querySelectorAll('.capability-card'), { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: .45, stagger: .045, ease: 'power2.out', overwrite: true, clearProps: 'opacity,transform' });
        gsap.fromTo(panels[index].querySelector('.feature-spotlight'), { y: 12, opacity: .2 }, { y: 0, opacity: 1, duration: .6, ease: 'power3.out', overwrite: true, clearProps: 'opacity,transform' });
      }
      ScrollTrigger.refresh();
    }
    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panels[index].id);
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', tab.id);
      panels[index].tabIndex = 0;
      tab.addEventListener('click', event => { event.preventDefault(); activateTab(index); });
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else if (event.key === ' ') { event.preventDefault(); activateTab(index); return; }
        else return;
        event.preventDefault(); activateTab(next, true);
      });
    });
    function hashPanelIndex() {
      const target = document.getElementById(window.location.hash.slice(1));
      return panels.findIndex(panel => panel === target || (target !== null && panel.contains(target)));
    }
    const hashIndex = hashPanelIndex();
    activateTab(hashIndex < 0 ? 0 : hashIndex, false, false);
    if (hashIndex >= 0) requestAnimationFrame(() => document.getElementById(window.location.hash.slice(1))?.scrollIntoView({ behavior: 'instant' }));
    window.addEventListener('hashchange', () => {
      const index = hashPanelIndex();
      if (index >= 0) {
        activateTab(index);
        requestAnimationFrame(() => document.getElementById(window.location.hash.slice(1))?.scrollIntoView({ behavior: 'instant' }));
      }
    });
  }
  let motionContext: gsap.Context | undefined;
  const motionButton = document.querySelector<HTMLButtonElement>('.motion-toggle');
  function startMotion() {
    motionContext = gsap.context(() => {
      gsap.from('.hero-copy > *', { y: 20, opacity: 0, duration: .85, stagger: .12, ease: 'power3.out', clearProps: 'all' });
      gsap.from('.hero-cinematic img', { scale: 1.09, duration: 1.8, ease: 'power2.out', clearProps: 'transform' });
      gsap.from('.hero-stamp', { y: 22, opacity: 0, duration: 1, delay: .6, ease: 'power3.out', clearProps: 'all' });
      document.querySelectorAll('[data-reveal]').forEach(element => {
        gsap.from(element, { y: 36, opacity: 0, duration: .85, ease: 'power3.out', clearProps: 'all', scrollTrigger: { trigger: element, start: 'top 92%', once: true } });
      });
      document.querySelectorAll<HTMLElement>('[data-image-reveal]').forEach(element => {
        gsap.from(element, { clipPath: 'inset(12% 4% 12% 4% round 48px)', duration: 1.2, ease: 'power3.out', clearProps: 'clipPath', scrollTrigger: { trigger: element, start: 'top 88%', once: true } });
      });
      gsap.to('.hero-cinematic', { y: 50, ease: 'none', scrollTrigger: { trigger: '.features-hero', start: 'top top', end: 'bottom top', scrub: 1 } });
      document.querySelectorAll('.feature-index a').forEach(link => {
        const id = link.getAttribute('href');
        if (id) ScrollTrigger.create({ trigger: id, start: 'top 120px', end: 'bottom 120px', onToggle: self => link.classList.toggle('is-current', self.isActive) });
      });
    }, page!);
    page?.classList.add('motion-enabled');
  }
  function updateMotion(paused: boolean) {
    paused = paused || reducedMotion.matches;
    motionPaused = paused;
    motionContext?.revert();
    gsap.killTweensOf('.capability-card, .feature-spotlight');
    gsap.set('.capability-card, .feature-spotlight', { clearProps: 'opacity,transform' });
    page?.classList.toggle('motion-paused', paused);
    if (page) page.dataset.motionPaused = String(paused);
    page?.classList.remove('motion-enabled');
    if (!paused) startMotion();
    if (motionButton) {
      motionButton.hidden = false;
      motionButton.setAttribute('aria-pressed', String(paused));
      motionButton.innerHTML = paused ? 'Enable motion <span aria-hidden="true">▷</span>' : 'Pause motion <span aria-hidden="true">Ⅱ</span>';
    }
  }
  if (page) updateMotion(motionPaused);
  motionButton?.addEventListener('click', () => updateMotion(!motionPaused));
  reducedMotion.addEventListener('change', event => updateMotion(event.matches));

</script>
