---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import {
  LIBRARY_META,
  PLAYBOOK_META,
  getCandidateBodyMarkdown,
  getStandaloneBrief,
  originalSources,
  processSteps,
  tocSections,
  usageModes,
} from "../../data/strategyLibrary.mjs";
import { b2bEditorialImages } from "../../data/b2bEditorialImages";

const standaloneBrief = getStandaloneBrief();
const cover = b2bEditorialImages[0];

const escapeHtml = (value) => value
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replaceAll('"', "&quot;");

const inlineMarkdown = (value) => {
  let html = escapeHtml(value);
  html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" rel="noopener noreferrer">$1</a>');
  html = html.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
  html = html.replace(/`([^`]+)`/g, "<code>$1</code>");
  return html;
};

const h2Ids = new Map([
  ["Start with the requested job", "purpose-title"],
  ["Use the data to answer decisions", "evidence-title"],
  ["Diagnose before prescribing content", "method-title"],
  ["Produce work someone can implement", "outputs-title"],
  ["Treat AI search as a measured part of discovery", "measurement-title"],
  ["Return the right deliverable and maintain it", "repeat-title"],
  ["Source guidance", "sources-title"],
]);

const legacyAnchors = new Map([
  ["Start with the requested job", ["inputs-title"]],
  ["Use the data to answer decisions", ["baseline-research-title"]],
  ["Diagnose before prescribing content", ["playbook-method"]],
  ["Produce work someone can implement", ["page-clarity-title", "answer-ready-content-title"]],
  ["Return the right deliverable and maintain it", ["verification-review-title", "separate-reviews", "carry-forward", "scope-opportunities", "prioritize-capacity", "log-decision"]],
  ["Source guidance", ["limitations-title"]],
]);

function renderCandidateMethod(markdown) {
  const start = markdown.indexOf("## Start with the requested job");
  const source = start >= 0 ? markdown.slice(start) : markdown;
  const lines = source.split("\n");
  const output = [];
  let paragraph = [];
  let listType = null;
  let tableRows = [];
  let sectionOpen = false;

  const flushParagraph = () => {
    if (!paragraph.length) return;
    output.push(`<p>${inlineMarkdown(paragraph.join(" "))}</p>`);
    paragraph = [];
  };
  const flushList = () => {
    if (!listType) return;
    output.push(`</${listType}>`);
    listType = null;
  };
  const flushTable = () => {
    if (!tableRows.length) return;
    const [header, _delimiter, ...body] = tableRows;
    const cells = (line) => line.split("|").slice(1, -1).map((cell) => cell.trim());
    output.push('<div class="table-scroll"><table><thead><tr>');
    for (const cell of cells(header)) output.push(`<th scope="col">${inlineMarkdown(cell)}</th>`);
    output.push("</tr></thead><tbody>");
    for (const row of body) {
      output.push("<tr>");
      for (const cell of cells(row)) output.push(`<td>${inlineMarkdown(cell)}</td>`);
      output.push("</tr>");
    }
    output.push("</tbody></table></div>");
    tableRows = [];
  };
  const flushBlocks = () => { flushParagraph(); flushList(); flushTable(); };

  for (let index = 0; index < lines.length; index += 1) {
    const line = lines[index];
    if (line.startsWith("|")) {
      flushParagraph();
      flushList();
      tableRows.push(line);
      continue;
    }
    if (tableRows.length) flushTable();
    const h2 = line.match(/^##\s+(.+)$/);
    if (h2) {
      flushBlocks();
      if (sectionOpen) output.push("</section>");
      const title = h2[1];
      const id = h2Ids.get(title) ?? title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
      output.push(`<section class="method-block" aria-labelledby="${id}">`);
      for (const anchor of legacyAnchors.get(title) ?? []) output.push(`<span class="legacy-anchor" id="${anchor}" aria-hidden="true"></span>`);
      output.push(`<h2 id="${id}">${inlineMarkdown(title)}</h2>`);
      sectionOpen = true;
      continue;
    }
    const h3 = line.match(/^###\s+(.+)$/);
    if (h3) {
      flushBlocks();
      output.push(`<h3>${inlineMarkdown(h3[1])}</h3>`);
      continue;
    }
    const bullet = line.match(/^-\s+(.+)$/);
    const numbered = line.match(/^\d+\.\s+(.+)$/);
    if (bullet || numbered) {
      flushParagraph();
      const nextType = bullet ? "ul" : "ol";
      if (listType !== nextType) {
        flushList();
        output.push(`<${nextType}>`);
        listType = nextType;
      }
      output.push(`<li>${inlineMarkdown((bullet ?? numbered)[1])}</li>`);
      continue;
    }
    if (!line.trim()) {
      flushParagraph();
      flushList();
      continue;
    }
    paragraph.push(line.trim());
  }
  flushBlocks();
  if (sectionOpen) output.push("</section>");
  return output.join("\n");
}

const candidateMethodHtml = renderCandidateMethod(getCandidateBodyMarkdown());
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: PLAYBOOK_META.title,
  description: PLAYBOOK_META.description,
  url: PLAYBOOK_META.canonical,
  mainEntityOfPage: PLAYBOOK_META.canonical,
  datePublished: PLAYBOOK_META.reviewedDate,
  dateModified: PLAYBOOK_META.reviewedDate,
  version: PLAYBOOK_META.version,
  image: {
    "@type": "ImageObject",
    url: cover.desktop,
    contentUrl: cover.desktop,
    width: cover.desktopWidth,
    height: cover.desktopHeight,
    caption: cover.alt,
  },
  author: { "@type": "Organization", name: PLAYBOOK_META.author, url: "https://markethink.ai/" },
  publisher: { "@type": "Organization", name: "Markethink", url: "https://markethink.ai/" },
  proficiencyLevel: "Intermediate",
  about: ["Search engine optimization", "AI search", "Content strategy", "Search measurement"],
};
const breadcrumbsJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://markethink.ai/" },
    { "@type": "ListItem", position: 2, name: LIBRARY_META.name, item: LIBRARY_META.canonical },
    { "@type": "ListItem", position: 3, name: PLAYBOOK_META.title, item: PLAYBOOK_META.canonical },
  ],
};
---

<Layout
  title={PLAYBOOK_META.seoTitle}
  description={PLAYBOOK_META.description}
  canonical={PLAYBOOK_META.canonical}
  image={cover.sharing}
  imageAlt={cover.alt}
  type="article"
  structuredData={[pageJsonLd, breadcrumbsJsonLd]}
>
  <Navbar />

  <main>
    <article>
      <header class="playbook-hero">
        <div class="shell">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span><a href="/ai-marketing-strategies/">Strategies</a><span aria-hidden="true">/</span><span>SEO + AI search</span>
          </nav>
          <div class="hero-grid">
            <div class="hero-copy">
              <p class="eyebrow">Practical playbook</p>
              <h1>{PLAYBOOK_META.title}</h1>
              <p class="dek">Find the search opportunities that fit your buyers. Decide which pages to improve or create, then turn the research into prioritized work with clear acceptance checks.</p>
              <p class="objective">The objective is qualified business demand. Rankings, traffic and AI citations are intermediate observations whose contribution must be measured, not assumed.</p>
              <dl class="metadata" aria-label="Playbook metadata">
                <div><dt>Version</dt><dd>{PLAYBOOK_META.version}</dd></div>
                <div><dt>Author</dt><dd>{PLAYBOOK_META.author}</dd></div>
                <div><dt>Reviewed</dt><dd>{PLAYBOOK_META.reviewedDate}</dd></div>
              </dl>
              <aside class="strategy-attribution" data-strategy-attribution aria-label="Strategy attribution">
                <p>Created and maintained by Markethink</p>
                <p>Editorial lead: <a href="/authors/santiago-sosa/">Santiago Sosa</a></p>
              </aside>
              <div class="hero-actions" aria-label="Playbook actions">
                <div class="download-action">
                  <a class="button button-primary" href="/downloads/markethink-seo-aio-playbook.md" download>Download for your AI (.md)</a>
                  <span>One file. Attach it to your AI conversation.</span>
                </div>
                <button class="button button-secondary" type="button" data-copy-brief>Copy for your AI</button>
                <a class="quiet-link" href="#playbook-method">Read the playbook</a>
              </div>
              <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
              <aside class="evidence-note" aria-label="Playbook evidence status">
                <strong>Evidence note</strong>
                <span>{PLAYBOOK_META.evidenceStatus} No ranking, traffic, lead or citation outcome is promised.</span>
              </aside>
            </div>
            <figure class="cover-figure">
              <picture>
                <source media="(max-width: 680px)" srcset={cover.mobile} width={cover.mobileWidth} height={cover.mobileHeight} />
                <img src={cover.desktop} alt={cover.alt} width={cover.desktopWidth} height={cover.desktopHeight} loading="eager" decoding="async" fetchpriority="high" />
              </picture>
              <figcaption>Conceptual editorial cover. A marketer compares two directions before production.</figcaption>
            </figure>
          </div>
        </div>
      </header>

      <section class="process-section" aria-labelledby="process-title">
        <div class="shell process-shell">
          <div>
            <p class="eyebrow">Working sequence</p>
            <h2 id="process-title">From research to the next useful decision.</h2>
          </div>
          <ol class="process-list">
            {processSteps.map((step, index) => (
              <li id={step.id}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div><strong>{step.label}</strong><p>{step.detail}</p></div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <div class="shell guide-shell">
        <details class="mobile-contents">
          <summary>On this page</summary>
          <nav aria-label="Playbook contents on mobile">
            <ol>{tocSections.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ol>
          </nav>
        </details>
        <aside class="desktop-contents">
          <nav aria-label="Playbook contents">
            <span>On this page</span>
            <ol>{tocSections.map((item, index) => <li><a href={item.href}><b>{String(index + 1).padStart(2, "0")}</b>{item.label}</a></li>)}</ol>
          </nav>
        </aside>
        <div class="guide-content" set:html={candidateMethodHtml}></div>
      </div>

      <section class="example-section" aria-labelledby="example-title">
        <div class="shell example-inner">
          <div>
            <p class="eyebrow light">Working example</p>
            <h2 id="example-title">See how Markethink records implementation without turning it into proof.</h2>
          </div>
          <div>
            <p>Markethink's living public SEO and AI-search strategy preserves decisions, source limits, shipped work, statuses and review notes. Use it to understand the operating rhythm, not as independent evidence for another business.</p>
            <a href="/seo-aio-strategy/">Open the public implementation log</a>
          </div>
        </div>
      </section>

      <section class="agent-section" id="copy-for-ai" aria-labelledby="copy-title">
        <div class="shell agent-grid">
          <header>
            <p class="eyebrow">Use with your AI</p>
            <h2 id="copy-title">Start with the complete Markdown file.</h2>
            <p>One self-contained file keeps the working method, factual boundaries and output contract together. Attach it where documents are supported, or copy the same content manually.</p>
            <a class="button button-primary" href="/downloads/markethink-seo-aio-playbook.md" download>Download for your AI (.md)</a>
            <p class="agent-support">One file. Attach it to your AI conversation.</p>
          </header>
          <div>
            <ol class="mode-list">
              {usageModes.map((mode, index) => (
                <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{mode.label}</h3><p>{mode.detail}</p></div></li>
              ))}
            </ol>
            <p class="package-link"><a href="/downloads/markethink-seo-aio-playbook.zip" download>Full skill package (.zip)</a> <span>Includes the same self-contained skill plus packaged source notes and reusable output templates. Import support depends on the product.</span></p>
          </div>
          <details class="brief-details" data-brief-details>
            <summary>View or manually copy the complete playbook</summary>
            <div class="brief-panel">
              <label for="standalone-brief">Complete 1.2.0 Markdown</label>
              <textarea id="standalone-brief" readonly rows="18">{standaloneBrief}</textarea>
              <div class="manual-actions">
                <button type="button" data-select-brief>Select all text</button>
                <button type="button" data-copy-brief>Copy for your AI</button>
                <a href="/downloads/markethink-seo-aio-playbook.md" download>Download Markdown</a>
              </div>
            </div>
          </details>
        </div>
      </section>

      <section class="sources-note" aria-labelledby="source-note-title">
        <div class="shell source-note-inner">
          <h2 id="source-note-title">Primary guidance retained.</h2>
          <p>The complete Markdown and rendered method retain the current source URLs and factual qualifications. Review live guidance before relying on a changing platform detail.</p>
          <ul>{originalSources.map((source) => <li><a href={source.url} rel="noopener noreferrer">{source.publisher}: {source.title}</a></li>)}</ul>
        </div>
      </section>

      <footer class="article-footer">
        <div class="shell footer-inner">
          <p>Version {PLAYBOOK_META.version} · Reviewed {PLAYBOOK_META.reviewedDate} · Maintained by {PLAYBOOK_META.author}</p>
          <a href="/ai-marketing-strategies/">Back to the AI Marketing Strategy Library</a>
        </div>
      </footer>
    </article>
  </main>

  <Footer />
</Layout>

<script>
  const copyButtons = document.querySelectorAll('[data-copy-brief]');
  const status = document.querySelector('[data-copy-status]');
  const brief = document.querySelector('#standalone-brief');
  const details = document.querySelector('[data-brief-details]');
  const selectButton = document.querySelector('[data-select-brief]');

  function revealManualFallback(message) {
    if (details instanceof HTMLDetailsElement) details.open = true;
    if (status instanceof HTMLElement) status.textContent = message;
    if (brief instanceof HTMLTextAreaElement) {
      brief.focus();
      brief.select();
      brief.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
    }
  }

  copyButtons.forEach((copyButton) => copyButton.addEventListener('click', async () => {
    if (!(brief instanceof HTMLTextAreaElement)) return;
    try {
      if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
      await navigator.clipboard.writeText(brief.value);
      if (status instanceof HTMLElement) status.textContent = 'Copied. Paste the complete playbook into your AI conversation.';
    } catch {
      revealManualFallback('Automatic copy was unavailable. The complete playbook is selected below for manual copy.');
    }
  }));

  selectButton?.addEventListener('click', () => {
    if (!(brief instanceof HTMLTextAreaElement)) return;
    brief.focus();
    brief.select();
    if (status instanceof HTMLElement) status.textContent = 'The complete playbook is selected. Use your device copy command.';
  });
</script>

<style is:global>
  .mt-site-header { background: #0f1213 !important; }
</style>

<style>
  :global(body) { background: #f5f5f1; color: #0f1213; }
  :global(html) { scroll-behavior: smooth; }
  .shell { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }
  .playbook-hero { padding: 132px 0 70px; background: #edf4ea; border-bottom: 1px solid rgba(15,18,19,.16); }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 36px; color: #686b6c; font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; }
  .breadcrumbs a { color: #0f1213; text-decoration: underline; text-underline-offset: 4px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0,1.08fr) minmax(360px,.92fr); gap: clamp(42px,6vw,82px); align-items: center; }
  .eyebrow { margin: 0 0 15px; color: #315b29; font-size: .74rem; font-weight: 750; text-transform: uppercase; letter-spacing: .14em; }
  .eyebrow.light { color: #8ee47c; }
  h1,h2 { margin: 0; font-family: "Instrument Serif",Georgia,serif; font-weight: 400; letter-spacing: -.035em; }
  h1 { max-width: 710px; font-size: clamp(3.35rem,4.45vw,4rem); line-height: .98; }
  h2 { font-size: clamp(2rem,3vw,2.38rem); line-height: 1.05; }
  h3 { margin: 0; color: #0f1213; font-family: Inter,system-ui,sans-serif; font-size: 1.4rem; font-weight: 650; line-height: 1.25; letter-spacing: -.015em; }
  .dek { max-width: 700px; margin: 26px 0 0; color: #303536; font-size: 1.12rem; line-height: 1.63; }
  .objective { max-width: 690px; margin: 16px 0 0; color: #4c5354; font-size: 1rem; line-height: 1.62; }
  .metadata { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 24px 0 0; padding: 14px 0; border-top: 1px solid rgba(15,18,19,.24); border-bottom: 1px solid rgba(15,18,19,.24); }
  .metadata div { display: flex; gap: 8px; }
  .metadata dt,.metadata dd { margin: 0; font-size: .74rem; line-height: 1.3; }
  .metadata dt { color: #686b6c; text-transform: uppercase; letter-spacing: .08em; }
  .metadata dd { color: #0f1213; font-weight: 700; }
  .strategy-attribution { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 14px; padding: 0; border: 0; color: #303536; font-size: .82rem; line-height: 1.45; }
  .strategy-attribution p { margin: 0; }
  .strategy-attribution a { color: #2f7026; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .strategy-attribution a:focus-visible { outline: 3px solid #315b28; outline-offset: 4px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; margin-top: 26px; }
  .download-action { display: flex; flex-direction: column; gap: 7px; }
  .download-action span,.agent-support { color: #4e5657; font-size: .76rem; }
  .button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 0 18px; border: 2px solid #0f1213; border-radius: 2px; font: 700 .9rem/1 Inter,system-ui,sans-serif; text-decoration: none; cursor: pointer; }
  .button-primary { background: #69d254; color: #0f1213; }
  .button-secondary { background: transparent; color: #0f1213; }
  .quiet-link { color: #0f1213; font-size: .88rem; font-weight: 650; text-underline-offset: 5px; }
  .button:hover { transform: translateY(-1px); }
  .copy-status { min-height: 20px; margin: 10px 0 0; color: #274c20; font-size: .82rem; font-weight: 700; }
  .evidence-note { display: grid; grid-template-columns: auto 1fr; gap: 13px; margin-top: 18px; padding: 13px 0 0; border-top: 1px solid rgba(15,18,19,.2); color: #505758; font-size: .78rem; line-height: 1.5; }
  .evidence-note strong { color: #0f1213; }
  .cover-figure { margin: 0; }
  .cover-figure picture { display: block; aspect-ratio: 4/5; overflow: hidden; background: #0f1213; }
  .cover-figure img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 55% center; }
  .cover-figure figcaption { margin-top: 10px; color: #5b6263; font-size: .72rem; line-height: 1.45; }
  .process-section { padding: 64px 0; background: #0f1213; color: #f5f5f1; }
  .process-shell { display: grid; grid-template-columns: minmax(220px,.55fr) minmax(0,1.45fr); gap: clamp(42px,7vw,90px); }
  .process-section h2 { max-width: 390px; color: #f5f5f1; }
  .process-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(245,245,241,.25); }
  .process-list li { display: grid; grid-template-columns: 42px 110px 1fr; gap: 14px; padding: 15px 0; border-bottom: 1px solid rgba(245,245,241,.2); }
  .process-list li > span { color: #69d254; font-size: .72rem; font-weight: 700; }
  .process-list strong { color: #f5f5f1; font-size: .94rem; }
  .process-list p { margin: 0; color: #bfc2c0; font-size: .88rem; line-height: 1.48; }
  .guide-shell { display: grid; grid-template-columns: 220px minmax(0,780px); gap: clamp(54px,8vw,110px); justify-content: center; padding-top: 72px; padding-bottom: 84px; }
  .desktop-contents nav { position: sticky; top: 112px; padding-top: 4px; }
  .desktop-contents nav > span { display: block; margin-bottom: 14px; color: #686b6c; font-size: .7rem; font-weight: 750; text-transform: uppercase; letter-spacing: .13em; }
  .desktop-contents ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid #c9cbc7; }
  .desktop-contents li { border-bottom: 1px solid #d8d9d6; }
  .desktop-contents a { display: flex; gap: 11px; padding: 10px 0; color: #3f4647; font-size: .78rem; line-height: 1.35; text-decoration: none; }
  .desktop-contents b { color: #315b29; font-size: .66rem; }
  .desktop-contents a:hover { color: #0f1213; text-decoration: underline; text-underline-offset: 3px; }
  .mobile-contents { display: none; }
  .guide-content { min-width: 0; color: #303536; font-size: 1.08rem; line-height: 1.72; }
  .guide-content :global(.method-block) { position: relative; padding: 0 0 58px; scroll-margin-top: 110px; }
  .guide-content :global(.method-block + .method-block) { padding-top: 58px; border-top: 1px solid #c9cbc7; }
  .guide-content :global(.legacy-anchor) { position: absolute; inset: -110px auto auto 0; width: 1px; height: 1px; }
  .guide-content :global(h2) { max-width: 680px; color: #0f1213; font-family: "Instrument Serif",Georgia,serif; font-size: clamp(2rem,3vw,2.38rem); line-height: 1.08; letter-spacing: -.025em; scroll-margin-top: 110px; }
  .guide-content :global(h3) { margin-top: 40px; color: #0f1213; font-family: Inter,system-ui,sans-serif; font-size: 1.4rem; font-weight: 650; line-height: 1.28; }
  .guide-content :global(p) { margin: 20px 0 0; }
  .guide-content :global(ul),.guide-content :global(ol) { margin: 20px 0 0; padding-left: 24px; }
  .guide-content :global(li) { margin: 9px 0; padding-left: 5px; }
  .guide-content :global(strong) { color: #0f1213; }
  .guide-content :global(a) { color: #2f7026; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .guide-content :global(code) { padding: .08em .28em; background: #e7ece4; color: #0f1213; font-size: .86em; }
  .guide-content :global(.table-scroll) { box-sizing: border-box; width: 100%; max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; margin-top: 28px; border-top: 2px solid #0f1213; }
  .guide-content :global(table) { width: 100%; min-width: 680px; border-collapse: collapse; font-size: .82rem; line-height: 1.48; }
  .guide-content :global(th),.guide-content :global(td) { padding: 13px 12px; border-bottom: 1px solid #c9cbc7; vertical-align: top; text-align: left; }
  .guide-content :global(th) { color: #0f1213; font-weight: 700; }
  .example-section { padding: 72px 0; background: #0f1213; color: #f5f5f1; }
