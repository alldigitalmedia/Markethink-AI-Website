---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { LIBRARY_META, PLAYBOOK_META, strategyEntries, usageModes } from "../../data/strategyLibrary.mjs";
import { b2bEditorialImages } from "../../data/b2bEditorialImages";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: LIBRARY_META.h1,
  description: LIBRARY_META.description,
  url: LIBRARY_META.canonical,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: strategyEntries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `https://markethink.ai${entry.href}`,
      name: entry.title,
    })),
  },
};

const breadcrumbsJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://markethink.ai/" },
    { "@type": "ListItem", position: 2, name: LIBRARY_META.name, item: LIBRARY_META.canonical },
  ],
};
---

<Layout
  title={LIBRARY_META.title}
  description={LIBRARY_META.description}
  canonical={LIBRARY_META.canonical}
  image={b2bEditorialImages[0].sharing}
  imageAlt={b2bEditorialImages[0].alt}
  structuredData={[pageJsonLd, breadcrumbsJsonLd]}
>
  <Navbar />

  <main>
    <section class="library-hero" aria-labelledby="library-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span><span>Strategies</span>
          </nav>
          <p class="eyebrow">Reviewed methods for practical work</p>
          <h1 id="library-title">{LIBRARY_META.h1}</h1>
          <p class="supporting-line">{LIBRARY_META.supportingLine}</p>
          <p class="intro">An evolving collection of reviewed strategies, practical playbooks, and companion instructions that help AI agents turn business context into accountable marketing work.</p>
        </div>
        <aside class="library-note" aria-label="Library standard">
          <span class="note-index">Library standard</span>
          <p>Every release must be useful to a human, complete enough for an agent, explicit about its evidence, and honest about what still needs to be measured.</p>
        </aside>
      </div>
    </section>

    <section class="feature-section" aria-labelledby="feature-title">
      <div class="shell feature-grid">
        <header class="feature-heading">
          <p class="eyebrow">Featured strategy</p>
          <h2 id="feature-title">Start with search work that can be scoped, shipped, and checked.</h2>
        </header>

        {strategyEntries.map((entry) => (
          <article class="feature-card">
            <div class="feature-meta">
              <span>SEO + AI search</span>
              <span>30-day playbook</span>
              <span>Version {entry.version}</span>
            </div>
            <div class="feature-body">
              <div>
                <h3>{entry.title}</h3>
                <p class="feature-description">{entry.description}</p>
              </div>
              <div class="feature-value">
                <div>
                  <span class="value-label">Use it to</span>
                  <p>{entry.use}</p>
                </div>
                <div>
                  <span class="value-label">Best fit</span>
                  <p>{entry.fit}</p>
                </div>
              </div>
            </div>
            <div class="feature-footer">
              <span>Reviewed {entry.reviewedDate}</span>
              <a href={entry.href} class="primary-link">Read the playbook <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="use-section" aria-labelledby="use-title">
      <div class="shell use-grid">
        <header>
          <p class="eyebrow">How to use a playbook</p>
          <h2 id="use-title">Choose the format your workflow can actually use.</h2>
          <p>A playbook is not a promise of outcomes. It is a maintained operating method, a clear output contract, and a record of what the available evidence can support.</p>
        </header>
        <ol class="mode-list">
          {usageModes.map((mode, index) => (
            <li>
              <span class="mode-number">0{index + 1}</span>
              <div>
                <h3>{mode.label}</h3>
                <p>{mode.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="coverage-section" aria-labelledby="coverage-title">
      <div class="shell coverage-inner">
        <p class="eyebrow">Future coverage</p>
        <h2 id="coverage-title">The library grows when a strategy is ready to be reviewed, maintained, and used.</h2>
        <p>Future releases may address other marketing disciplines. We will publish them only when the method, source trail, instructions, and limitations are complete. This keeps discovery focused on real material rather than empty inventory.</p>
        <a href={PLAYBOOK_META.canonical.replace("https://markethink.ai", "")} class="text-link">Explore the SEO and AI-search playbook</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  .mt-site-header { background: #0f1213 !important; }
</style>

<style>
  :global(body) { background: #f5f5f1; color: #0f1213; }
  .shell { width: min(1240px, calc(100% - 64px)); margin: 0 auto; }
  .library-hero { padding: 154px 0 92px; border-bottom: 1px solid rgba(15,18,19,.18); background: #edf4ea; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, .45fr); gap: clamp(48px, 8vw, 128px); align-items: end; }
  .breadcrumbs { display: flex; gap: 10px; align-items: center; margin-bottom: 64px; color: #686b6c; font-size: .78rem; text-transform: uppercase; letter-spacing: .12em; }
  .breadcrumbs a { color: #0f1213; text-decoration: underline; text-underline-offset: 4px; }
  .eyebrow { margin: 0 0 22px; color: #3c5b35; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; }
  h1, h2, h3 { margin: 0; color: #0f1213; font-family: "Instrument Serif", Georgia, serif; font-weight: 400; line-height: .98; }
  h1 { max-width: 860px; font-size: clamp(4rem, 8vw, 7.5rem); letter-spacing: -.055em; }
  .supporting-line { margin: 32px 0 0; max-width: 720px; font-family: "Instrument Serif", Georgia, serif; font-size: clamp(2rem, 3.5vw, 3.4rem); line-height: 1.05; }
  .intro { max-width: 700px; margin: 34px 0 0; color: #3f4647; font-size: 1.12rem; line-height: 1.72; }
  .library-note { border-top: 3px solid #0f1213; padding-top: 20px; }
  .library-note .note-index { display: block; margin-bottom: 18px; font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .13em; }
  .library-note p { margin: 0; color: #343a3b; line-height: 1.65; }
  .feature-section { padding: 108px 0 120px; background: #f5f5f1; }
  .feature-grid { display: grid; grid-template-columns: minmax(260px,.55fr) minmax(0,1.45fr); gap: clamp(42px, 8vw, 112px); align-items: start; }
  .feature-heading { position: sticky; top: 118px; }
  .feature-heading h2, .use-grid h2, .coverage-inner h2 { font-size: clamp(2.8rem, 5.2vw, 5.4rem); letter-spacing: -.04em; }
  .feature-card { background: #0f1213; color: #f5f5f1; border-radius: 2px; overflow: hidden; box-shadow: 0 24px 70px rgba(15,18,19,.12); }
  .feature-meta, .feature-footer { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; padding: 22px 28px; font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; }
  .feature-meta { border-bottom: 1px solid rgba(245,245,241,.18); color: #b4b6b6; }
  .feature-body { padding: clamp(34px,5vw,68px); }
  .feature-body h3 { max-width: 760px; color: #f5f5f1; font-size: clamp(3rem, 6vw, 6.5rem); letter-spacing: -.045em; }
  .feature-description { max-width: 690px; margin: 34px 0 0; color: #d6d7d3; font-size: 1.1rem; line-height: 1.7; }
  .feature-value { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 36px; margin-top: 72px; padding-top: 28px; border-top: 1px solid rgba(245,245,241,.18); }
  .value-label { color: #69d254; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .13em; }
  .feature-value p { margin: 14px 0 0; color: #d6d7d3; line-height: 1.62; }
  .feature-footer { justify-content: space-between; border-top: 1px solid rgba(245,245,241,.18); color: #b4b6b6; }
  .primary-link { display: inline-flex; gap: 10px; align-items: center; min-height: 46px; padding: 0 18px; background: #69d254; color: #0f1213; font-weight: 800; text-decoration: none; letter-spacing: 0; text-transform: none; }
  .primary-link:hover { background: #87e374; }
  .use-section { padding: 116px 0; background: #edf4ea; border-top: 1px solid rgba(15,18,19,.14); }
  .use-grid { display: grid; grid-template-columns: minmax(280px,.75fr) minmax(0,1.25fr); gap: clamp(52px,9vw,130px); }
  .use-grid > header > p:last-child { max-width: 560px; margin: 30px 0 0; color: #495051; line-height: 1.7; }
  .mode-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #b4b6b6; }
  .mode-list li { display: grid; grid-template-columns: 54px 1fr; gap: 24px; padding: 26px 0; border-bottom: 1px solid #b4b6b6; }
  .mode-number { padding-top: 4px; color: #3c5b35; font-size: .76rem; font-weight: 700; letter-spacing: .1em; }
  .mode-list h3 { font-size: 2rem; }
  .mode-list p { max-width: 620px; margin: 10px 0 0; color: #495051; line-height: 1.6; }
  .coverage-section { padding: 116px 0 126px; background: #f5f5f1; }
  .coverage-inner { max-width: 980px; }
  .coverage-inner p:not(.eyebrow) { max-width: 740px; margin: 32px 0 0; color: #495051; font-size: 1.06rem; line-height: 1.72; }
  .text-link { display: inline-block; margin-top: 30px; color: #0f1213; font-weight: 800; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  a:focus-visible { outline: 3px solid #0f1213; outline-offset: 4px; }
  @media (max-width: 860px) {
    .shell { width: min(100% - 36px, 1240px); }
    .library-hero { padding: 126px 0 72px; }
    .hero-grid, .feature-grid, .use-grid { grid-template-columns: 1fr; }
    .breadcrumbs { margin-bottom: 46px; }
    h1 { font-size: clamp(3.5rem, 16vw, 5.5rem); }
    .library-note { max-width: 560px; margin-top: 18px; }
    .feature-section, .use-section, .coverage-section { padding: 82px 0; }
    .feature-heading { position: static; }
    .feature-value { grid-template-columns: 1fr; margin-top: 50px; }
    .feature-footer { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 420px) {
    .shell { width: calc(100% - 28px); }
    .library-hero { padding-top: 112px; }
    h1 { font-size: 3.65rem; }
    .supporting-line { font-size: 2.25rem; }
    .feature-body { padding: 34px 24px; }
    .feature-body h3 { font-size: 3.25rem; }
    .feature-meta, .feature-footer { padding-left: 22px; padding-right: 22px; }
    .primary-link { width: 100%; justify-content: center; }
  }
</style>
