---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import AiSearchInteractiveGuide from "../../components/blog/AiSearchInteractiveGuide.astro";
import AiMarketingPracticalGuide from "../../components/blog/AiMarketingPracticalGuide.astro";
import SeoContentFeedbackLoopGuide from "../../components/blog/SeoContentFeedbackLoopGuide.astro";
import AiLogoBrandIdentityGuide from "../../components/blog/AiLogoBrandIdentityGuide.astro";
import { insightPosts, type BlogPost } from "../../data/blogPosts";

export function getStaticPaths() {
  return insightPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };
const isAiSearchInteractiveGuide = post.slug === "how-to-show-up-in-ai-search";
const isAiMarketingPracticalGuide =
  post.slug === "how-to-use-ai-for-marketing-small-business";
const isSeoContentFeedbackLoop = post.slug === "seo-content-feedback-loop";
const hasProtectedP04Mobile = isSeoContentFeedbackLoop;
const isAiLogoBrandIdentityGuide =
  post.slug ===
  "how-to-use-ai-to-create-an-impactful-logo-and-brand-identity-for-your-business";
const isWideGuide =
  isAiSearchInteractiveGuide ||
  isAiMarketingPracticalGuide ||
  isSeoContentFeedbackLoop ||
  isAiLogoBrandIdentityGuide;
const siteUrl = "https://markethink.ai";
const canonical = `${siteUrl}/blog/${post.slug}/`;
const isRepresentativeAgencyGuide = post.slug === "what-is-an-ai-marketing-agency";
const socialImage = post.imageSharing;
const socialImageWidth = 1200;
const socialImageHeight = 630;
const relatedPosts = post.relatedSlugs?.length
  ? post.relatedSlugs
      .map((slug) => insightPosts.find((item) => item.slug === slug))
      .filter((item): item is BlogPost => Boolean(item))
  : insightPosts.filter((item) => item.slug !== post.slug).slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  image: {
    "@type": "ImageObject",
    url: socialImage,
    contentUrl: socialImage,
    width: socialImageWidth,
    height: socialImageHeight,
    caption: post.imageAlt,
  },
  datePublished: post.publishedDate,
  dateModified: post.updatedDate,
  author: {
    "@type": "Organization",
    "@id": `${siteUrl}/#editorial-team`,
    name: post.author.name,
    parentOrganization: { "@id": `${siteUrl}/#organization` },
  },
  publisher: { "@id": `${siteUrl}/#organization` },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical,
  },
  keywords: post.keywords.join(", "),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: post.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${siteUrl}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: `${siteUrl}/blog/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.title,
      item: canonical,
    },
  ],
};
---

<Layout
  title={post.seoTitle}
  description={post.description}
  image={socialImage}
  imageAlt={post.imageAlt}
  imageWidth={socialImageWidth}
  imageHeight={socialImageHeight}
  canonical={canonical}
  type="article"
  structuredData={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <Navbar />
  <main class="article-page">
    <article>
      <header class="article-hero">
        <div class="container article-hero-grid">
          <div class="article-hero-copy animate-fade-up">
            <div class="article-hero-topline">
              <a href="/blog/" class="article-back"><span aria-hidden="true">←</span> Insights</a>
              <p class="article-kicker">{post.category}</p>
            </div>
            <h1>{post.title}</h1>
            <p class="article-excerpt">{post.excerpt}</p>
            <div class="article-meta" aria-label="Article details">
              <span>By {post.author.name}</span>
              <span>{post.readingTime}</span>
              <span
                >Updated {
                  new Date(post.updatedDate).toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                  })
                }</span
              >
            </div>
          </div>
          <div class:list={["article-hero-image", "animate-scale-in", { "article-hero-image--protected-mobile": hasProtectedP04Mobile }]}>
            <picture>
              <source media="(max-width: 680px)" srcset={post.imageMobile} type="image/webp" width="960" height="720" />
              <img src={post.image} alt={post.imageAlt} width="1440" height="810" fetchpriority="high" decoding="async" />
            </picture>
            <div class="hero-visual-rail" aria-label="The managed operating model">
              <span>Business context</span>
              <span>Expert judgment</span>
              <span>Connected execution</span>
            </div>
            <p class="hero-visual-caption">The managed loop <span aria-hidden="true">↗</span></p>
          </div>
        </div>
      </header>

      <div
        class:list={[
          "container",
          "article-layout",
          { "article-layout--wide": isWideGuide },
        ]}
      >
        <aside class="article-sidebar">
          <div class="sidebar-panel">
            <p class="sidebar-label">In this guide</p>
            <ol>
              {
                post.sections.map((section, index) => (
                  <li>
                    <a href={`#section-${index + 1}`}>{section.heading}</a>
                  </li>
                ))
              }
            </ol>
          </div>
        </aside>

        <div class="article-content">
          <section class="article-intro">
            {post.intro.map((paragraph) => <p>{paragraph}</p>)}
            {
              post.seoHubLink && (
                isRepresentativeAgencyGuide ? (
                  <p class="article-hub-link">
                    {post.seoHubLink.copy}{" "}
                    <a href={post.seoHubLink.href}>{post.seoHubLink.anchor}</a>. Our{" "}
                    <a href="/ai-marketing-for-small-business/">AI marketing for small business guide</a>{" "}
                    explains how to turn tools, content, approvals, and follow-up into one repeatable marketing system.
                  </p>
                ) : (
                  <p class="article-hub-link">
                    {post.seoHubLink.copy}{" "}
                    <a href={post.seoHubLink.href}>{post.seoHubLink.anchor}</a>{" "}
                    guide explains how to turn tools, content, approvals, and
                    follow-up into one repeatable marketing system.
                  </p>
                )
              )
            }
            {
              post.recommendedGuide && (
                isRepresentativeAgencyGuide ? (
                  <p class="article-hub-link article-hub-link--guide">
                    {post.recommendedGuide.copy}{" "}
                    <a href={post.recommendedGuide.href}>{post.recommendedGuide.anchor}</a>. For current adoption,
                    use-case, trust, and human-review evidence, explore the{" "}
                    <a href="/ai-marketing-statistics/">AI Marketing Statistics 2026 research ledger</a>.
                  </p>
                ) : isAiLogoBrandIdentityGuide ? (
                  <p class="article-hub-link article-hub-link--guide">
                    {post.recommendedGuide.copy}{" "}
                    <a href={post.recommendedGuide.href}>{post.recommendedGuide.anchor}</a>.
                  </p>
                ) : (
                  <p class="article-hub-link article-hub-link--guide">
                    {post.recommendedGuide.copy}{" "}
                    <a href={post.recommendedGuide.href}>
                      {post.recommendedGuide.anchor}
                    </a>
                    .
                  </p>
                )
              )
            }
            {
              isRepresentativeAgencyGuide && (
                <p class="article-hub-link article-hub-link--roadmap">
                  As a public working example, Markethink's <a href="/seo-aio-strategy/">30-day SEO and AIO roadmap</a>{" "}
                  shows how planning, execution, review, and accountability can be documented without claiming proven business results.
                </p>
              )
            }
          </section>

          {
            isAiMarketingPracticalGuide ? (
              <AiMarketingPracticalGuide />
            ) : isAiSearchInteractiveGuide ? (
              <AiSearchInteractiveGuide />
            ) : isSeoContentFeedbackLoop ? (
              <SeoContentFeedbackLoopGuide />
            ) : isAiLogoBrandIdentityGuide ? (
              <AiLogoBrandIdentityGuide />
            ) : (
              post.sections.map((section, index) => (
                <section id={`section-${index + 1}`} class="article-section">
                  <h2>{section.heading}</h2>
                  {section.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {section.image && (
                    <figure class="article-section-image">
                      <img
                        src={section.image}
                        alt={section.imageAlt ?? ""}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  )}
                  {section.bullets && (
                    <ul>
                      {section.bullets.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                </section>
              ))
            )
          }

          {!isAiLogoBrandIdentityGuide && <section class="article-cta">
            <p class="article-cta-label">Markethink perspective</p>
            <h2>
              {
                isAiMarketingPracticalGuide
                  ? "Build a marketing operation that ships and keeps getting sharper."
                  : isAiSearchInteractiveGuide
                    ? "Turn AI-search visibility into an operating plan."
                    : isSeoContentFeedbackLoop
                      ? "Turn content performance into the next approved improvement."
                      : isAiLogoBrandIdentityGuide
                        ? "Build an identity your marketing can keep using."
                    : "Marketing improves faster when the system remembers the work."
              }
            </h2>
            <p>
              {
                isAiMarketingPracticalGuide
                  ? "Markethink is an AI marketing system managed by expert marketers. It learns your business, runs the day-to-day marketing work, connects campaigns to leads and follow-up, and improves with every approval, correction, and result."
                  : isAiSearchInteractiveGuide
                    ? "Markethink is an AI marketing system managed by expert marketers. It connects website improvements, answer-ready content, approvals, measurement, leads, CRM, and follow-up so search visibility supports the pipeline instead of becoming another isolated SEO project."
                    : isSeoContentFeedbackLoop
                      ? "Markethink connects website work, search evidence, expert review, approvals, leads, CRM, and follow-up in one improving marketing operation. The system keeps the work moving. A real marketing team directs the strategy, reviews the recommendations, and stays accountable for what ships."
                      : isAiLogoBrandIdentityGuide
                        ? "Markethink is an AI marketing system managed by expert marketers. We connect brand direction, content, website work, campaigns, approvals, leads, and follow-up so the identity becomes part of a marketing operation that ships and keeps getting sharper."
                    : "Markethink helps your business organize brand intelligence, campaign workflow, content production, approvals, and lead opportunities in one improving system."
              }
            </p>
            <a href="/schedule-a-walkthrough/" class="button"
              >Book a Walkthrough</a
            >
          </section>}

          <section class="article-faq">
            <p class="article-cta-label">FAQ</p>
            <h2>Common questions</h2>
            {
              post.faq.map((item) => (
                <details>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))
            }
          </section>
        </div>
      </div>
    </article>

    <section class="related-section">
      <div class="container">
        <div class="related-header">
          <p class="subtitle">KEEP READING</p>
          <h2>More Markethink insights</h2>
        </div>
        <div class="related-grid">
          {
            relatedPosts.map((related) => (
              <a href={`/blog/${related.slug}/`} class="related-card">
                <picture>
                  <img
                    src={related.imageThumbnail}
                    alt={related.imageAlt}
                    width="960"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <div>
                  <span>{related.category}</span>
                  <h3>{related.title}</h3>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  {!isAiLogoBrandIdentityGuide && <FinalCTA animate={false} />}
  <Footer />
</Layout>

<style is:global>
  @media (max-width: 359px) {
    .audit-grid {
      grid-template-columns: minmax(0, 1fr) !important;
    }

    .audit-copy,
    .audit-form {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }

    .audit-form iframe,
    .audit-form iframe + *,
    .audit-form:has(iframe) div:has(> iframe),
    .audit-form:has(iframe) div:has(> div > iframe) {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
  }
</style>

<style>
  .article-page {
    background: var(--bg-primary);
  }

  .article-hero {
    padding: 10rem 0 5rem;
  }

  .article-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 4rem;
    align-items: center;
  }

  .article-back {
    display: inline-flex;
    margin-bottom: 2rem;
    color: var(--color-secondary);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .article-kicker,
  .article-cta-label {
    color: var(--color-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .article-hero h1 {
    margin-top: 0.9rem;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .article-excerpt {
    margin-top: 1.5rem;
    max-width: 40rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.08rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.82rem;
  }

  .article-meta span:not(:last-child)::after {
    content: "/";
    margin-left: 0.8rem;
    color: rgba(255, 255, 255, 0.24);
  }

  .article-hero-image {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-medium);
    background: rgba(255, 255, 255, 0.04);
  }

  .article-hero-image picture,
  .article-hero-image img {
    width: 100%;
  }

  .article-hero-image img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 44rem);
    gap: 4rem;
    align-items: start;
    padding-bottom: 5rem;
  }

  .article-layout--wide {
    grid-template-columns: 16rem minmax(0, 52rem);
  }

  .article-sidebar {
    position: sticky;
    top: 7rem;
  }

  .sidebar-panel {
    padding: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.03);
  }

  .sidebar-label {
    margin-bottom: 0.9rem;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sidebar-panel ol {
    display: grid;
    gap: 0.8rem;
    padding-left: 1rem;
  }

  .sidebar-panel a {
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.86rem;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .sidebar-panel a:hover {
    color: var(--text-invert);
  }

  .article-content {
    max-width: 44rem;
  }

  .article-intro {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .article-content p,
  .article-content li {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.02rem;
    line-height: 1.78;
  }

  .article-content p + p {
    margin-top: 1.1rem;
  }

  .article-hub-link {
    margin-top: 1.4rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(105, 210, 84, 0.22);
    border-radius: 1rem;
    background: rgba(105, 210, 84, 0.06);
  }

  .article-hub-link a {
    color: var(--color-secondary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .article-section {
    padding: 3rem 0 0;
  }

  .article-section h2,
  .article-cta h2,
  .article-faq h2 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
  }

  .article-section ul {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.3rem;
    padding: 1.5rem 1.5rem 1.5rem 2.4rem;
    border: 1px solid rgba(105, 210, 84, 0.18);
    border-radius: 1rem;
    background: rgba(105, 210, 84, 0.05);
  }

  .article-section li::marker {
    color: var(--color-secondary);
  }

  .article-section-image {
    overflow: hidden;
    margin: 1.75rem 0 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-medium);
    background: rgba(255, 255, 255, 0.03);
  }

  .article-section-image img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .article-cta,
  .article-faq {
    margin-top: 3.5rem;
    padding: 2rem;
    border-radius: var(--radius-medium);
  }

  .article-cta {
    background: var(--color-secondary);
    color: var(--text-primary);
  }

  .article-cta .article-cta-label,
  .article-cta p {
    color: rgba(15, 18, 19, 0.75);
  }

  .article-cta .button {
    margin-top: 1.4rem;
    background: var(--bg-primary);
    color: var(--text-invert);
  }

  .article-faq {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }

  details {
    padding: 1.2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  summary {
    cursor: pointer;
    color: var(--text-invert);
    font-weight: 600;
  }

  details p {
    margin-top: 0.8rem;
  }

  .related-section {
    padding: 5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .related-header h2 {
    margin-top: 0.8rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.2rem;
  }

  .related-card {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-medium);
    background: rgba(255, 255, 255, 0.03);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    border-color: rgba(105, 210, 84, 0.34);
  }

  .related-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .related-card div {
    padding: 1rem;
  }

  .related-card span {
    color: var(--color-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-card h3 {
    margin-top: 0.5rem;
    font-size: 1.2rem;
    line-height: 1.25;
  }

  @media (max-width: 991px) {
    .article-hero-grid,
    .article-layout {
      grid-template-columns: 1fr;
    }

    .article-layout.article-layout--wide {
      grid-template-columns: minmax(0, 1fr);
    }

    .article-content {
      min-width: 0;
    }

    .article-sidebar {
      position: static;
      order: 2;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .article-hero {
      padding: 8rem 0 3.5rem;
    }

    .article-layout {
      gap: 2rem;
    }

    .article-meta span::after {
      display: none;
    }
  }

  /* Editorial review treatment: scoped to the article template. */
  .article-page {
    --article-paper: #f4f1e8;
    --article-paper-bright: #fbfaf5;
    --article-ink: #0f1213;
    --article-muted: #5f655f;
    --article-green: #69d254;
        overflow: clip;
    background: var(--article-paper);
    color: var(--article-ink);
  }

  .article-hero {
    padding: clamp(7.1rem, 9vw, 8.2rem) 0 clamp(1.9rem, 3vw, 2.7rem);
    border-bottom: 1px solid rgba(245, 245, 241, 0.12);
    background:
      radial-gradient(circle at 7% 100%, rgba(105, 210, 84, 0.13), transparent 28rem),
      radial-gradient(circle at 94% 10%, rgba(105, 210, 84, 0.12), transparent 24rem),
      var(--article-ink);
    color: #f7f6ef;
  }

  .article-hero-grid {
    grid-template-columns: minmax(0, 1.12fr) minmax(25rem, 0.88fr);
    gap: clamp(2rem, 4vw, 3.8rem);
    align-items: stretch;
  }

  .article-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .article-hero-topline {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .article-back {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin: 0;
    color: rgba(247, 246, 239, 0.64);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .article-back:hover,
  .article-back:focus-visible { color: #fff; }

  .article-kicker {
    padding-left: 1rem;
    border-left: 1px solid rgba(247, 246, 239, 0.25);
    color: var(--article-green);
  }

  .article-hero h1 {
    max-width: 46rem;
    margin-top: 0;
    font: 600 clamp(3rem, 3.7vw, 4.2rem)/0.96 Inter, system-ui, sans-serif;
    letter-spacing: -0.058em;
    text-wrap: balance;
  }

  .article-excerpt {
    max-width: 38rem;
    margin-top: 1.15rem;
    color: rgba(247, 246, 239, 0.74);
    font-size: clamp(0.94rem, 1.15vw, 1.04rem);
    line-height: 1.55;
  }

  .article-meta {
    gap: 0.65rem;
    margin-top: 1.1rem;
    color: rgba(247, 246, 239, 0.5);
    font-size: 0.75rem;
  }

  .article-meta span:not(:last-child)::after {
    margin-left: 0.65rem;
    color: rgba(247, 246, 239, 0.22);
  }

  .article-hero-image {
    position: relative;
    min-width: 0;
    min-height: 21.5rem;
    aspect-ratio: 16 / 9;
