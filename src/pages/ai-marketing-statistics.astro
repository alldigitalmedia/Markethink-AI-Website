---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ledger from "../data/aiMarketingStatistics.json";

const pageTitle = "AI Marketing Statistics 2026: 60 Sourced Data Points | Markethink";
const pageDescription =
  "Explore 60 AI marketing statistics for 2026 with original sources, populations, research dates, definitions, sample sizes, and limitations.";
const canonical = "https://markethink.ai/ai-marketing-statistics/";
const heroImage = "/images/ai-marketing-statistics-business-owner-v6.svg";
const socialImage = "https://dashboard.markethink.ai/generated/landing/markethink/markethink/ai-marketing-statistics-business-owner-v6-og-1200x630.jpg";
const socialImageAlt = "Illustrative specialty-product business owner comparing two campaign photo proofs beside her product while packing operations continue behind her.";

const sections = [
  { id: "adoption", label: "01", shortLabel: "Adoption", title: "Adoption is broad. Deployment is not the same thing.", intro: "These figures use different units: firms, employees, marketing teams, pilots, and organization-wide deployment. Read the scope before comparing percentages.", keys: ["adoption"] },
  { id: "small-business", label: "02", shortLabel: "Small business", title: "Small-business use depends on what the survey counts.", intro: "A survey asking about any business AI use can produce a very different number from one asking about AI in marketing. Both can be accurate within their definitions.", keys: ["small-business"] },
  { id: "marketing-use-cases", label: "03", shortLabel: "Use cases", title: "Marketing is a leading business use case.", intro: "The strongest evidence points to active use across sales and marketing, but the maturity of that use varies from experimentation to embedded workflows.", keys: ["marketing-use-cases"] },
  { id: "content-and-campaigns", label: "04", shortLabel: "Content", title: "Content is the entry point. Campaign operations are wider.", intro: "Copy and creative production lead current usage. Social, SEO, email, and advertising workflows show where AI is moving beyond a single drafting tool.", keys: ["content-and-campaigns"] },
  { id: "crm-leads-follow-up", label: "05", shortLabel: "Leads", title: "Lead and follow-up evidence needs careful attribution.", intro: "Survey respondents report improved lead generation and growing use in email. These are useful operating signals, not proof that AI caused the outcome.", keys: ["crm-leads-follow-up"] },
  { id: "human-review", label: "06", shortLabel: "Human review", title: "Human review remains part of the operating model.", intro: "Respondents consistently point to augmentation, disclosure, and escalation to people. This is evidence about preferred controls and working models, not a universal rule for every task.", keys: ["human-review"] },
  { id: "budgets-and-investment", label: "07", shortLabel: "Investment", title: "Investment is moving toward AI, with scrutiny attached.", intro: "The available budget figure records stated 2026 priorities. It should not be read as realized spend or return on investment.", keys: ["budgets-and-investment"] },
  { id: "trust-governance-limits", label: "08", shortLabel: "Trust", title: "Trust, governance, and measurement are still unresolved.", intro: "Consumers and advertisers do not always see AI-generated marketing the same way. Disclosure, measurement frameworks, and content quality remain material constraints.", keys: ["trust-and-governance", "barriers-and-limits"] },
  { id: "measured-outcomes", label: "09", shortLabel: "Outcomes", title: "Most outcome data is self-reported, not causal.", intro: "Productivity, quality, personalization, lead, and retention findings describe what respondents observed. They do not isolate AI from strategy, staffing, channels, or market conditions.", keys: ["measured-outcomes"] },
];

const stats = ledger.statistics;
const sources = Object.entries(ledger.sources);
const featuredIds = ["AM011", "AM025", "AM049", "AM055"];
const featured = featuredIds.map((id) => stats.find((item) => item.id === id)).filter(Boolean);
const sectionStats = (keys: string[]) => stats.filter((item) => keys.includes(item.section));
const sourceYear = (value: string) => value.match(/\d{4}/)?.[0] ?? value;
const sourceName = (url: string) => {
  const record = sources.find(([, source]) => source.source_url === url);
  return record ? record[1].publisher : new URL(url).hostname.replace("www.", "");
};
const percentParts = (value: string) => value.match(/^([0-9.]+)(%)$/);
const featuredValue = (item: (typeof stats)[number]) => item.id === "AM049" ? "37-point gap" : item.value;

const compositeValues: Record<string, { label: string; value: string }[]> = {
  AM049: [
    { label: "Ad executives’ belief", value: "82%" },
    { label: "Young consumers’ response", value: "45%" },
  ],
  AM050: [
    { label: "Gen Z negative", value: "39%" },
    { label: "Millennial negative", value: "20%" },
  ],
  AM057: [
    { label: "Extensive use", value: "42.5%" },
    { label: "Occasional use", value: "38%" },
  ],
  AM058: [
    { label: "Extensive use", value: "34.1%" },
    { label: "Occasional use", value: "36.5%" },
  ],
};

const articleSchema = {
  "@type": "Article",
  headline: "AI Marketing Statistics 2026",
  description: pageDescription,
  url: canonical,
  image: {
    "@type": "ImageObject",
    url: socialImage,
    contentUrl: socialImage,
    width: 1200,
    height: 630,
    caption: socialImageAlt,
  },
  dateCreated: "2026-09-12",
  dateModified: "2026-09-12",
  inLanguage: "en",
  author: { "@type": "Organization", "@id": "https://markethink.ai/#organization", name: "Markethink" },
  about: ["Artificial intelligence in marketing", "Marketing operations", "AI adoption"],
  citation: sources.map(([, source]) => source.source_url),
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://markethink.ai/" },
    { "@type": "ListItem", position: 2, name: "AI Marketing Statistics", item: canonical },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical} image={socialImage} imageAlt={socialImageAlt} imageWidth={1200} imageHeight={630} type="article" structuredData={[articleSchema, breadcrumbSchema]}>
  <Navbar ctaLabel="Request available times" />
  <main id="top">
    <article>
      <header class="resource-hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Research</span></nav>
            <p class="eyebrow">MARKETHINK RESEARCH LEDGER</p>
            <h1>AI Marketing Statistics 2026</h1>
            <p class="dek">A selective collection of <strong>{ledger.statistic_count} AI marketing statistics</strong> from <strong>{ledger.source_count} original sources</strong>. Every number keeps its source, date, population, definition, and limitation close enough to check.</p>
            <div class="hero-meta" aria-label="Resource details">
              <span>Substantively reviewed September 12, 2026</span>
              <span>Curated and analyzed by Markethink</span>
            </div>
            <div class="download-row">
              <a class="button" href="/downloads/ai-marketing-statistics-source-ledger.csv" download>Download all 60 rows <span aria-hidden="true">↓</span></a>
              <a class="text-link" href="#data-charts">Start with three charts</a>
            </div>
          </div>
          <figure class="hero-visual">
            <img src={heroImage} width="1536" height="1024" fetchpriority="high" alt="An illustrative specialty-food business owner on her packing floor weighs two physical campaign photo proofs beside the jar she sells while packing continues behind her." />
            <figcaption>Conceptual illustration.</figcaption>
          </figure>
        </div>
      </header>

      <section class="chart-suite" id="data-charts" aria-labelledby="charts-title">
        <div class="container">
          <div class="section-heading chart-heading">
            <p class="eyebrow">THREE SOURCE-LED VIEWS</p>
            <h2 id="charts-title">Different populations. Different questions. No false comparison.</h2>
            <p>These charts stay within each study’s denominator. The accompanying tables repeat every value.</p>
          </div>

          <figure class="chart-card" aria-labelledby="chart-oecd-title">
            <div class="chart-intro">
              <div><p class="chart-index">CHART 01</p><h3 id="chart-oecd-title">Large firms reported AI use at nearly three times the small-firm rate.</h3></div>
              <a href="/charts/oecd-firm-ai-use-2025.svg" download>Download SVG ↓</a>
            </div>
            <div class="bar-chart" role="img" aria-label="In 2025, 17.4 percent of small firms and 52.0 percent of large firms across covered OECD countries reported using AI.">
              <div class="bar-row"><span class="bar-label">Small firms</span><span class="bar-track"><span style="width:17.4%"></span></span><strong>17.4%</strong></div>
              <div class="bar-row dark"><span class="bar-label">Large firms</span><span class="bar-track"><span style="width:52%"></span></span><strong>52.0%</strong></div>
            </div>
            <table><caption>OECD firm AI use by size, 2025</caption><thead><tr><th>Population</th><th>Share reporting AI use</th></tr></thead><tbody><tr><th>Small firms</th><td>17.4%</td></tr><tr><th>Large firms</th><td>52.0%</td></tr></tbody></table>
            <figcaption><strong>Source:</strong> <a href={ledger.sources.S2.source_url}>OECD</a> · Data year: 2025 · Published January 28, 2026 · Population: national business ICT surveys in OECD countries with available data; n varies by country. <strong>Limit:</strong> coverage and firm-size thresholds can vary by national source. This is descriptive, not causal.</figcaption>
          </figure>

          <figure class="chart-card" aria-labelledby="chart-cmi-title">
            <div class="chart-intro">
              <div><p class="chart-index">CHART 02</p><h3 id="chart-cmi-title">Copy leads AI tool use among AI-using B2B marketers.</h3></div>
              <a href="/charts/cmi-b2b-ai-tool-use-2025.svg" download>Download SVG ↓</a>
            </div>
            <div class="bar-chart multi" role="img" aria-label="Among eligible AI-using B2B marketers, 89 percent used copy tools, 53 percent creative asset tools, 41 percent SEO tools, 38 percent social media tools, and 36 percent email marketing tools. Multiple responses were allowed.">
              {[{label:"Copy",value:"89%",width:"89%"},{label:"Creative",value:"53%",width:"53%"},{label:"SEO",value:"41%",width:"41%"},{label:"Social",value:"38%",width:"38%"},{label:"Email",value:"36%",width:"36%"}].map((row) => <div class="bar-row"><span class="bar-label">{row.label}</span><span class="bar-track"><span style={`width:${row.width}`}></span></span><strong>{row.value}</strong></div>)}
            </div>
            <table><caption>AI tools used by eligible AI-using B2B marketers</caption><thead><tr><th>Tool category</th><th>Share selecting category</th></tr></thead><tbody><tr><th>Copy</th><td>89%</td></tr><tr><th>Creative assets</th><td>53%</td></tr><tr><th>SEO</th><td>41%</td></tr><tr><th>Social media</th><td>38%</td></tr><tr><th>Email marketing</th><td>36%</td></tr></tbody></table>
            <figcaption><strong>Source:</strong> <a href={ledger.sources.S5.source_url}>Content Marketing Institute and MarketingProfs</a> · Published October 8, 2025 · Fielded June 24 to August 14, 2025 · Eligible population: B2B marketers whose organizations use AI-powered applications; the article reports on 1,015 B2B marketers, mostly in North America. <strong>Limit:</strong> self-reported, sponsor-backed research. Multiple responses were allowed, so the categories should not be summed.</figcaption>
          </figure>

          <figure class="chart-card inverse" aria-labelledby="chart-iab-title">
            <div class="chart-intro">
              <div><p class="chart-index">CHART 03</p><h3 id="chart-iab-title">Advertisers overestimated young consumers’ positive sentiment by 37 points.</h3></div>
              <a href="/charts/iab-ai-ad-perception-gap-2026.svg" download>Download SVG ↓</a>
            </div>
            <div class="bar-chart" role="img" aria-label="Eighty-two percent of ad executives believed Gen Z and Millennial consumers felt positive about AI-generated ads, while 45 percent of surveyed young consumers reported positive sentiment. The difference is 37 percentage points.">
              <div class="bar-row"><span class="bar-label">Ad executives’ belief</span><span class="bar-track"><span style="width:82%"></span></span><strong>82%</strong></div>
              <div class="bar-row light"><span class="bar-label">Young consumers’ response</span><span class="bar-track"><span style="width:45%"></span></span><strong>45%</strong></div>
              <p class="gap-callout"><span>37</span> percentage-point gap</p>
            </div>
            <table><caption>IAB advertiser perception and young-consumer sentiment</caption><thead><tr><th>Respondent group</th><th>Positive sentiment measure</th></tr></thead><tbody><tr><th>Ad executives’ belief about consumers</th><td>82%</td></tr><tr><th>Surveyed Gen Z and Millennial consumers</th><td>45%</td></tr></tbody></table>
            <figcaption><strong>Source:</strong> <a href={ledger.sources.S7.source_url}>IAB and Sonata Insights</a> · Fielded October 2025 to January 2026 · United States · Populations: 104 ad executives at companies spending at least $1 million annually on media, and 505 ad-engaged Gen Z and Millennial consumers. <strong>Limit:</strong> separately sampled groups answered different-perspective questions. The gap is descriptive, not causal.</figcaption>
          </figure>
        </div>
      </section>

      <section class="key-findings" aria-labelledby="key-findings-title">
        <div class="container">
          <div class="section-heading compact"><p class="eyebrow">FOUR NUMBERS TO START WITH</p><h2 id="key-findings-title">The useful story is adoption plus operating discipline.</h2></div>
          <div class="finding-grid">
            {featured.map((item) => {
              const display = featuredValue(item);
              const parts = percentParts(display);
              return <blockquote class="finding" cite={item.source_url}>
                <strong>{parts ? <span class="measure"><span>{parts[1]}</span><span class="unit">{parts[2]}</span></span> : display}</strong>
                <p>{item.claim}</p>
                <footer><a href={item.source_url} rel="nofollow">{sourceName(item.source_url)}, {sourceYear(item.publication_date)}</a><span>{item.id}</span></footer>
              </blockquote>;
            })}
          </div>
        </div>
      </section>

      <section class="analysis" aria-labelledby="analysis-title">
        <div class="container analysis-grid">
          <div><p class="eyebrow">MARKETHINK ANALYSIS</p><h2 id="analysis-title">What this evidence can support.</h2></div>
          <div class="analysis-list">
            <article><span>01</span><div><h3>Adoption is not one number.</h3><p>Firm-level surveys, marketing-team surveys, and vendor studies count different behaviors. Treat the definition as part of the statistic.</p></div></article>
            <article><span>02</span><div><h3>Broad use can coexist with shallow deployment.</h3><p>High “any use” figures sit beside lower organization-wide deployment figures. Experimentation is not the same as an embedded operating system.</p></div></article>
            <article><span>03</span><div><h3>Content is common. Measurement is less mature.</h3><p>Writing and creative tools lead use cases, while measurement frameworks and causal outcome evidence remain limited.</p></div></article>
            <article><span>04</span><div><h3>Trust depends on visible human controls.</h3><p>In one global survey, organizations ranked clear AI disclosure and easy escalation to human support among the most important trust factors. These results describe stated priorities, not proof that either control produces trust.</p></div></article>
          </div>
        </div>
      </section>

      <div class="resource-body container">
        <aside class="contents" aria-label="Jump to topic">
          <p>JUMP TO TOPIC</p>
          <ol>
            {sections.map((section) => <li><a href={`#${section.id}`}><span>{section.label}</span>{section.shortLabel}</a></li>)}
            <li><a href="#methodology"><span>10</span>Methods</a></li>
            <li><a href="#sources"><span>11</span>Sources</a></li>
          </ol>
        </aside>

        <div class="stat-sections">
          {sections.map((section) => {
            const entries = sectionStats(section.keys);
            return <section class="stat-section" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="section-heading"><p class="section-number">{section.label} / {String(sections.length).padStart(2, "0")}</p><h2 id={`${section.id}-title`}>{section.title}</h2><p>{section.intro}</p></div>
              <div class="stat-list">
                {entries.map((item) => {
                  const simple = percentParts(item.value);
                  const groups = compositeValues[item.id];
                  return <article class="stat-row" id={item.id.toLowerCase()}>
                    <div class:list={["stat-value", groups && "is-composite"]}>
                      {groups ? groups.map((group) => {
                        const groupParts = percentParts(group.value)!;
                        return <div class="value-group"><span class="value-group-label">{group.label}</span><span class="measure"><span>{groupParts[1]}</span><span class="unit">{groupParts[2]}</span></span></div>;
                      }) : simple ? <span class="measure"><span>{simple[1]}</span><span class="unit">{simple[2]}</span></span> : <span class="value-phrase">{item.value}</span>}
                    </div>
                    <div class="stat-detail">
                      <p class="stat-claim">{item.claim}</p>
                      <div class="stat-meta" aria-label="Source, year, and population">
                        <a href={item.source_url} rel="nofollow">{item.publisher}</a><span>{item.publication_date}</span><span>{item.sample_size}</span>
                      </div>
                      <details><summary>Study context and limits</summary><dl><div><dt>Evidence</dt><dd>{item.evidence_type}</dd></div><div><dt>Study</dt><dd>{item.geography}; {item.research_period}</dd></div><div><dt>Limitation</dt><dd>{item.context_note}</dd></div></dl></details>
                      <a class="stat-id" href={`#${item.id.toLowerCase()}`} aria-label={`Permanent link to statistic ${item.id}`}>{item.id}</a>
                    </div>
                  </article>;
                })}
              </div>
            </section>;
          })}

          <section class="method-section" id="methodology" aria-labelledby="methodology-title">
            <p class="eyebrow">HOW THIS RESOURCE WAS BUILT</p><h2 id="methodology-title">Methodology and limitations</h2>
            <div class="method-details">
              <details open><summary>Inclusion and verification standards</summary><div class="method-grid"><div><h3>Inclusion standard</h3><p>We included a number only when it appeared in an original government dataset, official research report, original survey, or the publisher’s own report page. Secondary statistics roundups were not used as evidence.</p></div><div><h3>Verification standard</h3><p>Each source URL was loaded during the September 12, 2026 review. Every displayed number maps to a ledger ID, publisher, research period, geography, sample note, evidence type, and limitation.</p></div></div></details>
              <details><summary>Claims, curator role, and known limits</summary><div class="method-grid"><div><h3>What the page does not claim</h3><p>Self-reported improvement does not prove causation. Stated plans are not realized adoption. Opinions and preferences are not measured business outcomes. Unlike survey questions are not averaged together.</p></div><div><h3>Curator role</h3><p>Markethink is the curator and analyst, not the original source of third-party statistics. Our analysis is labeled and kept separate from source findings.</p></div></div><ul class="known-limits"><li>Definitions of AI, generative AI, and agentic AI vary by study.</li><li>Several sources are vendor-sponsored or vendor-published and rely on self-reported responses.</li><li>Global surveys do not automatically represent every country or small business.</li><li>Some subgroup findings use much smaller samples than the headline survey.</li><li>This page is a dated evidence review, not a live market counter.</li></ul></details>
            </div>
            <div class="download-panel"><div><p class="eyebrow">MACHINE-READABLE</p><h3>Audit the dataset yourself.</h3><p>The downloads contain all {ledger.statistic_count} rows and their research context.</p></div><div class="download-actions"><a class="button dark" href="/downloads/ai-marketing-statistics-source-ledger.csv" download>Download CSV</a><a class="text-link dark-link" href="/downloads/ai-marketing-statistics-source-ledger.json" download>Download JSON</a></div></div>
          </section>

          <section class="method-section" id="sources" aria-labelledby="sources-title">
            <p class="eyebrow">PRIMARY SOURCE INDEX</p><h2 id="sources-title">Nine original sources, with their boundaries.</h2>
            <ol class="source-list">{sources.map(([id, source]) => <li id={`source-${id.toLowerCase()}`}><div class="source-number">{id}</div><div><h3><a href={source.source_url}>{source.title}</a></h3><p>{source.publisher} · {source.publication_date} · {source.geography}</p><details><summary>Research period, sample, and limitation</summary><dl><div><dt>Research period</dt><dd>{source.research_period}</dd></div><div><dt>Sample</dt><dd>{source.sample_size}</dd></div><div><dt>Source type</dt><dd>{source.source_type}</dd></div><div><dt>Limitation</dt><dd>{source.limitation}</dd></div></dl></details></div></li>)}</ol>
          </section>

          <section class="method-section" id="glossary" aria-labelledby="glossary-title"><p class="eyebrow">DEFINITIONS</p><h2 id="glossary-title">Glossary</h2><dl class="glossary"><div><dt>AI adoption</dt><dd>A respondent reports using an AI technology. This can range from one task to organization-wide use.</dd></div><div><dt>Experimentation or pilot</dt><dd>Limited testing that has not necessarily reached standard workflows or broad deployment.</dd></div><div><dt>Scaled deployment</dt><dd>Use expanded across a function or organization. Each source’s exact definition still applies.</dd></div><div><dt>Generative AI</dt><dd>Systems that create text, images, audio, video, or other outputs from prompts or data.</dd></div><div><dt>Self-reported use</dt><dd>Use described by a survey respondent. It is not independently observed behavior.</dd></div><div><dt>Self-reported outcome</dt><dd>An improvement or decline described by a respondent, without experimental proof that AI caused it.</dd></div></dl></section>

          <section class="method-section update-section" id="updates" aria-labelledby="updates-title"><p class="eyebrow">UPDATE LOG</p><h2 id="updates-title">What changed in this edition.</h2><div class="update-entry"><time datetime="2026-09-12">September 12, 2026</time><p>Initial research edition prepared with {ledger.statistic_count} verified statistics from {ledger.source_count} original sources. The review records the evidence available on that date and will change only when the research changes.</p></div></section>
        </div>
      </div>

      <section class="related-reading" aria-labelledby="related-title"><div class="container related-grid"><div><p class="eyebrow">KEEP RESEARCHING</p><h2 id="related-title">Put the numbers in operating context.</h2></div><div class="related-links"><a href="/ai-marketing-for-small-business/"><span>Guide</span><strong>AI marketing for small business</strong><p>Where AI helps, where tools stop, and what a managed system adds.</p></a><a href="/"><span>Operating model</span><strong>How managed AI marketing should work</strong><p>See how Markethink pairs AI execution with expert strategy, review, and accountability.</p></a></div></div></section>

      <section class="quiet-cta" aria-labelledby="cta-title"><div class="container cta-grid"><div><p class="eyebrow">APPLY THE RESEARCH</p><h2 id="cta-title">Map the evidence to your marketing operation.</h2><p>Request a focused walkthrough of the workflows, controls, and measurement gaps that matter for your business.</p></div><div class="cta-action"><a class="button" href="/schedule-a-walkthrough/">Request available times</a><p>Tell us what you are working on. We will reply with available times.</p></div></div></section>
    </article>
  </main>
  <Footer walkthroughLabel="Request available times" description="Markethink is an AI marketing system managed by expert marketers. We learn your business, run marketing day to day, and connect campaigns to leads and follow-up." />
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f4f2ec; }
  main { color: #0f1213; }
  .resource-hero { background: #0f1213; color: #fff; padding: 7.6rem 0 2.8rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .breadcrumbs { display: flex; gap: .55rem; align-items: center; margin-bottom: 1.6rem; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.52); }
  .breadcrumbs a { color: inherit; }
  .eyebrow, .section-number, .contents > p, .chart-index { font-size: .68rem; line-height: 1.2; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; }
  .eyebrow { color: #69d254; margin-bottom: .75rem; }
  h1 { font-size: clamp(3.5rem, 6.3vw, 6.6rem); line-height: .9; letter-spacing: -.025em; max-width: 9ch; text-wrap: balance; }
  .dek { margin-top: 1.45rem; max-width: 43rem; font-size: clamp(1rem, 1.35vw, 1.22rem); line-height: 1.58; color: rgba(255,255,255,.72); }
  .dek strong { color: #fff; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin-top: 1.15rem; font-size: .74rem; color: rgba(255,255,255,.53); }
  .download-row { display: flex; flex-wrap: wrap; align-items: center; gap: .85rem 1.2rem; margin-top: 1.45rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: .65rem; min-height: 45px; padding: .72rem 1rem; border: 1px solid #69d254; border-radius: 999px; background: #69d254; color: #0f1213; font-size: .78rem; font-weight: 700; text-decoration: none; }
  .button:hover { background: #7cdf67; border-color: #7cdf67; }
  .text-link { color: #fff; font-size: .78rem; text-decoration: underline; text-underline-offset: .25em; }
  .hero-visual { position: relative; margin: 0; }
  .hero-visual picture, .hero-visual > img { display: block; overflow: hidden; border-radius: 1.15rem; aspect-ratio: 3 / 2; background: #1b1f20; }
