---
import Layout from "../layouts/Layout.astro";

const slides = [
  { id: "the-owner-tax", label: "The owner tax", section: "The problem" },
  { id: "why-now", label: "Why now", section: "The pressure" },
  { id: "fragmented", label: "Fragmented", section: "The current state" },
  { id: "one-operation", label: "One operation", section: "The future state" },
  { id: "system-map", label: "System map", section: "The bridge" },
  { id: "business-knowledge", label: "Business knowledge", section: "Layer 01" },
  { id: "data-connections", label: "Data and connections", section: "Layer 02" },
  { id: "marketing-operations", label: "Marketing operations", section: "Layer 03" },
  { id: "growth-pipeline", label: "Growth and pipeline", section: "Layer 04" },
  { id: "walkthrough", label: "Walkthrough", section: "Next step" },
];
---

<Layout
  title="One Managed Marketing Operation | Private Markethink Presentation"
  description="A private Markethink presentation about connecting business knowledge, data, marketing operations, and pipeline into one expert-managed system."
  canonical="https://markethink.ai/presentation-marketing-operation/"
  noindex={true}
>
  <main class="deck-page" data-deck aria-label="Private Markethink prospect presentation">
    <div class="deck-stage" role="region" aria-roledescription="carousel" aria-label="One managed marketing operation">
      <header class="deck-header">
        <a href="/" class="brand" aria-label="Markethink home">
          <img src="/images/logo.svg" alt="Markethink" />
        </a>
        <div class="private-label"><span></span> Private presentation</div>
      </header>

      <div class="slides" aria-live="polite">
        <section class="slide slide-hero is-active" id="the-owner-tax" data-slide="0" aria-label="Slide 1 of 10: The owner tax">
          <div class="slide-grid hero-grid">
            <div class="copy-block">
              <p class="eyebrow"><span>01</span> The problem</p>
              <h1>Your marketing should not need you to hold <em>every piece together.</em></h1>
              <p class="lede">The knowledge sits in your head. Specialists work in separate lanes. Tools hold partial context. Campaigns launch. Leads arrive. You become the person connecting it all.</p>
              <div class="owner-line"><span class="pulse"></span><strong>The hidden role:</strong> owner, operator, reviewer, and handoff point.</div>
            </div>
            <div class="scatter" aria-label="Fragmented marketing responsibilities">
              <div class="scatter-core">YOU<small>holding it together</small></div>
              <span class="orbit o1">Website</span><span class="orbit o2">Campaigns</span><span class="orbit o3">Social</span><span class="orbit o4">Specialists</span><span class="orbit o5">CRM</span><span class="orbit o6">Follow-up</span>
              <svg viewBox="0 0 500 390" aria-hidden="true"><path d="M250 195L95 72M250 195L397 58M250 195L438 185M250 195L389 326M250 195L111 327M250 195L58 191" /></svg>
            </div>
          </div>
        </section>

        <section class="slide" id="why-now" data-slide="1" aria-label="Slide 2 of 10: Why now">
          <div class="slide-grid split-grid">
            <div class="copy-block">
              <p class="eyebrow"><span>02</span> Why now</p>
              <h2>More marketing capacity has created <em>more coordination.</em></h2>
              <p class="lede">There are more channels, more signals, and more ways to produce work. The advantage now is not another tool. It is a managed operation that knows the business and keeps the work moving.</p>
            </div>
            <div class="pressure-stack" aria-label="Three sources of pressure">
              <article><b>01</b><div><h3>More places to show up</h3><p>Website, search, social, email, content, and advertising all need attention.</p></div></article>
              <article><b>02</b><div><h3>More context to carry</h3><p>Every brief depends on offers, audiences, brand choices, approvals, and current results.</p></div></article>
              <article class="accent-card"><b>03</b><div><h3>More work between interest and revenue</h3><p>Leads still need ownership, follow-up, booking, CRM movement, and conversion support.</p></div></article>
            </div>
          </div>
        </section>

        <section class="slide" id="fragmented" data-slide="2" aria-label="Slide 3 of 10: The current state">
          <div class="copy-block compact-copy">
            <p class="eyebrow"><span>03</span> The current state</p>
            <h2>The work exists. <em>The operating system does not.</em></h2>
            <p class="lede">Each part can be useful on its own. The cost appears in the gaps between them.</p>
          </div>
          <div class="fragment-map" aria-label="A fragmented marketing process centered on the owner">
            <article><span>Knowledge</span><strong>In your head</strong><small>Offers, customers, priorities</small></article>
            <article><span>Tools</span><strong>Separate tabs</strong><small>Data without shared context</small></article>
            <article class="owner-node"><span>The owner</span><strong>Translates everything</strong><small>Briefs, checks, chases, reconnects</small></article>
            <article><span>Production</span><strong>Separate handoffs</strong><small>Pages, posts, campaigns</small></article>
            <article><span>Pipeline</span><strong>Late follow-up</strong><small>Leads without a next action</small></article>
            <div class="break b1">gap</div><div class="break b2">gap</div><div class="break b3">gap</div><div class="break b4">gap</div>
          </div>
        </section>

        <section class="slide" id="one-operation" data-slide="3" aria-label="Slide 4 of 10: One managed marketing operation">
          <div class="copy-block centered-copy">
            <p class="eyebrow"><span>04</span> The future state</p>
            <h2>One managed marketing operation. <em>Not more software for you to manage.</em></h2>
            <p class="lede">Markethink learns the business, runs the work day to day, connects it to the pipeline, and improves the next round. Expert marketers direct the strategy and stay accountable. You keep control of the decisions that matter.</p>
          </div>
          <div class="managed-flow" aria-label="How one managed marketing operation works">
            <article><span>01</span><strong>Business priority</strong><small>What needs to move</small></article><i></i>
            <article><span>02</span><strong>Connected work</strong><small>Across active channels</small></article><i></i>
            <article><span>03</span><strong>Expert review</strong><small>Quality and judgment</small></article><i></i>
            <article><span>04</span><strong>Your approval</strong><small>Control before action</small></article><i></i>
            <article><span>05</span><strong>Result and learning</strong><small>Stronger next round</small></article>
          </div>
          <div class="role-strip"><span><b>Markethink AI system</b> carries context and production</span><span><b>Expert marketers</b> direct and review</span><span><b>You</b> set priorities and approve key decisions</span></div>
        </section>

        <section class="slide map-slide" id="system-map" data-slide="4" aria-label="Slide 5 of 10: The complete Markethink system map">
          <div class="map-heading">
            <div><p class="eyebrow"><span>05</span> The bridge</p><h2>The whole system, <em>in one view.</em></h2></div>
            <p>Four connected layers, governed from the top and strengthened by every round.</p>
          </div>
          <div class="system-map" aria-label="Expert management and client control govern four connected layers over an existing tools foundation, with a learning loop back to business knowledge">
            <div class="governance"><strong>Expert management</strong><span>Strategy · review · accountability</span><i></i><strong>Client control</strong><span>Priorities · permissions · approvals</span></div>
            <div class="layers">
              <article class="layer l1"><b>01</b><div><strong>Business Knowledge</strong><span>Offers · customers · brand · goals · decisions</span></div></article>
              <article class="layer l2"><b>02</b><div><strong>Data & Connections</strong><span>Tools · signals · meetings · files · performance</span></div></article>
              <article class="layer l3"><b>03</b><div><strong>Marketing Operations</strong><span>Strategy · campaigns · creative · publishing</span></div></article>
              <article class="layer l4"><b>04</b><div><strong>Growth & Pipeline</strong><span>Leads · CRM · follow-up · booking · conversion</span></div></article>
            </div>
            <div class="foundation"><strong>Your existing tools and accounts</strong><span>Social & community</span><span>Email & workspace</span><span>Meetings & conversations</span><span>Search & performance</span><span>Websites & content</span><span>CRM & business operations</span></div>
            <div class="learning-loop"><span>Results</span><span>Approvals</span><span>Corrections</span><b>return to Business Knowledge</b></div>
          </div>
        </section>

        <section class="slide layer-slide" id="business-knowledge" data-slide="5" aria-label="Slide 6 of 10: Business Knowledge">
          <div class="layer-number">01</div>
          <div class="slide-grid layer-grid">
            <div class="copy-block">
              <p class="eyebrow"><span>06</span> Layer 01 · Business Knowledge</p>
              <h2>The operation starts by <em>learning your business.</em></h2>
              <p class="lede">Your voice, offers, customers, priorities, goals, references, past decisions, and approval preferences become working context for the next assignment.</p>
              <p class="proof-note"><span></span> Current capability: business memory, brand hub, reference library, shared chat, and approval context.</p>
            </div>
            <div class="knowledge-board" aria-label="Business knowledge that Markethink carries forward">
              <article class="wide"><span>What the business knows</span><strong>Offers · audiences · goals · differentiators</strong></article>
              <article><span>How the brand speaks</span><strong>Voice · visuals · references</strong></article>
              <article><span>How decisions get made</span><strong>Approvals · limits · preferences</strong></article>
              <article class="learning-card"><span>What carries forward</span><strong>Corrections · approved patterns · results</strong><small>Less re-explaining. A stronger starting point.</small></article>
            </div>
          </div>
        </section>

        <section class="slide layer-slide" id="data-connections" data-slide="6" aria-label="Slide 7 of 10: Data and Connections">
          <div class="layer-number">02</div>
          <div class="connection-layout">
            <div class="copy-block connection-copy">
              <p class="eyebrow"><span>07</span> Layer 02 · Data & Connections</p>
              <h2>Work from current signals, <em>not isolated briefs.</em></h2>
              <p class="lede">Markethink can work through approved tools and current business signals, so marketing decisions begin closer to what is actually happening.</p>
              <p class="permission-note">Access and actions depend on scope, connection method, account activation, and the permissions you approve.</p>
            </div>
            <div class="connection-grid" aria-label="Connection categories">
              <article><i class="dot-icon"></i><strong>Social & community</strong><span>Publishing and channel activity</span></article>
              <article><i class="mail-icon"></i><strong>Email & workspace</strong><span>Calendars, documents, campaigns, tasks</span></article>
              <article><i class="talk-icon"></i><strong>Meetings & conversations</strong><span>Transcripts, decisions, customer context</span></article>
              <article><i class="search-icon"></i><strong>Search & performance</strong><span>Ads, analytics, SEO, AI-search signals</span></article>
              <article><i class="page-icon"></i><strong>Websites & content</strong><span>Pages, content systems, publishing rails</span></article>
              <article><i class="stack-icon"></i><strong>CRM & business operations</strong><span>Contacts, deals, tasks, approved workflows</span></article>
            </div>
          </div>
        </section>

        <section class="slide layer-slide" id="marketing-operations" data-slide="7" aria-label="Slide 8 of 10: Marketing Operations">
          <div class="layer-number">03</div>
          <div class="ops-layout">
            <div class="copy-block ops-copy">
              <p class="eyebrow"><span>08</span> Layer 03 · Marketing Operations</p>
              <h2>The daily work moves through <em>one operating rhythm.</em></h2>
              <p class="lede">Strategy stays connected to production, review, approval, publishing, and the next priority.</p>
            </div>
            <div class="ops-board" aria-label="Marketing operations capability groups">
              <article><span>Plan</span><strong>Strategy · campaign briefs · calendars · audience logic</strong></article>
              <article><span>Create</span><strong>Websites · landing pages · design · copy · editorial</strong></article>
              <article><span>Activate</span><strong>Social publishing · email · ads · SEO · AIO</strong></article>
              <article><span>Coordinate</span><strong>Daily priorities · tasks · reviews · approvals · updates</strong></article>
              <div class="review-lane"><b>Expert review across the operation</b><span>Message</span><span>Quality</span><span>Next step</span><span>Accountability</span></div>
            </div>
          </div>
        </section>

        <section class="slide layer-slide" id="growth-pipeline" data-slide="8" aria-label="Slide 9 of 10: Growth and Pipeline">
          <div class="layer-number">04</div>
          <div class="pipeline-layout">
            <div class="copy-block pipeline-copy">
              <p class="eyebrow"><span>09</span> Layer 04 · Growth & Pipeline</p>
              <h2>Marketing does not stop when <em>someone responds.</em></h2>
              <p class="lede">Interest becomes useful when the source, context, owner, stage, next action, and follow-up remain visible.</p>
              <p class="proof-note"><span></span> Current capabilities include lead research, enrichment, buying signals, CRM, outreach, customer conversations, booking, reporting, and configured billing workflows.</p>
            </div>
            <div class="pipeline-flow" aria-label="From signal to conversion support">
              <article><b>Find</b><span>Lead research · enrichment · buying signals</span></article><i></i>
              <article><b>Capture</b><span>Inbound inquiries · outreach · conversations</span></article><i></i>
              <article><b>Own</b><span>CRM stage · owner · notes · next action</span></article><i></i>
              <article><b>Move</b><span>Follow-up · booking · approved payment flows</span></article><i></i>
              <article class="result"><b>Learn</b><span>Reporting · outcomes · conversion support</span></article>
            </div>
            <div class="loop-back"><span>What happens here strengthens the next campaign, brief, and decision.</span><b>↖ Back to Business Knowledge</b></div>
          </div>
        </section>

        <section class="slide closing-slide" id="walkthrough" data-slide="9" aria-label="Slide 10 of 10: Schedule a walkthrough">
          <div class="closing-layout">
            <div class="copy-block">
              <p class="eyebrow"><span>10</span> Next step</p>
              <h2>Bring the part of marketing that <em>needs to move.</em></h2>
              <p class="lede">Share your website and one priority. We will map how business knowledge, current tools, daily marketing, and pipeline should connect around it.</p>
              <a class="primary-cta" href="/schedule-a-walkthrough/?source=private-marketing-operation-deck">Schedule a walkthrough <span>↗</span></a>
              <p class="cta-note">No platform migration required to begin. Scope, access, and approval rules are agreed first.</p>
            </div>
            <div class="walkthrough-card">
              <p>What the walkthrough gives you</p>
              <ol><li><span>01</span><div><strong>A clear starting priority</strong><small>The work that is slowing growth now</small></div></li><li><span>02</span><div><strong>A connected operating map</strong><small>What Markethink manages and what stays in your control</small></div></li><li><span>03</span><div><strong>A scoped next step</strong><small>Channels, permissions, review rhythm, and responsibilities</small></div></li></ol>
              <div class="verified-row"><span>Expert managed</span><span>Client controlled</span><span>Scope first</span><span>Learning built in</span></div>
              <a href="/features/">Review current capabilities ↗</a>
            </div>
          </div>
        </section>
      </div>

      <nav class="deck-nav" aria-label="Presentation controls">
        <button class="nav-arrow" type="button" data-prev aria-label="Previous slide">←</button>
        <div class="nav-center">
          <div class="counter"><span data-current>01</span><i></i><span>10</span></div>
          <div class="dots" role="tablist" aria-label="Go to slide">
            {slides.map((slide, index) => <button type="button" role="tab" aria-label={`Go to slide ${index + 1}: ${slide.label}`} aria-selected={index === 0 ? "true" : "false"} class={index === 0 ? "active" : ""} data-dot={index}><span></span></button>)}
          </div>
          <div class="current-label" data-label>{slides[0].label}</div>
        </div>
        <button class="nav-arrow" type="button" data-next aria-label="Next slide">→</button>
      </nav>
      <div class="key-hint" aria-hidden="true">Scroll, swipe, or use arrow keys</div>
    </div>
  </main>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-deck]');
    if (!root) return;
    const slides = [...root.querySelectorAll('[data-slide]')];
    const dots = [...root.querySelectorAll('[data-dot]')];
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    const current = root.querySelector('[data-current]');
    const label = root.querySelector('[data-label]');
    const labels = ["The owner tax", "Why now", "Fragmented", "One operation", "System map", "Business knowledge", "Data and connections", "Marketing operations", "Growth and pipeline", "Walkthrough"];
    let index = 0;
    let wheelLocked = false;
    let touchStartX = 0;
    let touchStartY = 0;

    const update = (nextIndex, pushHash = true) => {
      const target = Math.max(0, Math.min(slides.length - 1, nextIndex));
      if (target === index && slides[index].classList.contains('is-active')) return;
      slides.forEach((slide, i) => {
        const active = i === target;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        slide.inert = !active;
      });
      dots.forEach((dot, i) => {
        const active = i === target;
        dot.classList.toggle('active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
        dot.tabIndex = active ? 0 : -1;
      });
      index = target;
      current.textContent = String(index + 1).padStart(2, '0');
      label.textContent = labels[index];
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
      if (pushHash) history.replaceState(null, '', `#${slides[index].id}`);
    };

    const hashIndex = slides.findIndex((slide) => slide.id === location.hash.slice(1));
    index = hashIndex >= 0 ? hashIndex : 0;
    slides.forEach((slide, i) => { slide.setAttribute('aria-hidden', i === index ? 'false' : 'true'); slide.inert = i !== index; });
    update(index, false);
    prev.disabled = index === 0;
    next.disabled = index === slides.length - 1;

    prev.addEventListener('click', () => update(index - 1));
    next.addEventListener('click', () => update(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => update(i)));

    window.addEventListener('keydown', (event) => {
      if (['ArrowRight', 'PageDown', ' '].includes(event.key)) { event.preventDefault(); update(index + 1); }
      if (['ArrowLeft', 'PageUp'].includes(event.key)) { event.preventDefault(); update(index - 1); }
      if (event.key === 'Home') { event.preventDefault(); update(0); }
      if (event.key === 'End') { event.preventDefault(); update(slides.length - 1); }
    });

    root.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaY) < 22 || wheelLocked) return;
      event.preventDefault();
      wheelLocked = true;
      update(index + (event.deltaY > 0 ? 1 : -1));
      window.setTimeout(() => { wheelLocked = false; }, 650);
    }, { passive: false });

    root.addEventListener('touchstart', (event) => { touchStartX = event.touches[0].clientX; touchStartY = event.touches[0].clientY; }, { passive: true });
    root.addEventListener('touchend', (event) => {
      const dx = event.changedTouches[0].clientX - touchStartX;
      const dy = event.changedTouches[0].clientY - touchStartY;
      if (Math.max(Math.abs(dx), Math.abs(dy)) < 48) return;
      if (Math.abs(dx) > Math.abs(dy)) update(index + (dx < 0 ? 1 : -1));
      else update(index + (dy < 0 ? 1 : -1));
    }, { passive: true });

    window.addEventListener('hashchange', () => {
      const target = slides.findIndex((slide) => slide.id === location.hash.slice(1));
      if (target >= 0) update(target, false);
    });
  })();
</script>

<style>
  :global(html), :global(body) { width: 100%; min-height: 100%; overflow: hidden; background: #090c0d; }
  :global(body) { margin: 0; }
  :global(*) { box-sizing: border-box; }
  .deck-page { min-height: 100svh; display: grid; place-items: center; padding: 12px; color: #f5f5f1; background: radial-gradient(circle at 12% 12%, rgba(105,210,84,.06), transparent 28%), #090c0d; font-family: Inter, Arial, sans-serif; }
  .deck-stage { container-type: size; position: relative; width: min(calc(100vw - 24px), calc((100svh - 24px) * 16 / 9)); height: min(calc(100svh - 24px), calc((100vw - 24px) * 9 / 16)); aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid rgba(245,245,241,.15); border-radius: clamp(18px, 2.4cqw, 34px); background: #0f1213; box-shadow: 0 32px 100px rgba(0,0,0,.5); isolation: isolate; }
  .deck-stage::before { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none; background-image: linear-gradient(rgba(245,245,241,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(245,245,241,.035) 1px, transparent 1px); background-size: 5cqw 5cqw; mask-image: linear-gradient(to bottom, black, transparent 78%); }
  .deck-stage::after { content: ""; position: absolute; width: 30cqw; aspect-ratio: 1; right: -10cqw; top: -12cqw; z-index: 0; background: rgba(105,210,84,.1); filter: blur(8cqw); border-radius: 50%; pointer-events: none; }
  .deck-header { position: absolute; z-index: 20; top: 3.1cqh; left: 3.8cqw; right: 3.8cqw; display: flex; align-items: center; justify-content: space-between; pointer-events: none; }
  .brand { pointer-events: auto; display: inline-flex; align-items: center; padding: .9cqh 1.05cqw; min-height: 4.4cqh; border: 1px solid rgba(245,245,241,.14); border-radius: 999px; background: rgba(15,18,19,.76); }
  .brand img { display: block; width: auto; height: 1.6cqh; min-height: 10px; max-height: 18px; filter: brightness(0) invert(1); }
  .private-label { display: flex; align-items: center; gap: .65cqw; font-size: clamp(8px, .72cqw, 12px); letter-spacing: .17em; text-transform: uppercase; color: #b4b6b6; }
  .private-label span { width: .52cqw; min-width: 5px; aspect-ratio: 1; border-radius: 50%; background: #69d254; box-shadow: 0 0 0 .28cqw rgba(105,210,84,.12); }
  .slides { position: absolute; inset: 0; z-index: 2; }
  .slide { position: absolute; inset: 0; padding: 11.5cqh 5cqw 12.2cqh; opacity: 0; visibility: hidden; transform: translateX(2.5cqw); transition: opacity .45s ease, transform .55s cubic-bezier(.22,1,.36,1), visibility .45s; overflow: hidden; }
  .slide::after { content: ""; position: absolute; width: 24cqw; height: 24cqw; left: 49%; bottom: -18cqw; border: 1px solid rgba(105,210,84,.11); border-radius: 50%; box-shadow: 0 0 0 3.5cqw rgba(105,210,84,.02), 0 0 0 7cqw rgba(105,210,84,.015); pointer-events: none; }
  .slide.is-active { opacity: 1; visibility: visible; transform: translateX(0); z-index: 2; }
  .slide-grid { height: 100%; display: grid; align-items: center; gap: 4cqw; }
  .hero-grid { grid-template-columns: 1.02fr .78fr; }
  .split-grid { grid-template-columns: .86fr 1fr; }
  .copy-block { position: relative; z-index: 2; }
  .eyebrow { margin: 0 0 1.6cqh; display: flex; align-items: center; gap: .7cqw; font-size: clamp(8px, .75cqw, 12px); letter-spacing: .15em; text-transform: uppercase; color: #b4b6b6; }
  .eyebrow span { display: grid; place-items: center; width: 2.1cqw; min-width: 24px; aspect-ratio: 1; border: 1px solid rgba(105,210,84,.42); border-radius: 50%; color: #69d254; letter-spacing: 0; font-weight: 700; }
  h1, h2 { margin: 0; font-family: "Instrument Serif", Georgia, serif; font-weight: 400; line-height: .96; letter-spacing: -.032em; color: #f5f5f1; text-wrap: balance; }
  h1 { max-width: 13ch; font-size: clamp(32px, 4.65cqw, 72px); }
  h2 { max-width: 14ch; font-size: clamp(30px, 4.15cqw, 65px); }
  h1 em, h2 em { color: #b9e9ae; font-style: italic; }
  .lede { max-width: 58ch; margin: 2cqh 0 0; font-size: clamp(10px, 1.13cqw, 18px); line-height: 1.48; color: #b4b6b6; text-wrap: pretty; }
  .owner-line, .proof-note, .permission-note { margin-top: 2.2cqh; display: flex; align-items: center; gap: .7cqw; max-width: 58ch; font-size: clamp(9px, .84cqw, 14px); line-height: 1.4; color: #edf4ea; }
