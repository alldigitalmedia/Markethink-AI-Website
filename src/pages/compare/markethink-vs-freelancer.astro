  .article-hero-copy { max-width: 58rem; }
  .article-hero h1 { font-family: "Instrument Serif", Georgia, serif; font-size: clamp(3rem, 5vw, 5rem); line-height: 1.02; letter-spacing: -.04em; text-wrap: balance; }
  .article-meta { margin-top: 1.3rem; color: #B4B6B6; font-size: .85rem; }
  .article-excerpt { max-width: 48rem; margin-top: 1.5rem; color: #F5F5F1; font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.65; }
  .article-layout { display: grid; grid-template-columns: minmax(13rem, 15rem) minmax(0, 44rem); gap: clamp(2.4rem, 5vw, 5rem); justify-content: center; padding-top: clamp(2.8rem, 5vw, 4.8rem); padding-bottom: 10rem; }
  .article-sidebar { position: sticky; top: 6.5rem; }
  .sidebar-panel { padding: 1.15rem; border: 1px solid rgba(15,18,19,.14); border-radius: 1rem; background: #EDF4EA; }
  .sidebar-label { margin-bottom: .9rem; font-size: .75rem; font-weight: 700; }
  .sidebar-panel ol { display: grid; gap: .75rem; padding-left: 1rem; }
  .sidebar-panel a { color: #0F1213; font-size: .8rem; line-height: 1.45; }
  .article-content { max-width: 44rem; min-width: 0; }
  .article-content :global(p), .article-content :global(li) { color: #0F1213; font-size: 1rem; line-height: 1.78; }
  .article-content :global(p + p) { margin-top: 1.1rem; }
  .article-content :global(h2) { margin: clamp(2.8rem, 5vw, 4.1rem) 0 1.15rem; font-family: "Instrument Serif", Georgia, serif; font-size: clamp(2.25rem, 4.3vw, 3.4rem); line-height: 1.05; letter-spacing: -.04em; text-wrap: balance; scroll-margin-top: 6rem; }
  .article-content :global(h2:first-child) { margin-top: 0; }
  .article-content :global(a) { color: #0F1213; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .article-content :global(a:hover) { text-decoration-thickness: 2px; }
  .article-content :global(ul), .article-content :global(ol) { display: grid; gap: .8rem; margin: 1.3rem 0; padding: 1.5rem 1.5rem 1.5rem 2.4rem; border: 1px solid rgba(15,18,19,.14); border-radius: 1rem; background: #EDF4EA; }
  .article-content :global(hr) { margin: 2rem 0; border: 0; border-top: 1px solid rgba(15,18,19,.14); }
  .article-content :global(.table-scroll) { max-width: 100%; overflow-x: auto; margin: 1.5rem 0; border: 1px solid rgba(15,18,19,.14); border-radius: 1rem; }
  .article-content :global(table) { width: 100%; border-collapse: collapse; font-size: .88rem; line-height: 1.6; }
  .article-content :global(th), .article-content :global(td) { min-width: 9rem; padding: .9rem; border-bottom: 1px solid rgba(15,18,19,.14); vertical-align: top; text-align: left; }
  .article-content :global(th) { background: #EDF4EA; font-weight: 700; }
  .article-content :global(tr:last-child td) { border-bottom: 0; }
  .article-content :global(details) { padding: 1.3rem 0; border-top: 1px solid rgba(15,18,19,.14); }
  .article-content :global(summary) { cursor: pointer; font-weight: 600; }
  .article-content :global(details p) { margin-top: .8rem; }
  .article-page :global(a:focus-visible), .article-content :global(summary:focus-visible), .article-content :global(.table-scroll:focus-visible) { outline: 2px solid #0F1213; outline-offset: 4px; }
  @media (max-width: 991px) { .article-layout { grid-template-columns: minmax(0, 1fr); } .article-sidebar { position: static; order: 2; } .article-content { max-width: 46rem; } }
  @media (max-width: 767px) { .article-hero { padding: 7.3rem 0 2.5rem; } .article-layout { gap: 2.4rem; padding-top: 2.6rem; } .article-hero h1 { font-size: clamp(2.5rem, 11vw, 3.45rem); } }
</style>
