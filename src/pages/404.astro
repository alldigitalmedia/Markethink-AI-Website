---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Page not found | Markethink"
  description="The page you requested could not be found. Continue to Markethink's website, insights, strategies, or walkthrough."
  canonical="https://markethink.ai/404/"
  noindex={true}
>
  <main class="not-found-page">
    <Navbar />
    <section class="not-found-hero" aria-labelledby="not-found-title">
      <div class="not-found-grid" aria-hidden="true"></div>
      <div class="not-found-content">
        <p class="eyebrow">404 · Page not found</p>
        <h1 id="not-found-title">This path ends here.<br /><em>Your marketing doesn’t.</em></h1>
        <p class="not-found-copy">The page may have moved or the address may be incomplete. Choose a useful next step below.</p>
        <nav class="not-found-actions" aria-label="Page not found navigation">
          <a class="primary-action" href="/">Go to home</a>
          <a href="/blog/">Insights</a>
          <a href="/ai-marketing-strategies/">Strategies</a>
          <a href="/schedule-a-walkthrough/">Request walkthrough times</a>
        </nav>
      </div>
      <aside class="not-found-system" aria-label="Markethink marketing operation">
        <span>MARKETING OPERATION</span>
        <strong>Website</strong>
        <strong>Campaigns</strong>
        <strong>Pipeline</strong>
        <p><i></i> Powered by AI. Managed by experts.</p>
      </aside>
    </section>
    <Footer />
  </main>
</Layout>

<style>
  :global(*){box-sizing:border-box}
  :global(html){background:#0F1213}
  :global(body){margin:0;background:#0F1213;color:#F5F5F1;font-family:Inter,system-ui,sans-serif}
  .not-found-page{min-height:100svh;overflow:hidden;background:#0F1213}
  .not-found-hero{position:relative;isolation:isolate;min-height:calc(100svh - 40px);padding:clamp(150px,18vh,210px) clamp(20px,7vw,108px) clamp(120px,16vh,190px);display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.55fr);gap:clamp(48px,8vw,120px);align-items:center;background:radial-gradient(circle at 80% 26%,rgba(105,210,84,.15),transparent 27%),linear-gradient(145deg,#07100b 0%,#0F1213 52%,#151918 100%)}
  .not-found-grid{position:absolute;z-index:-1;inset:0;background-image:linear-gradient(rgba(105,210,84,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(105,210,84,.055) 1px,transparent 1px);background-size:72px 72px;mask-image:linear-gradient(135deg,#000,transparent 72%)}
  .not-found-content{max-width:820px}
  .eyebrow{margin:0 0 24px;color:#69D254;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
  h1{max-width:900px;margin:0;font:400 clamp(58px,7vw,112px)/.88 "Instrument Serif",Georgia,serif;letter-spacing:-.055em;text-wrap:balance}
  h1 em{color:#69D254;font-weight:400}
  .not-found-copy{max-width:650px;margin:28px 0 34px;color:#B4B6B6;font-size:clamp(16px,1.35vw,20px);line-height:1.6}
  .not-found-actions{display:flex;flex-wrap:wrap;gap:12px}
  .not-found-actions a{min-height:48px;padding:14px 20px;border:1px solid rgba(245,245,241,.24);border-radius:999px;display:inline-flex;align-items:center;justify-content:center;color:#F5F5F1;text-decoration:none;font-size:13px;font-weight:600;transition:border-color .2s ease,background .2s ease,color .2s ease}
  .not-found-actions a:hover,.not-found-actions a:focus-visible{border-color:#69D254;outline:2px solid transparent;background:rgba(105,210,84,.1)}
  .not-found-actions .primary-action{border-color:#69D254;background:#69D254;color:#0F1213}
  .not-found-actions .primary-action:hover,.not-found-actions .primary-action:focus-visible{background:#8ade78}
  .not-found-system{position:relative;max-width:420px;justify-self:end;padding:32px;border:1px solid rgba(245,245,241,.14);border-radius:28px;background:rgba(15,18,19,.78);box-shadow:0 34px 90px rgba(0,0,0,.36);backdrop-filter:blur(18px)}
  .not-found-system>span{display:block;margin-bottom:24px;color:#69D254;font-size:9px;font-weight:700;letter-spacing:.16em}
  .not-found-system strong{display:block;padding:18px 0;border-top:1px solid rgba(245,245,241,.1);font:400 30px/1 "Instrument Serif",Georgia,serif}
  .not-found-system p{display:flex;align-items:center;gap:9px;margin:22px 0 0;color:#B4B6B6;font-size:11px;line-height:1.4}
  .not-found-system i{width:8px;height:8px;border-radius:50%;background:#69D254;box-shadow:0 0 0 6px rgba(105,210,84,.1)}
  @media(max-width:900px){.not-found-hero{grid-template-columns:1fr;align-content:center}.not-found-system{width:100%;max-width:none;justify-self:stretch;display:grid;grid-template-columns:repeat(3,1fr);gap:0 18px}.not-found-system>span,.not-found-system p{grid-column:1/-1}.not-found-system strong{font-size:25px}}
  @media(max-width:520px){.not-found-hero{padding:126px 14px 110px;gap:42px}h1{font-size:52px}.not-found-copy{font-size:15px;margin:22px 0 28px}.not-found-actions{display:grid}.not-found-actions a{width:100%;min-height:52px}.not-found-system{padding:24px;grid-template-columns:1fr}.not-found-system>span,.not-found-system p{grid-column:auto}.not-found-system strong{padding:14px 0;font-size:24px}}
  @media(prefers-reduced-motion:reduce){.not-found-actions a{transition:none}}
</style>
