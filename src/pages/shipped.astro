256|<script>
257|  function initWorkFilters() {
258|    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
259|    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-categories]"));
260|    const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
261|
262|    const applyFilter = (filter: string) => {
263|      let visibleCount = 0;
264|      cards.forEach((card) => {
265|        const categories = (card.dataset.categories || "").split(" ");
266|        const show = filter === "all" || categories.includes(filter);
267|        card.hidden = !show;
268|        card.classList.toggle("is-filtered-in", show);
269|        if (show) visibleCount += 1;
270|      });
271|      if (emptyState) emptyState.hidden = visibleCount > 0;
272|      buttons.forEach((button) => {
273|        const active = button.dataset.filter === filter;
274|        button.classList.toggle("is-active", active);
275|        button.setAttribute("aria-pressed", String(active));
276|      });
277|    };
278|
279|    buttons.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.filter || "all")));
280|    applyFilter("all");
281|  }
282|
283|  function initWorkReveals() {
284|    const cards = Array.from(document.querySelectorAll<HTMLElement>(".work-card"));
285|    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
286|      cards.forEach((card) => card.classList.add("is-revealed"));
287|      return;
288|    }
289|    const observer = new IntersectionObserver((entries) => {
290|      entries.forEach((entry) => {
291|        if (!entry.isIntersecting) return;
292|        const card = entry.target as HTMLElement;
293|        card.classList.add("is-revealed");
294|        observer.unobserve(card);
295|      });
296|    }, { threshold: 0.12 });
297|    cards.forEach((card) => observer.observe(card));
298|  }
299|
300|  document.addEventListener("DOMContentLoaded", () => {
301|    initWorkFilters();
302|    initWorkReveals();
303|  });
304|  if (document.readyState !== "loading") {
305|    initWorkFilters();
306|    initWorkReveals();
307|  }
308|</script>
