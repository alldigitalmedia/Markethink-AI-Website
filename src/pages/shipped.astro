---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "What Our Clients Shipped | Markethink";
const pageDescription = "See the websites, campaigns, content, advertising, and pipeline work clients are shipping with Markethink, powered by AI and managed by expert marketers.";
const canonicalUrl = "https://markethink.ai/shipped/";
const walkthroughHref = "/schedule-a-walkthrough/";

const monthLabel = new Intl.DateTimeFormat("en", { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date());

const categories = [
  { id: "all", label: "All work" },
  { id: "web", label: "Web" },
  { id: "social", label: "Social media" },
  { id: "email", label: "Email marketing" },
];

const workItems = [
  {
    category: "web",
    client: "Green",
    work: "Web design, solution architecture, and contact flow",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/shipped/green-web.webp",
    alt: "Green technology services website displayed on a desktop monitor",
    href: "https://greencss.com",
    action: "Visit website",
    tone: "dark",
  },
  {
    category: "social",
    client: "Mango Media",
    work: "Social media creative and content direction",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/shipped/mango-social.webp",
    alt: "Mango Media social media creative displayed on a smartphone",
    href: "https://www.instagram.com/mangomediaca/",
    action: "View on Instagram",
    tone: "green",
  },
  {
    category: "web",
    client: "Selten Logistics",
    work: "Web design, inventory experience, and inquiry flow",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/shipped/selten-logistics-web.webp",
    alt: "Selten Logistics equipment marketplace displayed on a laptop",
    href: "https://www.seltenlogistics.com",
    action: "Visit website",
    tone: "wash",
  },
  {
    category: "web",
    client: "+SELTEN Ai",
    work: "Web design, product positioning, and bilingual experience",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/shipped/selten-ai-web.webp",
    alt: "+SELTEN Ai website displayed on a desktop monitor",
    href: "https://selten.ai/es",
    action: "Visit website",
    tone: "dark",
  },
  {
    category: "social",
    client: "Pambuddha Homes",
    work: "Social media creative and editorial content direction",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/pambuddha-homes-social-v2.webp",
    alt: "Pambuddha Homes flooring content displayed as an Instagram post",
    href: "https://www.instagram.com/pambuddhahomes/",
    action: "View on Instagram",
    tone: "warm",
  },
  {
    category: "social",
    client: "Villazzo",
    work: "Social media creative and destination content",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/shipped/villazzo-social.webp",
    alt: "Villazzo luxury villa destination post displayed on a smartphone",
    href: "https://www.instagram.com/villazzo/",
    action: "View on Instagram",
    tone: "green",
  },
  {
    category: "email",
    client: "Villazzo",
    work: "Email marketing creative and editorial newsletter design",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/villazzo-mail-approved-v2.webp",
    alt: "The Villazzo Edit email newsletter displayed on a tablet",
    href: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/villazzo-mail-approved-v2.webp",
    action: "View email",
    tone: "warm",
    fit: "contain",
  },
  {
    category: "web",
    client: "Emma Sacks Interiors",
    work: "Website redesign for an interiors practice shaped by form, function, and luxury",
    image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/emma-sacks-website-redesign.webp",
    alt: "Emma Sacks Interiors website redesign displayed on a laptop",
    action: "Website redesign in progress",
    tone: "warm",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "What Our Clients Shipped",
    description: pageDescription,
    url: canonicalUrl,
    inLanguage: "en",
    publisher: { "@id": "https://markethink.ai/#organization" },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: workItems.length,
      itemListElement: workItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.client,
        description: item.work,
        url: item.href,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://markethink.ai/" },
      { "@type": "ListItem", position: 2, name: "What Our Clients Shipped", item: canonicalUrl },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} image="/images/markethink-ship-real-website-mockup.svg" structuredData={structuredData}>
  <Navbar />
  <main class="shipped-page">
    <section class="shipped-hero" id="top">
      <div class="container hero-shell">
        <div class="hero-copy animate-fade-up">
          <p class="hero-kicker"><span></span> NOW SHIPPING · {monthLabel.toUpperCase()}</p>
          <h1>See what our clients are <em>shipping.</em></h1>
          <p class="hero-intro">A living view of the websites, campaigns, content, advertising, and pipeline work moving through Markethink.</p>
          <p class="privacy-note">Real client work, shared for public viewing. Select any project to visit the live website or Instagram profile.</p>
          <div class="hero-actions">
            <a href="#latest-work" class="button">See the latest work</a>
            <a href={walkthroughHref} class="text-link">Book a walkthrough <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="hero-feature animate-scale-in" aria-label="Selected work moving through Markethink">
          <img src="/images/markethink-ship-real-website-mockup.svg" alt="Selected website and campaign work prepared through Markethink" width="1200" height="800" />
          <div class="hero-feature-shade"></div>
          <div class="hero-feature-copy">
            <div>
              <p>Selected work</p>
              <h2>From request to shipped</h2>
            </div>
            <span aria-hidden="true">↗</span>
          </div>
        </div>
      </div>

      <div class="container operating-strip" aria-label="Connected marketing operation">
        <span>Request</span><i></i><span>Strategy</span><i></i><span>Creative</span><i></i><span>Approval</span><i></i><span>Pipeline</span>
      </div>
    </section>

    <section class="work-section" id="latest-work">
      <div class="container work-intro">
        <div>
          <p class="subtitle">REAL CLIENT WORK</p>
          <h2>Live projects. Built for real businesses.</h2>
        </div>
        <p>Selected work across websites, social media, and email. Linked cards open the live destination or finished creative.</p>
      </div>

      <div class="filter-shell" data-filter-shell>
        <div class="container filters" role="group" aria-label="Filter client work">
          {categories.map((category, index) => (
            <button type="button" class:list={["filter-button", index === 0 && "is-active"]} data-filter={category.id} aria-pressed={index === 0 ? "true" : "false"}>
              {category.label}
            </button>
          ))}
        </div>
      </div>

      <div class="work-grid" data-work-grid>
        {workItems.map((item, index) => (
          <a class:list={["work-card", `tone-${item.tone}`, !item.href && "is-static"]} href={item.href} target={item.href ? "_blank" : undefined} rel={item.href ? "noopener noreferrer" : undefined} data-categories={item.category} style={`--card-index:${index}`} aria-label={item.href ? `${item.action}: ${item.client}` : `${item.client}: ${item.action}`}>
            <div
              class:list={["card-media", item.fit === "contain" && "fit-contain"]}
              style={item.fit === "contain" ? `--card-image: url("${item.image}")` : undefined}
            >
              <img
                src={item.image}
                alt={item.alt}
                width={item.fit === "contain" ? "1024" : "1200"}
                height={item.fit === "contain" ? "1536" : "800"}
                loading={index < 2 ? "eager" : "lazy"}
              />
              <div class="card-wash"></div>
              <span class="anonymized-label">{item.action}{item.href ? " ↗" : ""}</span>
            </div>
            <div class="card-copy">
              <h3>{item.client}</h3>
              <p>{item.work}</p>
            </div>
          </a>
        ))}
      </div>

      <p class="empty-state" data-empty-state hidden>No public work is available in this category yet.</p>
    </section>

    <section class="system-section">
      <div class="container system-grid">
        <div class="system-copy animate-fade-up">
          <p class="subtitle">THE WORK AROUND THE WORK</p>
          <h2>One request can become a complete marketing motion.</h2>
          <p>Markethink does not stop at the asset. The system carries business context into the campaign, keeps review moving, connects the response to the pipeline, and remembers what should improve next.</p>
          <a href={walkthroughHref} class="text-link dark-link">See how the operation works <span aria-hidden="true">↗</span></a>
        </div>
        <div class="motion-map animate-stagger" aria-label="Markethink operating sequence">
          <article><span>01</span><div><strong>Request</strong><p>The business need, offer, audience, and priority.</p></div></article>
          <article><span>02</span><div><strong>Ship</strong><p>Campaigns, web, content, advertising, and lead work.</p></div></article>
          <article><span>03</span><div><strong>Approve</strong><p>A real marketing team directs, reviews, and stays accountable.</p></div></article>
          <article><span>04</span><div><strong>Convert</strong><p>Lead capture, CRM context, follow-up, and the next action.</p></div></article>
          <article><span>05</span><div><strong>Learn</strong><p>Every approval, correction, and result sharpens what comes next.</p></div></article>
        </div>
      </div>
    </section>

    <section class="closing-section">
      <div class="container closing-panel animate-scale-in">
        <p class="subtitle">YOUR NEXT MONTH</p>
        <h2>What could your business ship next?</h2>
        <p>Show us where marketing is getting stuck. We will map the first useful move and how it connects to the rest of the operation.</p>
        <a href={walkthroughHref} class="button">Book a Markethink walkthrough</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initWorkFilters() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-categories]"));
    const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");

    const applyFilter = (filter: string) => {
      let visibleCount = 0;
      cards.forEach((card) => {
        const categories = (card.dataset.categories || "").split(" ");
        const show = filter === "all" || categories.includes(filter);
        card.hidden = !show;
        card.classList.toggle("is-filtered-in", show);
        if (show) visibleCount += 1;
      });
      if (emptyState) emptyState.hidden = visibleCount > 0;
      buttons.forEach((button) => {
        const active = button.dataset.filter === filter;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    };

    buttons.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.filter || "all")));
    applyFilter("all");
  }

  function initWorkReveals() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".work-card"));
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      cards.forEach((card) => card.classList.add("is-revealed"));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const card = entry.target as HTMLElement;
        card.classList.add("is-revealed");
        observer.unobserve(card);
      });
    }, { threshold: 0.12 });
    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener("DOMContentLoaded", () => {
    initWorkFilters();
    initWorkReveals();
  });
  if (document.readyState !== "loading") {
    initWorkFilters();
    initWorkReveals();
  }
</script>

<style>
  .shipped-page { background: #0f1213; color: #f5f5f1; overflow: clip; }

  .shipped-hero { position: relative; padding: 10rem 0 4rem; background: #0f1213; }
  .shipped-hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 72% 18%, rgba(105,210,84,.16), transparent 28rem), linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: auto, 72px 72px, 72px 72px; mask-image: linear-gradient(to bottom, #000 0%, transparent 92%); }
  .hero-shell { position: relative; display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(2rem, 5vw, 5.5rem); align-items: center; min-height: 70vh; }
  .hero-copy { max-width: 42rem; }
  .hero-kicker { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.25rem; color: rgba(245,245,241,.6); font-size: .72rem; font-weight: 750; letter-spacing: .12em; }
  .hero-kicker span { width: .52rem; height: .52rem; border-radius: 50%; background: #69d254; box-shadow: 0 0 0 .36rem rgba(105,210,84,.12); }
  .hero-copy h1 { font-size: clamp(4.5rem, 7.4vw, 8rem); line-height: .84; letter-spacing: -.062em; text-wrap: balance; }
  .hero-copy h1 em { color: #69d254; font-weight: 400; }
  .hero-intro { max-width: 38rem; margin-top: 1.6rem; color: rgba(245,245,241,.82); font-size: clamp(1.05rem,1.4vw,1.28rem); line-height: 1.65; }
  .privacy-note { max-width: 38rem; margin-top: .8rem; color: rgba(245,245,241,.48); font-size: .82rem; line-height: 1.6; }
  .hero-actions { display: flex; align-items: center; gap: 1.3rem; margin-top: 2rem; }
  .text-link { display: inline-flex; align-items: center; gap: .45rem; font-weight: 700; }
  .text-link span { color: #69d254; font-size: 1.15rem; transition: transform .2s ease; }
  .text-link:hover span { transform: translate(3px,-3px); }
  .hero-feature { position: relative; overflow: hidden; min-height: clamp(31rem,48vw,47rem); border-radius: 2rem; background: #171b1c; box-shadow: 0 34px 120px rgba(0,0,0,.34); }
  .hero-feature img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; transition: transform .8s cubic-bezier(.22,1,.36,1); }
  .hero-feature:hover img { transform: scale(1.025); }
  .hero-feature-shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 42%, rgba(15,18,19,.9) 100%); }
  .hero-feature-copy { position: absolute; inset: auto 0 0; display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding: clamp(1.4rem,3vw,2.5rem); }
  .hero-feature-copy p { color: rgba(245,245,241,.62); font-size: .7rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .hero-feature-copy h2 { margin-top: .35rem; font-size: clamp(2rem,3vw,3.5rem); line-height: 1; }
  .hero-feature-copy > span { display: grid; place-items: center; width: 3rem; height: 3rem; flex: 0 0 auto; border-radius: 50%; background: #69d254; color: #0f1213; font-size: 1.2rem; }
  .operating-strip { position: relative; display: grid; grid-template-columns: auto 1fr auto 1fr auto 1fr auto 1fr auto; align-items: center; gap: .9rem; margin-top: 3.5rem; padding: 1rem 1.2rem; border: 1px solid rgba(255,255,255,.1); border-radius: 999px; background: rgba(255,255,255,.035); color: rgba(245,245,241,.58); font-size: .74rem; letter-spacing: .06em; text-transform: uppercase; }
  .operating-strip i { height: 1px; background: linear-gradient(90deg, rgba(105,210,84,.15), #69d254, rgba(105,210,84,.15)); }

  .work-section { background: #f5f5f1; color: #0f1213; padding: clamp(6rem,10vw,10rem) 0 0; }
  .work-intro { display: grid; grid-template-columns: 1.1fr .65fr; gap: clamp(2rem,6vw,6rem); align-items: end; margin-bottom: 3rem; }
  .work-intro .subtitle, .system-section .subtitle, .closing-panel .subtitle { color: rgba(15,18,19,.48); }
  .work-intro h2, .system-copy h2, .closing-panel h2 { max-width: 48rem; margin-top: .8rem; font-size: clamp(3.6rem,6.5vw,7rem); line-height: .9; letter-spacing: -.055em; text-wrap: balance; }
  .work-intro > p { max-width: 34rem; color: rgba(15,18,19,.65); line-height: 1.7; }
  .filter-shell { position: sticky; top: 0; z-index: 40; padding: .75rem 0; border-block: 1px solid rgba(15,18,19,.09); background: rgba(245,245,241,.9); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
  .filters { display: flex; gap: .55rem; overflow-x: auto; scrollbar-width: none; }
  .filters::-webkit-scrollbar { display: none; }
  .filter-button { flex: 0 0 auto; padding: .72rem 1rem; border: 1px solid rgba(15,18,19,.12); border-radius: 999px; background: transparent; color: rgba(15,18,19,.64); font: 700 .78rem/1 var(--font-body); cursor: pointer; transition: background .2s ease, color .2s ease, border-color .2s ease; }
  .filter-button:hover, .filter-button.is-active { border-color: #0f1213; background: #0f1213; color: #f5f5f1; }
  .work-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(1rem,2vw,2rem); padding: 0 clamp(1rem,3vw,3rem) clamp(4rem,8vw,8rem); background: #f5f5f1; }
  .work-card { position: relative; display: block; min-height: 0; overflow: visible; background: transparent; color: #0f1213; opacity: 0; filter: blur(18px); transform: translateY(44px) scale(.98); transition: opacity .9s cubic-bezier(.22,1,.36,1), filter 1s cubic-bezier(.22,1,.36,1), transform 1s cubic-bezier(.22,1,.36,1); transition-delay: calc((var(--card-index) % 2) * 90ms); }
  .work-card.is-revealed { opacity: 1; filter: blur(0); transform: none; }
  .work-card[hidden] { display: none; }
  .card-media { position: relative; inset: auto; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 1.25rem; background: #171b1c; isolation: isolate; }
  .card-media img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; transition: transform .75s cubic-bezier(.22,1,.36,1), filter .5s ease; }
  .card-media.fit-contain::before { content: ""; position: absolute; z-index: 0; inset: -7%; background-image: var(--card-image); background-position: center; background-size: cover; filter: blur(30px) saturate(.8) brightness(.8); transform: scale(1.09); }
  .card-media.fit-contain::after { content: ""; position: absolute; z-index: 0; inset: 0; background: linear-gradient(90deg, rgba(15,18,19,.18), transparent 28%, transparent 72%, rgba(15,18,19,.18)); pointer-events: none; }
  .card-media.fit-contain img { object-fit: contain; padding: clamp(.6rem,1.2vw,1.1rem) 0; }
  .work-card:hover .card-media img, .work-card:focus-visible .card-media img { transform: scale(1.03); }
  .work-card:hover .card-media.fit-contain img, .work-card:focus-visible .card-media.fit-contain img { transform: scale(1.012); }
  .work-card:focus-visible { outline: 3px solid #69d254; outline-offset: -3px; }
  .card-wash { display: none; }
  .tone-green .card-wash { background: linear-gradient(180deg, rgba(105,210,84,.04), rgba(15,18,19,.95) 88%); }
  .tone-warm .card-wash { background: linear-gradient(180deg, rgba(245,245,241,.02), rgba(15,18,19,.93) 88%); }
  .tone-dark .card-wash { background: linear-gradient(180deg, rgba(15,18,19,.12), rgba(15,18,19,.97) 86%); }
  .tone-wash .card-wash { background: linear-gradient(180deg, rgba(237,244,234,.03), rgba(15,18,19,.94) 88%); }
  .anonymized-label { position: absolute; z-index: 3; top: 1.25rem; right: 1.25rem; padding: .48rem .68rem; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; background: rgba(15,18,19,.42); color: rgba(245,245,241,.76); font-size: .66rem; font-weight: 750; letter-spacing: .04em; backdrop-filter: blur(12px); }
  .card-copy { position: relative; inset: auto; z-index: 2; padding: 1rem .15rem 0; }
  .card-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: rgba(245,245,241,.58); font-size: .68rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .card-copy h3 { max-width: 46rem; margin: 0 0 .35rem; font-size: clamp(1.25rem,2vw,1.75rem); line-height: 1.08; letter-spacing: -.025em; text-wrap: balance; }
  .card-copy > p { max-width: 42rem; margin: 0; color: rgba(15,18,19,.58); font-size: clamp(.92rem,1.15vw,1.04rem); line-height: 1.45; }
  .deliverables { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
  .deliverables span { padding: .45rem .62rem; border-radius: 999px; background: rgba(245,245,241,.11); color: rgba(245,245,241,.82); font-size: .68rem; }
  .empty-state { padding: 5rem 1rem; text-align: center; color: rgba(15,18,19,.55); }

  .system-section { background: #edf4ea; color: #0f1213; padding: clamp(6rem,10vw,10rem) 0; }
  .system-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(3rem,8vw,8rem); align-items: start; }
  .system-copy > p:not(.subtitle) { max-width: 39rem; margin-top: 1.25rem; color: rgba(15,18,19,.65); line-height: 1.72; }
  .dark-link { margin-top: 1.5rem; }
  .motion-map { border-top: 1px solid rgba(15,18,19,.13); }
  .motion-map article { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1.45rem 0; border-bottom: 1px solid rgba(15,18,19,.13); }
  .motion-map article > span { color: #4aa63c; font-size: .72rem; font-weight: 850; letter-spacing: .08em; }
  .motion-map strong { font-family: "Instrument Serif", Georgia, serif; font-size: 2rem; font-weight: 400; }
  .motion-map p { margin-top: .25rem; color: rgba(15,18,19,.58); line-height: 1.55; }

  .closing-section { background: #f5f5f1; color: #0f1213; padding: 0 0 clamp(6rem,9vw,9rem); }
  .closing-panel { display: flex; flex-direction: column; align-items: center; text-align: center; padding: clamp(3rem,7vw,7rem); border-radius: 2.2rem; background: #0f1213; color: #f5f5f1; }
  .closing-panel .subtitle { color: #aee8a0; }
  .closing-panel h2 { max-width: 62rem; }
  .closing-panel > p:not(.subtitle) { max-width: 42rem; margin-top: 1.2rem; color: rgba(245,245,241,.67); font-size: 1.05rem; line-height: 1.7; }
  .closing-panel .button { margin-top: 1.8rem; }

  @media (max-width: 980px) {
    .hero-shell, .work-intro, .system-grid { grid-template-columns: 1fr; }
    .hero-shell { min-height: auto; }
    .hero-feature { min-height: 37rem; }
    .work-intro { align-items: start; }
    .work-intro > p { max-width: 44rem; }
  }

  @media (max-width: 720px) {
    .shipped-hero { padding: 8.3rem 0 3rem; }
    .hero-copy h1 { font-size: clamp(4rem,17vw,5.6rem); }
