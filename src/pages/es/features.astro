---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FeatureDeliverable from '../../components/FeatureDeliverable.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import ToolList from '../../components/ToolList.astro';
import { featureGroupsEs as featureGroups, connectionGroupsEs as connectionGroups, featureToolsEs as featureTools } from '../../data/featuresEs';
import { meetingTools } from '../../data/tools';
import vividPhotography from '../../data/featureVividPhotography.json';
import '../../styles/features.css';
import '../../styles/features-editorial.css';
import '../../styles/features-catalog.css';
import '../../styles/inner-motion.css';
const sections = [{ id: 'experts', label: 'Gestionado por expertos' }, { id: 'your-agent', label: 'Tu agente de IA' }, { id: 'capabilities', label: 'Todas las funciones' }, { id: 'meetings', label: 'Inteligencia de reuniones' }, { id: 'connections', label: 'Conexiones' }];
const featureVisuals: Record<string, { image: string; alt: string; label: string; title: string }> = {
  create: { image: 'marketing-production.webp', alt: 'Diseñadora revisando propuestas de sitios web y campañas en una computadora portátil y pruebas impresas', label: 'CREATIVIDAD QUE LLAMA LA ATENCIÓN', title: 'Haz que la primera impresión cuente.' },
  grow: { image: 'outbound-business-photo.webp', alt: 'Propietario de una cafetería preparando la apertura de un negocio con fachada verde bosque', label: 'DEL INTERÉS A LA OPORTUNIDAD', title: 'Dale una ventaja a la próxima conversación.' },
  coordinate: { image: 'expert-team-photo.webp', alt: 'Equipo de marketing colaborando con materiales de campaña en un estudio creativo', label: 'PERSONAS, CONTEXTO Y CONTINUIDAD', title: 'El gran trabajo se hace en equipo.' },
  learn: { image: 'campaign-review-photo.webp', alt: 'Estratega revisando propuestas de sitios web, pruebas de campañas sociales y fotografías del negocio en la pared de un estudio', label: 'CADA RONDA APROVECHA LA ANTERIOR', title: 'Conserva el conocimiento. Afina el siguiente brief.' },
};
---

<Layout title="Funciones - Tu marketing conectado y gestionado | Markethink" description="Tu agente de marketing con IA, gestionado por expertos. Explora sitios web, diseño, publicación social, reuniones, investigación de prospectos, CRM, SEO, publicidad y flujos conectados." canonical="https://markethink.ai/es/features/" lang="es" alternates={[{ lang: 'en', href: 'https://markethink.ai/features/' }, { lang: 'es', href: 'https://markethink.ai/es/features/' }, { lang: 'x-default', href: 'https://markethink.ai/features/' }] }>
  <div class="features-page">
    <a class="features-skip" href="#features-main">Saltar al contenido</a>
    <Navbar lang="es" />
    <main id="features-main">
      <section class="features-hero" aria-labelledby="features-title">
        <div class="hero-cinematic" aria-hidden="true"><img src="/images/features/marketing-studio-photo.webp" width="1536" height="1024" alt="" fetchpriority="high" /></div>
        <div class="features-wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Impulsado por IA. Gestionado por expertos.</p>
            <h1 id="features-title"><span>Tu marketing.</span><em>En movimiento.</em></h1>
            <p class="hero-description">Grandes ideas, creatividad cuidada y la operación para hacerlas realidad. Tu agente de IA dedicado y tu <strong>equipo experto de marketing</strong>, trabajando como uno solo.</p>
            <div class="features-actions"><a class="features-button" href="/es/solicitar-demo/">Solicitar una demo <span aria-hidden="true">↗</span></a><a class="text-link" href="#capabilities">Explorar las funciones <span aria-hidden="true">↓</span></a></div>
          </div>
          <div class="hero-stamp"><span class="stamp-star" aria-hidden="true">✳</span><div>Inteligencia creativa.<br /><strong>Perspectiva humana.</strong></div></div>
        </div>
        <div class="features-wrap hero-footnote"><span>Tu agente de IA dedicado</span><span>Tu equipo experto de marketing</span><span>Tu operación de marketing conectada</span></div>
      </section>

      <nav class="feature-index" aria-label="Explorar funciones"><div class="features-wrap">{sections.map((section, index) => <a href={`#${section.id}`}><span>0{index + 1}</span>{section.label}</a>)}</div></nav>

      <section class="feature-section expert-section" id="experts" aria-labelledby="experts-title">
        <div class="features-wrap two-columns expert-grid">
          <figure class="expert-photo" data-image-reveal><img src="/images/features/expert-team-photo.webp" width="1536" height="1024" alt="Tres estrategas creativos revisando materiales de campaña en un estudio iluminado" loading="lazy" decoding="async" /><figcaption><span class="photo-star" aria-hidden="true">✳</span><div>El lado humano de tu marketing.<span>La dirección experta forma parte de la operación.</span></div></figcaption></figure>
          <div class="feature-copy" data-reveal><p class="eyebrow"><span class="section-number">01</span> Gestionado por expertos</p><h2 id="experts-title">La IA mueve el trabajo.<br /><em>Las personas toman las decisiones.</em></h2><p>Recibes más que acceso a IA. Expertos en marketing definen tu estrategia, guían la producción, revisan la calidad y hacen que el trabajo avance con propósito.</p><div class="expert-roles"><div><strong>Tu agente</strong><span>Investiga, prepara, crea y conserva el contexto.</span></div><div><strong>Tu equipo</strong><span>Define la dirección, revisa el trabajo y asume la responsabilidad.</span></div><div><strong>Tú</strong><span>Defines las prioridades y apruebas las decisiones importantes.</span></div></div><p class="expert-note">Una operación conectada, respaldada por un equipo real de marketing.</p></div>
        </div>
      </section>

      <section class="feature-section agent-section" id="your-agent" aria-labelledby="agent-title">
        <div class="features-wrap two-columns"><div class="feature-copy" data-reveal><p class="eyebrow"><span class="section-number">02</span> Tu agente de IA dedicado</p><h2 id="agent-title">Entrenado con tu negocio.<br /><em>Dirigido por tu equipo.</em></h2><p>Un agente de marketing con IA dedicado, configurado según tus ofertas, audiencia, voz de marca e identidad visual. Trabaja con tu equipo, recuerda los comentarios aprobados y lleva ese contexto al siguiente trabajo.</p><ul class="feature-checks"><li>Conocimiento del negocio, guías y referencias creativas</li><li>Chat compartido con tu agente y equipo de marketing</li><li>Decisiones y comentarios aprobados que permanecen con el trabajo</li><li>Herramientas conectadas con acceso limitado a tu negocio</li></ul><p class="feature-note">Menos explicaciones repetidas. Más comprensión. Un mejor punto de partida para cada brief.</p></div>
          <div class="agent-visual" data-reveal aria-label="Ejemplo de contexto de marca"><figure class="agent-context-image"><img src={`/images/features/inner/${vividPhotography['brand-book'].file}.webp`} alt="Libro de marca y referencias creativas utilizadas para orientar el trabajo" width="1536" height="1024" loading="lazy" decoding="async" /></figure><div class="brand-file"><div class="brand-file-heading"><span class="file-icon" aria-hidden="true">✳</span><div><small>LA BASE DE TU AGENTE</small><h3>Tu negocio. Siempre en contexto.</h3></div></div><div class="reference-chips"><span>Voz de marca</span><span>Audiencia</span><span>Trabajo aprobado</span></div><div class="memory-feedback"><span aria-hidden="true">↳</span><div><small>TUS COMENTARIOS</small><p>“Comienza con el beneficio. Mantén un tono conversacional.”</p><span class="applied-note">✓ Contexto para el siguiente brief</span></div></div></div></div>
        </div>
      </section>

      <section class="feature-section capabilities-section" id="capabilities" aria-labelledby="capabilities-title"><div class="features-wrap"><div class="section-heading" data-reveal><div><p class="eyebrow"><span class="section-number">03</span> Todas las funciones</p><h2 id="capabilities-title">Desde la visión general<br /><em>hasta el último detalle.</em></h2></div><p>Sitios web, diseño, marketing, investigación y coordinación diaria. Explora lo que tu agente y tu equipo experto pueden poner en marcha para tu negocio.</p></div>
        <div class="feature-browser">
          <div class="feature-tabs" aria-label="Categorías de funciones">{featureGroups.map(group => <a href={`#features-${group.id}`} id={`tab-${group.id}`} data-feature-tab={group.id}>{group.label}</a>)}</div>
          <div class="feature-panels">{featureGroups.map(group => <section id={`features-${group.id}`} class={`feature-panel panel-${group.id}`} data-feature-panel={group.id}>
            <div class="feature-spotlight">
              <div class="spotlight-copy"><span class="eyebrow">{featureVisuals[group.id].label}</span><h3>{featureVisuals[group.id].title}</h3><p>{group.description}</p></div>
            </div>
            <div class="feature-catalog" id={`catalog-${group.id}`}>
              <div class="capability-grid">{group.features.map((feature, index) => <article class="capability-card">
                <FeatureDeliverable group={group.id} index={index} />
                <div class="capability-copy"><h4>{featureTools[feature.title] && <ToolLogo id={featureTools[feature.title]} />}<span class="capability-link-label">{feature.title}</span></h4>
                <p>{feature.description}</p><span class="capability-detail">{feature.detail}</span></div>
              </article>)}</div>
            </div>
          </section>)}</div>
        </div>
        <p class="scope-note">Tus servicios, volumen, conexiones y reglas de aprobación se acuerdan contigo. Algunas funciones requieren activar una cuenta o configuración adicional. <a href="/es/trabajo-real/">Ver ejemplos de trabajo real ↗</a></p>
      </div></section>

      <section class="feature-section meeting-section" id="meetings" aria-labelledby="meetings-title"><div class="features-wrap two-columns"><div class="feature-copy" data-reveal><p class="eyebrow"><span class="section-number">04</span> Inteligencia de reuniones</p><h2 id="meetings-title">La llamada termina.<br /><em>El contexto permanece.</em></h2><p>Invita a tu asistente de notas a una reunión específica. Graba la conversación, captura la transcripción y lleva las decisiones y próximas acciones de vuelta al trabajo de marketing.</p><ul class="feature-checks"><li>Grabación y transcripción de reuniones</li><li>Resúmenes, decisiones y acciones de seguimiento</li><li>Contexto útil del negocio para tu agente y equipo</li></ul><ToolList items={meetingTools} label="Plataformas de reuniones" marquee={false} /><p class="meeting-note">Disponible para llamadas solicitadas, con la grabación habilitada para tu cuenta.</p></div><div class="meeting-visual" data-reveal aria-label="Transcripción ilustrativa de una reunión y próximas acciones"><div class="meeting-visual-head"><div><h3>Inicio de un nuevo servicio</h3><small>Resumen ilustrativo de la reunión</small></div><span>Grabada</span></div><div class="meeting-transcript"><div><time>04:12</time><p><strong>TU EQUIPO</strong>Comencemos con el problema que resuelve este servicio.</p></div><div><time>04:38</time><p><strong>TÚ</strong>Exactamente. Comencemos con una página de destino y una campaña breve de lanzamiento.</p></div><div><time>05:06</time><p><strong>TU EQUIPO</strong>Traeremos el mensaje y la dirección creativa para revisión.</p></div></div><div class="meeting-outcome"><span>DE LA CONVERSACIÓN A LAS PRÓXIMAS ACCIONES</span><p><span>↗</span> Preparar el brief de la página de destino</p><p><span>↗</span> Desarrollar la dirección de la campaña de lanzamiento</p><p><span>↗</span> Presentar el trabajo para tu revisión</p></div></div></div></section>

      <section class="feature-section connections-section" id="connections" aria-labelledby="connections-title"><div class="features-wrap"><div class="section-heading" data-reveal><div><p class="eyebrow"><span class="section-number">05</span> Tus herramientas actuales, conectadas</p><h2 id="connections-title">Tus herramientas.<br /><em>Un solo ritmo de trabajo.</em></h2></div><p>Tu negocio ya utiliza sus propias herramientas. Markethink trabaja mediante las cuentas y plataformas incluidas en tu alcance, con los accesos que apruebas.</p></div><div class="connection-groups">{connectionGroups.map((group, index) => <article class="connection-group" data-reveal style={`--card-index:${index}`}><h3>{group.title}</h3><p>{group.description}</p><ToolList items={group.apps} label={group.title} /><p class="connection-others">{group.note}</p></article>)}</div><p class="connection-scope">Las conexiones y acciones se habilitan según los servicios seleccionados y los permisos de tus cuentas. Los formatos de publicación, grabación, envío y otras acciones dependen de la plataforma conectada y la configuración acordada.</p></div></section>

      <section class="features-final-cta" aria-labelledby="final-title"><div class="cta-art" aria-hidden="true"><img src="/images/features/marketing-production.webp" width="1536" height="1024" alt="" loading="lazy" /></div><div class="features-wrap" data-reveal><p class="eyebrow">Pon toda la operación a trabajar</p><h2 id="final-title">Tu próximo<br /><em>gran paso.</em></h2><p>Trae la ambición. Nosotros ponemos la IA,<br />la creatividad y las personas para hacerla avanzar.</p><a class="features-button" href="/es/solicitar-demo/">Solicitar una demo <span aria-hidden="true">↗</span></a><span class="final-signoff">Impulsado por IA. Gestionado por expertos en marketing.</span></div></section>
    </main>
    <Footer lang="es" />
    <button class="motion-toggle" type="button" aria-pressed="false" hidden>Pausar movimiento <span aria-hidden="true">Ⅱ</span></button>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const page = document.querySelector<HTMLElement>('.features-page');
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-feature-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-feature-panel]'));
  const tabList = document.querySelector('.feature-tabs');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let motionPaused = reducedMotion.matches;
  if (tabList && tabs.length && panels.length) {
    tabList.setAttribute('role', 'tablist');
    function activateTab(index: number, moveFocus = false, animate = true) {
      tabs.forEach((tab, tabIndex) => {
        const active = index === tabIndex;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[tabIndex].hidden = !active;
      });
      if (moveFocus) tabs[index].focus();
      if (animate && !motionPaused) {
        gsap.fromTo(panels[index].querySelectorAll('.capability-card'), { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: .45, stagger: .045, ease: 'power2.out', overwrite: true, clearProps: 'opacity,transform' });
        gsap.fromTo(panels[index].querySelector('.feature-spotlight'), { y: 12, opacity: .2 }, { y: 0, opacity: 1, duration: .6, ease: 'power3.out', overwrite: true, clearProps: 'opacity,transform' });
      }
      ScrollTrigger.refresh();
    }
    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panels[index].id);
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', tab.id);
      panels[index].tabIndex = 0;
      tab.addEventListener('click', event => { event.preventDefault(); activateTab(index); });
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else if (event.key === ' ') { event.preventDefault(); activateTab(index); return; }
        else return;
        event.preventDefault(); activateTab(next, true);
      });
    });
    function hashPanelIndex() {
      const target = document.getElementById(window.location.hash.slice(1));
      return panels.findIndex(panel => panel === target || (target !== null && panel.contains(target)));
    }
    const hashIndex = hashPanelIndex();
    activateTab(hashIndex < 0 ? 0 : hashIndex, false, false);
    if (hashIndex >= 0) requestAnimationFrame(() => document.getElementById(window.location.hash.slice(1))?.scrollIntoView({ behavior: 'instant' }));
    window.addEventListener('hashchange', () => {
      const index = hashPanelIndex();
      if (index >= 0) {
        activateTab(index);
        requestAnimationFrame(() => document.getElementById(window.location.hash.slice(1))?.scrollIntoView({ behavior: 'instant' }));
      }
    });
  }
  let motionContext: gsap.Context | undefined;
  const motionButton = document.querySelector<HTMLButtonElement>('.motion-toggle');
  function startMotion() {
    motionContext = gsap.context(() => {
      gsap.from('.hero-copy > *', { y: 20, opacity: 0, duration: .85, stagger: .12, ease: 'power3.out', clearProps: 'all' });
      gsap.from('.hero-cinematic img', { scale: 1.09, duration: 1.8, ease: 'power2.out', clearProps: 'transform' });
      gsap.from('.hero-stamp', { y: 22, opacity: 0, duration: 1, delay: .6, ease: 'power3.out', clearProps: 'all' });
      document.querySelectorAll('[data-reveal]').forEach(element => {
        gsap.from(element, { y: 36, opacity: 0, duration: .85, ease: 'power3.out', clearProps: 'all', scrollTrigger: { trigger: element, start: 'top 92%', once: true } });
      });
      document.querySelectorAll<HTMLElement>('[data-image-reveal]').forEach(element => {
        gsap.from(element, { clipPath: 'inset(12% 4% 12% 4% round 48px)', duration: 1.2, ease: 'power3.out', clearProps: 'clipPath', scrollTrigger: { trigger: element, start: 'top 88%', once: true } });
      });
      gsap.to('.hero-cinematic', { y: 50, ease: 'none', scrollTrigger: { trigger: '.features-hero', start: 'top top', end: 'bottom top', scrub: 1 } });
      document.querySelectorAll('.feature-index a').forEach(link => {
        const id = link.getAttribute('href');
        if (id) ScrollTrigger.create({ trigger: id, start: 'top 120px', end: 'bottom 120px', onToggle: self => link.classList.toggle('is-current', self.isActive) });
      });
    }, page!);
    page?.classList.add('motion-enabled');
  }
  function updateMotion(paused: boolean) {
    paused = paused || reducedMotion.matches;
    motionPaused = paused;
    motionContext?.revert();
    gsap.killTweensOf('.capability-card, .feature-spotlight');
    gsap.set('.capability-card, .feature-spotlight', { clearProps: 'opacity,transform' });
    page?.classList.toggle('motion-paused', paused);
    if (page) page.dataset.motionPaused = String(paused);
    page?.classList.remove('motion-enabled');
    if (!paused) startMotion();
    if (motionButton) {
      motionButton.hidden = false;
      motionButton.setAttribute('aria-pressed', String(paused));
      motionButton.innerHTML = paused ? 'Activar movimiento <span aria-hidden="true">▷</span>' : 'Pausar movimiento <span aria-hidden="true">Ⅱ</span>';
    }
  }
  if (page) updateMotion(motionPaused);
  motionButton?.addEventListener('click', () => updateMotion(!motionPaused));
  reducedMotion.addEventListener('change', event => updateMotion(event.matches));

</script>
