---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { spanishInsightPosts } from "../../../data/blogPostsEs";
import { SANTIAGO_LINKEDIN_URL, SANTIAGO_PROFILE_ID, SANTIAGO_PROFILE_URL, SANTIAGO_PROFILE_URL_ES, santiagoSosaAuthorEs } from "../../../data/blogAuthors";
const authoredPosts = spanishInsightPosts;
const topics = [...new Set(authoredPosts.map((post) => post.category))].sort();
const profileSchema = { "@context": "https://schema.org", "@type": "ProfilePage", "@id": `${SANTIAGO_PROFILE_URL_ES}#profile-page`, url: SANTIAGO_PROFILE_URL_ES, name: "Santiago Sosa, fundador de Markethink.ai", description: santiagoSosaAuthorEs.bio, inLanguage: "es", mainEntity: { "@type": "Person", "@id": SANTIAGO_PROFILE_ID, name: santiagoSosaAuthorEs.name, jobTitle: santiagoSosaAuthorEs.title, description: santiagoSosaAuthorEs.bio, url: SANTIAGO_PROFILE_URL_ES, image: santiagoSosaAuthorEs.image.url, sameAs: [SANTIAGO_LINKEDIN_URL], worksFor: { "@type": "Organization", "@id": "https://markethink.ai/#organization", name: "Markethink", url: "https://markethink.ai/", founder: { "@type": "Person", "@id": SANTIAGO_PROFILE_ID } } } };
---
<Layout title="Santiago Sosa, fundador de Markethink.ai" description={santiagoSosaAuthorEs.bio} canonical={SANTIAGO_PROFILE_URL_ES} lang="es" alternates={[{ lang: "en", href: SANTIAGO_PROFILE_URL }, { lang: "es", href: SANTIAGO_PROFILE_URL_ES }, { lang: "x-default", href: SANTIAGO_PROFILE_URL }]} structuredData={profileSchema}>
  <Navbar lang="es" alternatePath="/authors/santiago-sosa/" />
  <main class="author-profile">
    <header class="profile-hero"><div class="profile-shell profile-identity"><img class="profile-portrait" src={santiagoSosaAuthorEs.profileImage.path} alt="Santiago Sosa, fundador de Markethink.ai" width={santiagoSosaAuthorEs.profileImage.width} height={santiagoSosaAuthorEs.profileImage.height} decoding="async" fetchpriority="high" /><div class="profile-copy"><p class="eyebrow">Perfil del autor</p><h1>Santiago Sosa</h1><p class="role">Fundador de Markethink.ai</p><p class="bio">{santiagoSosaAuthorEs.bio}</p><a class="linkedin-link" href={SANTIAGO_LINKEDIN_URL} rel="me external">Ver a Santiago Sosa en LinkedIn</a></div></div></header>
    <section class="profile-section topics" aria-labelledby="topics-title"><div class="profile-shell split"><div><p class="eyebrow">Temas publicados</p><h2 id="topics-title">Áreas cubiertas en los artículos de Santiago</h2></div><ul class="topic-list">{topics.map((topic) => <li>{topic}</li>)}</ul></div></section>
    <section class="profile-section articles" aria-labelledby="articles-title"><div class="profile-shell"><div class="section-heading"><p class="eyebrow">Artículos actuales</p><h2 id="articles-title">Artículos de Santiago en español</h2></div><ol class="article-list">{authoredPosts.map((post) => (<li data-author-article><a href={`/es/blog/${post.slug}/`}><span>{post.category}</span><strong>{post.title}</strong><small>{post.readingTime}</small></a></li>))}</ol></div></section>
  </main>
  <Footer lang="es" />
</Layout>

<style>
  .author-profile {
    min-width: 0;
    overflow-x: clip;
    background: #f4f1e8;
    color: #0f1213;
  }

  .profile-shell {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    min-width: 0;
  }

  .profile-hero {
    padding: clamp(7.5rem, 13vw, 10rem) 0 clamp(3.25rem, 7vw, 5rem);
    border-bottom: 1px solid rgba(15, 18, 19, 0.18);
  }

  .profile-identity {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .profile-portrait {
    display: block;
    width: 12rem;
    height: 12rem;
    aspect-ratio: 1;
    border: 1px solid rgba(15, 18, 19, 0.2);
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }

  .profile-copy {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #315b28;
    font: 700 0.76rem/1.3 Inter, system-ui, sans-serif;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p,
  a,
  strong,
  small,
  li {
    overflow-wrap: anywhere;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font: 500 clamp(2.4rem, 6vw, 4rem)/0.98 "Instrument Serif", Georgia, serif;
    letter-spacing: -0.045em;
  }

  .role {
    margin: 1rem 0 0;
    color: #315b28;
    font: 700 clamp(1rem, 2vw, 1.125rem)/1.4 Inter, system-ui, sans-serif;
  }

  .bio {
    max-width: 46rem;
    margin: 1.25rem 0 0;
    font: 400 clamp(1rem, 1.8vw, 1.125rem)/1.65 Inter, system-ui, sans-serif;
  }

  .linkedin-link {
    display: inline-flex;
    margin-top: 1.4rem;
    color: #315b28;
    font: 700 1rem/1.4 Inter, system-ui, sans-serif;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .profile-section {
    padding: clamp(2.75rem, 6vw, 4.5rem) 0;
    border-bottom: 1px solid rgba(15, 18, 19, 0.16);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  h2 {
    max-width: 16ch;
    margin: 0;
    font: 500 clamp(2rem, 4vw, 3rem)/1.05 "Instrument Serif", Georgia, serif;
    letter-spacing: -0.035em;
  }

  .topic-list,
  .method-list,
  .article-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .topic-list li {
    padding: 0.62rem 0.8rem;
    border: 1px solid rgba(49, 91, 40, 0.45);
    color: #315b28;
    font: 700 0.9rem/1.3 Inter, system-ui, sans-serif;
  }

  .section-heading {
    margin-bottom: 1.75rem;
  }

  .article-list {
    border-top: 1px solid rgba(15, 18, 19, 0.28);
  }

  .article-list li {
    border-bottom: 1px solid rgba(15, 18, 19, 0.18);
  }

  .article-list a {
    display: grid;
    grid-template-columns: minmax(8rem, 0.55fr) minmax(0, 2fr) auto;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.15rem 0;
    color: #0f1213;
    text-decoration: none;
  }

  .article-list span,
  .article-list small {
    color: #315b28;
    font: 700 0.76rem/1.4 Inter, system-ui, sans-serif;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-list strong {
    font: 600 clamp(1rem, 1.8vw, 1.125rem)/1.45 Inter, system-ui, sans-serif;
  }

  .article-list a:hover strong,
  .linkedin-link:hover {
    color: #315b28;
  }

  .method-list a:hover {
    color: #69d254;
  }

  .methods {
    background: #0f1213;
    color: #f5f5f1;
  }

  .methods .eyebrow {
    color: #69d254;
  }

  .methods p:not(.eyebrow) {
    max-width: 33rem;
    margin: 1rem 0 0;
    color: #f5f5f1;
    font: 400 1rem/1.6 Inter, system-ui, sans-serif;
  }

  .method-list {
    border-top: 1px solid rgba(105, 210, 84, 0.55);
  }

  .method-list li {
    border-bottom: 1px solid rgba(105, 210, 84, 0.35);
  }

  .method-list a {
    display: block;
    padding: 1rem 0;
    color: #f5f5f1;
    font: 700 clamp(1rem, 2vw, 1.125rem)/1.4 Inter, system-ui, sans-serif;
    text-decoration-color: #69d254;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.24em;
  }

  .article-list a:focus-visible,
  .linkedin-link:focus-visible {
    outline: 3px solid #315b28;
    outline-offset: 4px;
    border-radius: 0.15rem;
  }

  .method-list a:focus-visible {
    outline: 3px solid #69d254;
    outline-offset: 4px;
    border-radius: 0.15rem;
  }

  @media (max-width: 700px) {
    .profile-shell {
      width: min(100% - 1.5rem, 72rem);
    }

    .profile-hero {
      padding-top: 7rem;
    }

    .profile-identity {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }

    .profile-portrait {
      width: 7.5rem;
      height: 7.5rem;
    }

    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .article-list a {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
      padding: 1rem 0;
    }
  }
</style>
