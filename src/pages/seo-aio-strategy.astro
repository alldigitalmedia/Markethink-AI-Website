---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
  STATUS_DEFINITIONS,
  PHASES,
  ROADMAP_META,
  roadmapEntries,
  measurementNotes,
  changeLog,
  statusCounts,
} from "../data/seoAioStrategy.mjs";

const {
  title: pageTitle,
  description: pageDescription,
  canonical,
  publishedDate: releaseDate,
  lastSubstantiveUpdate,
  latestUpdateId,
  sharingImageUrl,
  sharingImageWidth,
  sharingImageHeight,
  sharingImageAlt,
} = ROADMAP_META;
const groupedPhases = PHASES.map((phase) => ({
  ...phase,
  entries: roadmapEntries.filter((entry) => entry.phaseId === phase.id),
}));
const displayDate = (value) => new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${value}T00:00:00Z`));
const statusClass = (status) => status.toLowerCase().replace(/\s+/g, "-");

const articleSchema = {
  "@type": "Article",
  headline: "Steal our SEO & AIO strategy.",
  description: pageDescription,
  url: canonical,
  datePublished: releaseDate,
  dateModified: lastSubstantiveUpdate,
  image: {
    "@type": "ImageObject",
    url: sharingImageUrl,
    contentUrl: sharingImageUrl,
    width: sharingImageWidth,
    height: sharingImageHeight,
    caption: sharingImageAlt,
  },
  inLanguage: "en",
  isAccessibleForFree: true,
  author: { "@type": "Organization", "@id": "https://markethink.ai/#organization", name: "Markethink" },
  about: ["Search engine optimization", "AI-assisted search", "Marketing operations"],
  citation: [
    "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide",
    "https://developers.google.com/search/docs/appearance/ai-features",
    "https://developers.google.com/search/docs/fundamentals/using-gen-ai-content",
  ],
};
const webPageSchema = {
  "@type": "WebPage",
  dateModified: lastSubstantiveUpdate,
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: sharingImageUrl,
    contentUrl: sharingImageUrl,
    width: sharingImageWidth,
    height: sharingImageHeight,
    caption: sharingImageAlt,
  },
};
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://markethink.ai/" },
    { "@type": "ListItem", position: 2, name: "SEO & AIO Strategy", item: canonical },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  image={sharingImageUrl}
  imageAlt={sharingImageAlt}
  imageWidth={sharingImageWidth}
  imageHeight={sharingImageHeight}
  type="article"
  structuredData={[webPageSchema, articleSchema, breadcrumbSchema]}
>
  <header class="site-header"><Navbar ctaLabel="Request available times" /></header>
  <main id="top" class="strategy-page">
    <article>
      <header class="strategy-hero">
        <div class="container hero-shell">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span><span>SEO & AIO strategy</span>
          </nav>
          <div class="hero-grid">
            <div class="hero-copy">
              <p class="eyebrow">A PUBLIC WORKING DOCUMENT · EDITION 01</p>
              <h1>Steal our SEO &amp; AIO strategy.</h1>
              <p class="supporting-line">Watch us implement it on Markethink.ai.</p>
            </div>
            <div class="hero-brief">
              <p>
                This is Markethink's documented experiment: a 30-day sequence that starts with buyer evidence, improves the pages that already own the demand, adds documented proof, and checks what actually changed.
              </p>
              <p>
                AIO means improving how useful, accurate content is found and represented in AI-assisted search. It builds on conventional SEO. It is not a guaranteed ranking recipe.
              </p>
            </div>
          </div>
          <div class="update-meta">
            <span>Last substantive update: <time datetime={lastSubstantiveUpdate}>{displayDate(lastSubstantiveUpdate)}</time></span>
            <a href={`#${latestUpdateId}`}>Latest update</a>
          </div>
          <p class="window-note">Day ranges such as Days 1–5 and Days 6–12 are target windows, not recorded sprint dates or a claimed sprint start.</p>
          <div class="timeline-opening" aria-label="Roadmap target windows">
            {PHASES.slice(0, 6).map((phase, index) => (
              <a href={`#${phase.id}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{phase.label}</strong>
                <small>{phase.shortLabel}</small>
              </a>
            ))}
          </div>
          <div class="hero-actions">
            <a class="button" href="/downloads/seo-aio-strategy-checklist.md" download>Download the reusable checklist <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="#roadmap">Read the roadmap</a>
          </div>
        </div>
      </header>

      <section class="principles-section" aria-labelledby="principles-title">
        <div class="container principles-grid">
          <div>
            <p class="eyebrow dark-eyebrow">THE OPERATING RULE</p>
            <h2 id="principles-title">Evidence before expansion.</h2>
          </div>
          <div class="principles-copy">
            <p class="lead">Publishing more pages is easy. Proving which buyer question, URL, evidence gap, and business action each page should own is the work.</p>
            <div class="principle-list">
              <article><span>01</span><div><h3>Improve what exists first.</h3><p>Map buyer needs to current URLs before proposing another page.</p></div></article>
              <article><span>02</span><div><h3>Keep proof close to the claim.</h3><p>Use approved evidence, state its limits, and leave missing results unfilled.</p></div></article>
              <article><span>03</span><div><h3>Measure three different outcomes.</h3><p>Organic discovery, observed AI-search representation, and qualified inquiries are separate signals.</p></div></article>
            </div>
            <p class="contextual-link-note">For the repeatable method behind improving existing pages, use our <a href="/blog/seo-content-feedback-loop/">SEO content feedback loop</a>.</p>
          </div>
        </div>
      </section>

      <section class="status-section" id="status-definitions" aria-labelledby="status-title">
        <div class="container">
          <div class="section-heading split-heading">
            <div><p class="eyebrow">STATUS LANGUAGE</p><h2 id="status-title">Published is not the same as proven.</h2></div>
            <p>Counts come directly from the structured roadmap entries. They do not move with the calendar, and this page never converts them into a completion percentage.</p>
          </div>
          <div class="status-grid">
            {STATUS_DEFINITIONS.map((status) => (
              <article class:list={["status-card", `status-${statusClass(status.label)}`]} data-status-count={status.label}>
                <div><span class="status-name">{status.label}</span><strong>{statusCounts[status.label]}</strong></div>
                <p>{status.definition}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="roadmap-section" id="roadmap" aria-labelledby="roadmap-title">
        <div class="container">
          <div class="section-heading split-heading">
            <div><p class="eyebrow dark-eyebrow">THE FULL ROADMAP</p><h2 id="roadmap-title">Every action has a finish line.</h2></div>
            <p>{roadmapEntries.length} structured actions. No automatic day-based progress. Dates appear only where a public release or acceptance check has evidence.</p>
          </div>

          <nav class="phase-filters" aria-label="Filter roadmap by phase">
            <button type="button" data-phase-filter="all" aria-pressed="true">All {roadmapEntries.length}</button>
            {PHASES.map((phase) => <button type="button" data-phase-filter={phase.id} aria-pressed="false">{phase.label}</button>)}
          </nav>
          <p class="filter-result" aria-live="polite">Showing all {roadmapEntries.length} actions.</p>
          <noscript><p class="noscript-note">All actions are visible. Phase filtering is an optional browser enhancement.</p></noscript>

          <div class="phase-list">
            {groupedPhases.map((phase, phaseIndex) => (
              <section class="phase" id={phase.id} data-phase-group={phase.id} aria-labelledby={`${phase.id}-title`} tabindex="-1">
                <header class="phase-header">
                  <div class="phase-number">{String(phaseIndex + 1).padStart(2, "0")}</div>
                  <div><p>{phase.label}</p><h3 id={`${phase.id}-title`}>{phase.shortLabel}</h3></div>
                  <span>{phase.entries.length} {phase.entries.length === 1 ? "action" : "actions"}</span>
                </header>
                <div class="entry-list">
                  {phase.entries.map((entry) => (
                    <article class="entry-card" id={entry.id} data-roadmap-entry={entry.id} tabindex="-1">
                      <header class="entry-header">
                        <div>
                          <p class="entry-window">{entry.window}</p>
                          <h4>{entry.title}</h4>
                        </div>
                        <div class="entry-actions">
                          <span class:list={["status-pill", `status-${statusClass(entry.status)}`]}>{entry.status}</span>
                          <button type="button" class="copy-link" data-copy-permalink={entry.id} aria-label={`Copy link to ${entry.title}`}>
                            <span aria-hidden="true">#</span><span data-copy-label>Copy link</span>
                          </button>
                        </div>
                      </header>
                      <div class="entry-body">
                        <div class="why-block">
                          <p class="field-label">Why</p>
                          <p>{entry.why}</p>
                          {entry.progressNote && <p class="progress-note"><strong>Current progress:</strong> {entry.progressNote}</p>}
                          {entry.optionalTrack && <div class="optional-track"><strong>{entry.optionalTrack.label}</strong><p>{entry.optionalTrack.detail}</p></div>}
                          <dl>
                            <div><dt>Target page</dt><dd>{entry.targetUrl ? <a href={entry.targetUrl}>{entry.targetPage}</a> : entry.targetPage}</dd></div>
                            <div><dt>Verified date</dt><dd>{entry.verifiedDate ? displayDate(entry.verifiedDate) : "Not yet verified"}</dd></div>
                            <div>
                              <dt>Public evidence</dt>
                              <dd>{entry.evidenceUrl ? <a href={entry.evidenceUrl}>{entry.evidenceLabel}</a> : "No public evidence link available"}</dd>
                            </div>
                          </dl>
                        </div>
                        <div class="how-block">
                          <p class="field-label">Repeatable how</p>
                          <ol>{entry.how.map((step) => <li>{step}</li>)}</ol>
                        </div>
                        <div class="done-block">
                          <p class="field-label">Done criteria</p>
                          <ul>{entry.doneCriteria.map((criterion) => <li data-criterion-state={criterion.state}><span class="criterion-icon" aria-hidden="true">{criterion.state === "verified" ? "✓" : "•"}</span><span>{criterion.text}</span></li>)}</ul>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section class="measurement-section" id="measurement" aria-labelledby="measurement-title">
        <div class="container">
          <div class="section-heading split-heading">
            <div><p class="eyebrow dark-eyebrow">MEASUREMENT NOTES</p><h2 id="measurement-title">Three lanes, three honest baselines.</h2></div>
            <p>Future observations must include a source, date, scope, and denominator. A missing baseline is Not yet measured, never zero.</p>
          </div>
          <div class="measurement-grid">
            {measurementNotes.map((note, index) => (
              <article data-measurement-lane={note.id}>
                <div class="measurement-index">0{index + 1}</div>
                <p class="measurement-label">{note.label}</p>
                <strong>{note.currentValue}</strong>
                <h3>What we will observe</h3>
                <p>{note.measure}</p>
                <h3>Important limit</h3>
                <p>{note.limit}</p>
                <div class="required-fields">Required on every observation: {note.futureObservationRequirements.join(" · ")}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="methodology-section" id="methodology" aria-labelledby="methodology-title">
        <div class="container method-grid">
          <div class="method-heading">
            <p class="eyebrow dark-eyebrow">METHOD, NOT MAGIC</p>
            <h2 id="methodology-title">What AIO changes, and what it does not.</h2>
          </div>
          <div class="method-copy">
            <p class="lead">Conventional SEO, useful original or first-hand content, accurate facts, crawlable pages, internal links, and clear site structure remain central.</p>
            <p>Google's current official guidance says its generative AI search features use core Search ranking and quality systems. It recommends valuable, non-commodity content and a clear technical structure. It also says there is no special schema.org type, AI text file, or additional technical requirement that guarantees inclusion.</p>
            <p>Structured data still helps search systems understand eligible page types when it matches visible content. It does not guarantee a rich result, ranking, mention, or citation.</p>
            <div class="source-list">
              <a href="https://developers.google.com/search/docs/fundamentals/ai-optimization-guide">
                <span>Google Search Central · Updated July 10, 2026</span>
                <strong>Optimizing your website for generative AI features on Google Search</strong>
              </a>
              <a href="https://developers.google.com/search/docs/appearance/ai-features">
                <span>Google Search Central · Site-owner guidance</span>
                <strong>AI features and your website</strong>
              </a>
              <a href="https://developers.google.com/search/docs/fundamentals/using-gen-ai-content">
                <span>Google Search Central · Content guidance</span>
                <strong>Using generative AI content on your website</strong>
              </a>
            </div>
            <div class="method-note">
              <h3>Experiment boundary</h3>
              <p>We are documenting what Markethink changes, when it changes, what acceptance check passed, and what we observe afterward. We are not claiming that every older strategy or vendor measurement has been independently verified, and we are not promising rankings, citations, traffic, leads, or revenue.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="reading-section" aria-labelledby="reading-title">
        <div class="container reading-grid">
          <div><p class="eyebrow">RELATED FIELD NOTES</p><h2 id="reading-title">Read the evidence behind the operating plan.</h2></div>
          <div class="reading-links">
            <a href="/blog/how-to-show-up-in-ai-search/">
              <span>Practical guide</span>
              <strong>How to get your business to show up in AI search</strong>
              <p>Read the source-backed foundation, readiness checks, evidence model, and measurement limits.</p>
            </a>
            <a href="/ai-marketing-statistics/">
              <span>Research ledger</span>
              <strong>AI marketing statistics, with the source behind every number</strong>
              <p>Review the public statistics, study scopes, original-source links, and downloadable source ledgers.</p>
            </a>
          </div>
        </div>
      </section>

      <section class="change-log-section" id="change-log" aria-labelledby="change-log-title">
        <div class="container change-grid">
          <div><p class="eyebrow dark-eyebrow">APPEND-ONLY CHANGE LOG</p><h2 id="change-log-title">What changed.</h2></div>
          <ol class="change-list">
            {changeLog.map((change) => (
              <li id={change.id}>
                <time datetime={change.date}>{displayDate(change.date)}</time>
                <div><h3>{change.title}</h3><p>{change.detail}</p></div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="closing-section" aria-labelledby="closing-title">
        <div class="container closing-grid">
          <div>
            <p class="eyebrow dark-eyebrow">USE THE PLAYBOOK</p>
            <h2 id="closing-title">Bring us the search and pipeline gap you need to understand.</h2>
            <p>We will map the buyer question, page ownership, evidence, measurement, and next decision before recommending more content.</p>
          </div>
          <div class="closing-action">
            <a class="button" href="/schedule-a-walkthrough/">Request available times</a>
            <p>The existing form requests available times. It does not book a meeting.</p>
          </div>
        </div>
      </section>
    </article>
  </main>
  <Footer walkthroughLabel="Request available times" description="Markethink is an AI marketing system managed by expert marketers. We learn your business, run marketing day to day, and connect campaigns to leads and follow-up." />
</Layout>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-phase-filter]"));
  const phaseGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-phase-group]"));
  const result = document.querySelector<HTMLElement>(".filter-result");

  function setActiveFilter(selected: string, scrollPhase = false) {
    let visibleActions = 0;
    filterButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.phaseFilter === selected)));
    phaseGroups.forEach((group) => {
      const visible = selected === "all" || group.dataset.phaseGroup === selected;
      group.hidden = !visible;
      if (visible) visibleActions += group.querySelectorAll("[data-roadmap-entry]").length;
    });
    if (result) result.textContent = selected === "all"
      ? `Showing all ${visibleActions} actions.`
      : `Showing ${visibleActions} ${visibleActions === 1 ? "action" : "actions"}.`;
    if (scrollPhase && selected !== "all") document.getElementById(selected)?.scrollIntoView({ block: "start" });
  }

  function resolveHashTarget(hash = window.location.hash, focusTarget = true) {
    if (!hash || hash === "#") return;
    let id = "";
    try { id = decodeURIComponent(hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!target) return;
    const targetPhase = target.matches("[data-phase-group]")
      ? target
      : target.closest<HTMLElement>("[data-phase-group]");
    if (targetPhase?.hidden) setActiveFilter("all");
    window.requestAnimationFrame(() => {
      target.scrollIntoView({ block: "start" });
      if (focusTarget) target.focus({ preventScroll: true });
    });
  }

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => setActiveFilter(button.dataset.phaseFilter ?? "all", true));
  });

  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", () => window.setTimeout(() => resolveHashTarget(window.location.hash), 0));
  });

  async function writePermalink(value: string) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }
    const fallback = document.createElement("textarea");
    fallback.value = value;
    fallback.setAttribute("readonly", "");
    fallback.style.position = "fixed";
    fallback.style.opacity = "0";
    document.body.append(fallback);
    fallback.select();
    document.execCommand("copy");
    fallback.remove();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy-permalink]").forEach((button) => {
    button.addEventListener("click", async () => {
      const id = button.dataset.copyPermalink;
      if (!id) return;
      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      try {
        await writePermalink(`${window.location.origin}${window.location.pathname}#${id}`);
        if (label) label.textContent = "Copied";
        button.setAttribute("aria-label", "Link copied");
      } catch {
        if (label) label.textContent = "Copy failed";
        button.setAttribute("aria-label", "Copy failed. Open this action link instead");
      }
      window.setTimeout(() => {
        if (label) label.textContent = "Copy link";
        button.setAttribute("aria-label", `Copy link to ${button.closest("[data-roadmap-entry]")?.querySelector("h4")?.textContent ?? "roadmap action"}`);
      }, 2200);
    });
  });

  window.addEventListener("hashchange", () => resolveHashTarget());
  window.addEventListener("popstate", () => resolveHashTarget());
  resolveHashTarget(window.location.hash, false);
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #0f1213; }
  .strategy-page { --ink: #0f1213; --paper: #f5f5f1; --wash: #edf4ea; --green: #69d254; --gray: #686b6c; --gray-light: #b4b6b6; color: var(--ink); overflow: clip; }
  .strategy-hero { padding: 8.4rem 0 3.2rem; background: var(--ink); color: var(--paper); }
  .hero-shell { position: relative; }
  .breadcrumbs { display: flex; gap: .55rem; align-items: center; margin-bottom: clamp(2.2rem, 5vw, 4rem); color: var(--gray-light); font-size: .68rem; letter-spacing: .09em; text-transform: uppercase; }
  .breadcrumbs a { color: inherit; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(18rem, .55fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .eyebrow { color: var(--green); font: 700 .69rem/1.25 Inter, system-ui, sans-serif; letter-spacing: .14em; text-transform: uppercase; }
  .dark-eyebrow { color: var(--ink); }
  h1 { max-width: 11ch; margin-top: 1rem; font: 400 clamp(4.1rem, 8.1vw, 8.3rem)/.84 "Instrument Serif", Georgia, serif; letter-spacing: -.045em; text-wrap: balance; }
  .supporting-line { margin-top: 1.2rem; color: var(--green); font-size: clamp(1.15rem, 2vw, 1.65rem); font-weight: 600; letter-spacing: -.025em; }
  .hero-brief { display: grid; gap: 1.3rem; padding-bottom: .5rem; }
  .hero-brief p { color: rgba(245,245,241,.7); font-size: clamp(.94rem, 1.2vw, 1.08rem); line-height: 1.65; }
  .hero-brief p + p { padding-top: 1.3rem; border-top: 1px solid rgba(245,245,241,.18); color: var(--paper); }
  .update-meta { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; justify-content: space-between; margin-top: 2.2rem; padding-top: 1rem; border-top: 1px solid rgba(245,245,241,.18); color: var(--gray-light); font-size: .73rem; }
  .update-meta time { color: var(--paper); font-weight: 650; }
  .update-meta a { color: var(--green); font-weight: 700; text-decoration: underline; text-underline-offset: .25em; }
  .window-note { max-width: 48rem; margin-top: 1rem; color: var(--gray-light); font-size: .74rem; line-height: 1.55; }
  .timeline-opening { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: clamp(3rem, 7vw, 6rem); border-block: 1px solid rgba(245,245,241,.2); }
  .timeline-opening a { position: relative; display: flex; min-height: 8.7rem; flex-direction: column; padding: 1rem .9rem; border-right: 1px solid rgba(245,245,241,.16); }
  .timeline-opening a:last-child { border-right: 0; }
  .timeline-opening span { color: var(--green); font-size: .65rem; font-variant-numeric: tabular-nums; }
  .timeline-opening strong { margin-top: auto; font-size: .82rem; font-weight: 650; }
  .timeline-opening small { margin-top: .25rem; color: var(--gray-light); font-size: .67rem; line-height: 1.3; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.4rem; align-items: center; margin-top: 1.7rem; }
  .button { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; gap: .65rem; padding: .76rem 1.08rem; border: 1px solid var(--green); border-radius: 999px; background: var(--green); color: var(--ink); font-size: .78rem; font-weight: 750; }
  .button:hover { background: #7cdd68; border-color: #7cdd68; }
  .text-link { color: var(--paper); font-size: .77rem; text-decoration: underline; text-underline-offset: .28em; }
  .principles-section { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--wash); }
  .principles-grid, .method-grid, .reading-grid, .change-grid, .closing-grid { display: grid; grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); gap: clamp(2rem, 8vw, 8rem); }
  h2 { max-width: 15ch; margin-top: .75rem; font: 400 clamp(2.8rem, 5.5vw, 5.3rem)/.94 "Instrument Serif", Georgia, serif; letter-spacing: -.035em; text-wrap: balance; }
  .lead { color: var(--ink); font-size: clamp(1.12rem, 1.8vw, 1.45rem); line-height: 1.5; }
  .principle-list { margin-top: 2rem; border-top: 1px solid rgba(15,18,19,.28); }
  .principle-list article { display: grid; grid-template-columns: 2.8rem 1fr; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid rgba(15,18,19,.18); }
  .principle-list article > span { color: #356c2d; font-size: .68rem; font-weight: 700; }
  .principle-list h3 { font: 600 1rem/1.35 Inter, system-ui, sans-serif; }
