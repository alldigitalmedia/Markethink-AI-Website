---
interface AlternateLink { lang: string; href: string; }
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  siteName?: string;
  favicon?: string;
  lang?: "en" | "es";
  alternates?: AlternateLink[];
  includeSiteEntities?: boolean;
}

const {
  title = "Markethink: Marketing that ships and keeps getting sharper",
  description = "Markethink learns your business, organizes campaigns, creates the work, tracks approvals, and keeps marketing moving every week.",
  image = "/images/hero-image.png",
  canonical,
  type = "website",
  structuredData,
  noindex = false,
  siteName = "Markethink",
  favicon = "/favicon.svg",
  lang = "en",
  alternates = [],
  includeSiteEntities = false,
} = Astro.props;

const siteUrl = "https://markethink.ai";
const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const webPageId = `${canonicalUrl}#webpage`;
const imageUrl = new URL(image, siteUrl).toString();
const organizationRef = { "@id": organizationId };
const websiteRef = { "@id": websiteId };
const webPageRef = { "@id": webPageId };

function markdownPathFor(pathname: string) {
  const cleanPath = pathname.replace(/^\/+|\/+$/g, "");
  return cleanPath ? `/${cleanPath}.md` : "/index.md";
}
const markdownUrl = new URL(markdownPathFor(new URL(canonicalUrl).pathname), siteUrl).toString();
const suppliedNodes = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const pageExtension = suppliedNodes.find((node) => {
  const value = node["@type"];
  const types = Array.isArray(value) ? value : [value];
  return types.some((item) => ["WebPage", "CollectionPage", "ContactPage", "AboutPage"].includes(String(item)));
});
const pageExtensionTypes = pageExtension
  ? (Array.isArray(pageExtension["@type"]) ? pageExtension["@type"] : [pageExtension["@type"]]).filter(Boolean)
  : [];
const pageExtensionProperties = pageExtension
  ? Object.fromEntries(Object.entries(pageExtension).filter(([key]) => !["@context", "@type", "@id", "url", "name", "description", "inLanguage", "publisher"].includes(key)))
  : {};

function normalizedNode(node: Record<string, unknown>, index: number) {
  const { ["@context"]: _context, ...rest } = node;
  const value = rest["@type"];
  const types = (Array.isArray(value) ? value : [value]).filter(Boolean).map(String);
  const primaryType = types[0] ?? "Thing";
  const slug = primaryType.replace(/[^a-z0-9]+/gi, "-").toLowerCase();
  const normalized: Record<string, unknown> = { ...rest, "@id": rest["@id"] ?? `${canonicalUrl}#${slug}-${index + 1}` };
  if (types.includes("BreadcrumbList")) normalized["@id"] = rest["@id"] ?? `${canonicalUrl}#breadcrumb`;
  if (types.includes("FAQPage")) normalized["@id"] = rest["@id"] ?? `${canonicalUrl}#faq`;
  if (types.includes("Service")) normalized["@id"] = rest["@id"] ?? `${canonicalUrl}#service`;
  if (types.includes("ItemList")) normalized["@id"] = rest["@id"] ?? `${canonicalUrl}#itemlist`;
  if (types.some((item) => ["Article", "BlogPosting", "NewsArticle"].includes(item))) {
    normalized.mainEntityOfPage = webPageRef;
    normalized.isPartOf = normalized.isPartOf ?? websiteRef;
    normalized.publisher = normalized.publisher ?? organizationRef;
  }
  if (types.includes("FAQPage") || types.includes("ItemList")) normalized.isPartOf = normalized.isPartOf ?? webPageRef;
  if (types.includes("Service")) {
    normalized.provider = organizationRef;
    normalized.mainEntityOfPage = normalized.mainEntityOfPage ?? webPageRef;
  }
  return normalized;
}

const normalizedSuppliedNodes = suppliedNodes
  .filter((node) => node !== pageExtension)
  .map(normalizedNode);
const organizationNode = {
  "@type": "Organization", "@id": organizationId, name: "Markethink", url: `${siteUrl}/`,
  description: "An AI marketing system managed by expert marketers that learns each business, runs marketing day to day, connects it to the pipeline, and improves with every approval, correction, and result.",
  logo: { "@type": "ImageObject", "@id": `${siteUrl}/#logo`, url: `${siteUrl}/images/logo.svg`, contentUrl: `${siteUrl}/images/logo.svg`, caption: "Markethink" },
  sameAs: ["https://www.linkedin.com/company/markethink-ai/", "https://www.instagram.com/markethink.ai/"],
};
const websiteNode = {
  "@type": "WebSite", "@id": websiteId, url: `${siteUrl}/`, name: "Markethink",
  description: "Your marketing operation, powered by AI and managed by experts.", inLanguage: ["en", "es"], publisher: organizationRef,
};
const webPageNode = {
  "@type": [...new Set(["WebPage", ...pageExtensionTypes.filter((item) => item !== "WebPage")])],
  "@id": webPageId, url: canonicalUrl, name: title, description, inLanguage: lang, isPartOf: websiteRef, about: organizationRef,
  primaryImageOfPage: { "@type": "ImageObject", url: imageUrl, contentUrl: imageUrl }, ...pageExtensionProperties,
};
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [...(includeSiteEntities ? [organizationNode, websiteNode] : []), webPageNode, ...normalizedSuppliedNodes],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    <title>{title}</title>
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    {!noindex && <link rel="describedby" type="text/plain" href={lang === "es" ? "/llms-es.txt" : "/llms.txt"} />}
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
<body>
    <slot />
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import Lenis from "lenis";

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      lenis.on("scroll", ScrollTrigger.update);

      gsap.ticker.add((time: number) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      function initAnimations() {
        gsap.utils.toArray<HTMLElement>(".animate-fade-up").forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, y: 50 },
            {
              opacity: 1,
              y: 0,
              duration: 0.9,
              ease: "power2.out",
              scrollTrigger: {
                trigger: el,
                start: "top 88%",
                toggleActions: "play none none none",
              },
            }
          );
        });

        gsap.utils.toArray<HTMLElement>(".animate-stagger").forEach((container) => {
          const children = container.children;
          gsap.fromTo(
            children,
            { opacity: 0, y: 40, scale: 0.97 },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 0.7,
              stagger: 0.12,
              ease: "power2.out",
              scrollTrigger: {
                trigger: container,
                start: "top 82%",
                toggleActions: "play none none none",
              },
            }
          );
        });

        gsap.utils.toArray<HTMLElement>(".animate-scale-in").forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, scale: 0.92 },
            {
              opacity: 1,
              scale: 1,
              duration: 0.9,
              ease: "power2.out",
              scrollTrigger: {
                trigger: el,
                start: "top 85%",
                toggleActions: "play none none none",
              },
            }
          );
        });

        gsap.utils.toArray<HTMLElement>(".animate-parallax").forEach((el) => {
          gsap.fromTo(
            el,
            { y: -20 },
            {
              y: 20,
              ease: "none",
              scrollTrigger: {
                trigger: el,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
              },
            }
          );
        });
      }

      function initNavbar() {
        const navbar = document.querySelector(".navbar") as HTMLElement | null;
        if (!navbar) return;

        ScrollTrigger.create({
          start: 40,
          onUpdate: (self) => {
            navbar.style.backgroundColor = self.direction === 1 || self.progress > 0
              ? "rgba(15, 18, 19, 0.92)"
              : "rgba(15, 18, 19, 0.8)";
          },
        });
      }


      function summarizeFormValue(value: FormDataEntryValue) {
        if (typeof value === "string") return value;
        const file = value as File;
        return file && file.name ? `[file] ${file.name}` : "[file attached]";
      }

      function formFields(formData: FormData) {
        const fields: Record<string, string | string[]> = {};
        formData.forEach((value, key) => {
          const rendered = summarizeFormValue(value);
          if (!rendered) return;
          const existing = fields[key];
          if (Array.isArray(existing)) {
            existing.push(rendered);
          } else if (typeof existing === "string") {
            fields[key] = [existing, rendered];
          } else {
            fields[key] = rendered;
          }
        });
        return fields;
      }

      function notifyMarkethinkFormSubmission(form: HTMLFormElement) {
        const formData = new FormData(form);
        const formName = form.getAttribute("name") || String(formData.get("form-name") || "markethink-website-form");
        const payload = {
          clientId: "markethink",
          formName,
          pageUrl: window.location.href,
          submittedAt: new Date().toISOString(),
          fields: formFields(formData),
        };

        fetch("https://dashboard.markethink.ai/api/public/website-form-submissions", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          keepalive: true,
        }).catch(() => {
          // Netlify remains the source of truth for the form submission. The
          // alert copy is best-effort so a notification issue never blocks the lead.
        });
      }

      function initFormNotifications() {
        document.querySelectorAll<HTMLFormElement>('form[data-netlify="true"], form[netlify]').forEach((form) => {
          if (form.dataset.markethinkNotifyAttached === "true") return;
          form.dataset.markethinkNotifyAttached = "true";
          form.addEventListener("submit", () => notifyMarkethinkFormSubmission(form));
        });
      }

      function init() {
        initAnimations();
        initNavbar();
        initFormNotifications();
      }

      document.addEventListener("DOMContentLoaded", init);
      if (document.readyState !== "loading") {
        init();
      }
    </script>
    <style is:global>
      :root {
        --bg-primary: #0f1213;
        --bg-secondary: #171b1c;
        --tabs-bg: #f5f5f1;
        --text-primary: #0f1213;
        --text-invert: #f5f5f1;
        --color-secondary: #69d254;
        --neutral-200: rgba(15, 18, 19, 0.08);
        --radius-medium: 1.5rem;
        --radius-button: 999px;
        --font-body: "Inter", system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        background: var(--bg-primary);
        color: var(--text-invert);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        color: inherit;
      }

      .container {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
      }

      .section {
        padding: 7rem 0;
      }

      .section.light-green {
        background: #edf4ea;
        color: var(--text-primary);
      }

      .section.dark {
        background: var(--bg-primary);
      }

      .subtitle {
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.55);
      }

      .section.light-green .subtitle {
        color: rgba(15, 18, 19, 0.5);
      }

      h1, h2, h3, h4, h5 {
        font-family: "Instrument Serif", Georgia, serif;
        font-weight: 400;
      }

      h2 {
        font-size: clamp(2rem, 4vw, 3.4rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
      }

      .text-center {
        text-align: center;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.9rem 1.4rem;
        border-radius: var(--radius-button);
        background: var(--color-secondary);
        color: #0f1213;
        font-size: 0.9rem;
        font-weight: 600;
        border: 1px solid transparent;
        transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, color 0.25s ease;
      }

      .button:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(105, 210, 84, 0.18);
      }

      .button.is-secondary {
        background: transparent;
        color: var(--text-invert);
        border-color: rgba(255, 255, 255, 0.18);
      }

      .section.light-green .button.is-secondary {
        color: var(--text-primary);
        border-color: rgba(15, 18, 19, 0.12);
      }

      @media (max-width: 767px) {
        .section {
          padding: 4.5rem 0;
        }
      }
    </style>
  </body>
</html>
