79|<script>
80|  import { gsap } from "gsap";
81|  import { ScrollTrigger } from "gsap/ScrollTrigger";
82|
83|  gsap.registerPlugin(ScrollTrigger);
84|
85|  function initReviewStory() {
86|    const root = document.querySelector<HTMLElement>("[data-scroll-story]");
87|    if (!root || root.dataset.ready === "true") return;
88|    root.dataset.ready = "true";
89|
90|    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-story-panel]"));
91|    const visuals = Array.from(root.querySelectorAll<HTMLElement>("[data-story-visual]"));
92|    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-story-dot]"));
93|
94|    if (window.matchMedia("(max-width: 860px)").matches) {
95|      panels.forEach((panel) => panel.removeAttribute("style"));
96|      visuals.forEach((visual) => visual.removeAttribute("style"));
97|      return;
98|    }
99|
100|    let active = -1;
101|
102|    const show = (next: number) => {
103|      if (next === active) return;
104|      gsap.killTweensOf([...panels, ...visuals]);
105|      panels.forEach((panel, index) => {
106|        panel.classList.toggle("is-active", index === next);
107|        if (index !== next) gsap.set(panel, { opacity: 0, y: 0 });
108|      });
109|      visuals.forEach((visual, index) => {
110|        visual.classList.toggle("is-active", index === next);
111|        if (index !== next) gsap.set(visual, { opacity: 0, scale: 1 });
112|      });
113|      dots.forEach((dot, index) => dot.classList.toggle("is-active", index === next));
114|      if (panels[next]) {
115|        gsap.set(panels[next], { opacity: 1 });
116|        gsap.fromTo(panels[next], { y: 14 }, { y: 0, duration: 0.35, ease: "power2.out" });
117|      }
118|      if (visuals[next]) {
119|        gsap.set(visuals[next], { opacity: 1 });
120|        gsap.fromTo(visuals[next], { scale: 1.012 }, { scale: 1, duration: 0.45, ease: "power2.out" });
121|      }
122|      active = next;
123|    };
124|
125|    const indexFromProgress = (progress: number) => Math.min(Math.floor(progress * panels.length), panels.length - 1);
126|    show(0);
127|
128|    const trigger = ScrollTrigger.create({
129|      trigger: root,
130|      start: "top top",
131|      end: "bottom bottom",
132|      invalidateOnRefresh: true,
133|      onUpdate: (self) => show(indexFromProgress(self.progress)),
134|      onRefresh: (self) => show(indexFromProgress(self.progress)),
135|    });
136|
137|    show(indexFromProgress(trigger.progress));
138|    requestAnimationFrame(() => ScrollTrigger.refresh());
139|  }
140|
141|  document.addEventListener("DOMContentLoaded", initReviewStory);
142|  if (document.readyState !== "loading") initReviewStory();
143|</script>
