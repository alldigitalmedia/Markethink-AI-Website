---
interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props;
const isSpanish = lang === "es";
const steps = isSpanish ? [
  { eyebrow: "Día 1", title: "Aprendemos tu negocio", description: "Conocemos tu sitio web, canales sociales, ofertas, voz y prioridades. Luego conectamos los canales incluidos en tu alcance.", bullets: [], image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-day1-v1.webp", alt: "Markethink organiza el contexto del negocio en una base de marketing" },
  { eyebrow: "Semana 1", title: "Llega el primer trabajo", description: "Responde con palabras simples o una nota de voz. El trabajo se revisa y el sistema recuerda por qué. La publicación sigue las reglas de aprobación que defines.", bullets: [], image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-week1-v1.webp", alt: "Trabajo de campaña organizado en un espacio conectado de Markethink" },
  { eyebrow: "Cada semana", title: "La operación avanza", description: "Calendario ejecutado, páginas publicadas y seguimiento activo en tus canales conectados. Aprobaciones desde tu teléfono.", bullets: [], image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-weekly-v1.webp", alt: "Trabajo de marketing que avanza por revisión, aprobación y seguimiento" },
  { eyebrow: "Mientras continúa el trabajo", title: "El contexto se acumula", description: "Cada aprobación, corrección y resultado suma. El trabajo del mes 6 es más preciso que el del mes 1.", bullets: [], image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-compounds-v1.webp", alt: "Markethink aplica el contexto acumulado del negocio a campañas futuras" },
] : [
  { eyebrow: "Day 1", title: "We learn your business", description: "We get to understand your website, social channels, offers, voice, and priorities. Then we connect the channels included in your scope.", bullets: [], image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-day1-v1.webp", alt: "Markethink organizing business context into a marketing foundation" },
  { eyebrow: "Week 1", title: "First work arrives", description: "Reply in plain words or a voice note. It revises, and remembers why. Publishing follows the approval rules you set.", bullets: [], image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-week1-v1.webp", alt: "Campaign work organized in one connected Markethink workspace" },
  { eyebrow: "Every week", title: "The operation runs", description: "Calendar executed, pages shipped, follow-up running through your connected channels. Approvals from your phone.", bullets: [], image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-weekly-v1.webp", alt: "Marketing work moving through review, approval, and follow-up" },
  { eyebrow: "As the work continues", title: "Its context compounds", description: "Every approval, correction, and result compounds. Month 6 output is sharper than month 1.", bullets: [], image: "https://dashboard.markethink.ai/generated/landing/markethink/markethink/homepage-v6-vivid-compounds-v1.webp", alt: "Markethink applying accumulated business context to future campaigns" },
];
---

<section class="story-intro" id="how-it-works" aria-labelledby="first-month-title" data-story-intro>
  <div class="story-intro-inner">
    <p>{isSpanish ? "Cómo funciona" : "How it works"}</p>
    <h2 id="first-month-title">{isSpanish ? "Tus primeros 30 días" : "Your first 30 days"}</h2>
  </div>
</section>

<section class="story" data-scroll-story>
  <div class="story-pin">
    <div class="story-shell">
      <div class="story-copy" aria-live="polite">
        {steps.map((step, index) => (
          <article class={`story-panel ${index === 0 ? "is-active" : ""}`} data-story-panel={index}>
            <p class="story-eyebrow"><span>{String(index + 1).padStart(2, "0")}</span>{step.eyebrow}</p>
            <h2>{step.title}</h2>
            <p class="story-description">{step.description}</p>
            <ul>
              {step.bullets.map((bullet) => <li><i aria-hidden="true"></i>{bullet}</li>)}
            </ul>
          </article>
        ))}
        <div class="story-progress" aria-hidden="true">
          {steps.map((_, index) => <span class={index === 0 ? "is-active" : ""} data-story-dot={index}></span>)}
        </div>
      </div>

      <div class="story-stage" data-story-stage>
        {steps.map((step, index) => (
          <figure class={`story-visual ${index === 0 ? "is-active" : ""}`} data-story-visual={index}>
            <img src={step.image} alt={step.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
            <figcaption>
              <span class="visual-status"><i></i>{step.eyebrow}</span>
              <strong>{step.title}</strong>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initReviewStory() {
    const root = document.querySelector<HTMLElement>("[data-scroll-story]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-story-panel]"));
    const visuals = Array.from(root.querySelectorAll<HTMLElement>("[data-story-visual]"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-story-dot]"));
    const intro = document.querySelector<HTMLElement>("[data-story-intro]");
    const stage = root.querySelector<HTMLElement>("[data-story-stage]");

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      intro?.style.setProperty("--story-theme-duration", "0.01ms");
      root.style.setProperty("--story-theme-duration", "0.01ms");
    }

    const setSectionTheme = (isLight: boolean) => {
      intro?.classList.toggle("is-light", isLight);
      root.classList.toggle("is-light", isLight);
    };

    const introParts = intro
      ? Array.from(intro.querySelectorAll<HTMLElement>(".story-intro-inner > *"))
      : [];
    const mobile = window.matchMedia("(max-width: 860px)").matches;
    const cardsThemeTrigger = mobile ? panels[0] : stage;

    if (cardsThemeTrigger) ScrollTrigger.create({
      trigger: cardsThemeTrigger,
      start: "top 96%",
      endTrigger: root,
      end: "bottom top",
      invalidateOnRefresh: true,
      onEnter: () => setSectionTheme(true),
      onLeaveBack: () => setSectionTheme(false),
      onRefresh: (self) => setSectionTheme(self.progress > 0 || self.isActive),
    });

    if (!prefersReducedMotion && intro && introParts.length) {
      const introTimeline = gsap.timeline({ paused: true })
        .fromTo(introParts[0], { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.55, ease: "power3.out" })
        .fromTo(introParts[1], { autoAlpha: 0, y: 34 }, { autoAlpha: 1, y: 0, duration: 0.72, ease: "power3.out" }, "-=0.34");

      ScrollTrigger.create({
        trigger: intro,
        start: "top 82%",
        end: "bottom 12%",
        invalidateOnRefresh: true,
        onEnter: () => introTimeline.play(),
        onLeave: () => introTimeline.reverse(),
        onEnterBack: () => introTimeline.play(),
        onLeaveBack: () => introTimeline.reverse(),
        onRefresh: (self) => self.isActive ? introTimeline.progress(1) : undefined,
      });
    }

    const panelParts = (panel: HTMLElement) => Array.from(panel.querySelectorAll<HTMLElement>(
      ".story-eyebrow, h2, .story-description, li"
    ));
    const visualParts = (visual: HTMLElement) => ({
      image: visual.querySelector<HTMLElement>("img"),
      caption: visual.querySelector<HTMLElement>("figcaption"),
      status: visual.querySelector<HTMLElement>(".visual-status"),
      title: visual.querySelector<HTMLElement>("figcaption strong"),
    });

    if (mobile) {
      panels.forEach((panel) => {
        panel.removeAttribute("style");
        if (prefersReducedMotion) return;
        const parts = panelParts(panel);
        const timeline = gsap.timeline({ paused: true })
          .fromTo(panel, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.42, ease: "power2.out" })
          .fromTo(parts, { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.42, stagger: 0.08, ease: "power2.out" }, "-=0.22");
        ScrollTrigger.create({
          trigger: panel,
          start: "top 88%",
          end: "bottom 12%",
          onEnter: () => timeline.play(),
          onLeave: () => timeline.reverse(),
          onEnterBack: () => timeline.play(),
          onLeaveBack: () => timeline.reverse(),
        });
      });
      visuals.forEach((visual) => visual.removeAttribute("style"));
      requestAnimationFrame(() => ScrollTrigger.refresh());
      return;
    }

    let active = -1;
    let transition: gsap.core.Timeline | null = null;

    const show = (next: number) => {
      if (next === active) return;
      transition?.kill();

      const previous = active;
      panels.forEach((panel, index) => {
        if (index === previous) return;
        panel.classList.remove("is-active");
        gsap.set(panel, { autoAlpha: 0 });
      });
      visuals.forEach((visual, index) => {
        if (index === previous) return;
        visual.classList.remove("is-active");
        gsap.set(visual, { autoAlpha: 0 });
      });

      const incomingPanel = panels[next];
      const incomingVisual = visuals[next];
      const incomingParts = incomingPanel ? panelParts(incomingPanel) : [];
      const incomingVisualParts = incomingVisual ? visualParts(incomingVisual) : null;
      const outgoingPanel = previous >= 0 ? panels[previous] : null;
      const outgoingVisual = previous >= 0 ? visuals[previous] : null;
      const outgoingParts = outgoingPanel ? panelParts(outgoingPanel) : [];
      const outgoingVisualParts = outgoingVisual ? visualParts(outgoingVisual) : null;

      transition = gsap.timeline({ defaults: { overwrite: true } });

      if (outgoingPanel && outgoingVisual && !prefersReducedMotion) {
        transition
          .to([...outgoingParts].reverse(), { autoAlpha: 0, y: -14, duration: 0.2, stagger: 0.035, ease: "power2.in" }, 0)
          .to(outgoingVisualParts?.title || [], { autoAlpha: 0, y: -8, duration: 0.16 }, 0)
          .to(outgoingVisualParts?.status || [], { autoAlpha: 0, y: -8, duration: 0.16 }, 0.04)
          .to(outgoingVisualParts?.caption || [], { autoAlpha: 0, y: 14, duration: 0.2 }, 0.08)
          .to(outgoingVisualParts?.image || [], { autoAlpha: 0, scale: 0.985, duration: 0.28, ease: "power2.in" }, 0)
          .add(() => {
            outgoingPanel.classList.remove("is-active");
            outgoingVisual.classList.remove("is-active");
            gsap.set([outgoingPanel, outgoingVisual], { autoAlpha: 0 });
          }, 0.28);
      } else if (outgoingPanel && outgoingVisual) {
        outgoingPanel.classList.remove("is-active");
        outgoingVisual.classList.remove("is-active");
        gsap.set([outgoingPanel, outgoingVisual], { autoAlpha: 0 });
      }

      if (incomingPanel && incomingVisual) {
        const enterAt = previous >= 0 && !prefersReducedMotion ? 0.2 : 0;
        incomingPanel.classList.add("is-active");
        incomingVisual.classList.add("is-active");
        gsap.set([incomingPanel, incomingVisual], { autoAlpha: 1 });

        if (!prefersReducedMotion) {
          gsap.set(incomingParts, { autoAlpha: 0, y: 18 });
          gsap.set(incomingVisualParts?.image || [], { autoAlpha: 0, scale: 1.025 });
          gsap.set(incomingVisualParts?.caption || [], { autoAlpha: 0, y: 18 });
          gsap.set([incomingVisualParts?.status, incomingVisualParts?.title].filter(Boolean), { autoAlpha: 0, y: 10 });
          transition
            .to(incomingVisualParts?.image || [], { autoAlpha: 1, scale: 1, duration: 0.6, ease: "power3.out" }, enterAt)
            .to(incomingParts, { autoAlpha: 1, y: 0, duration: 0.46, stagger: 0.08, ease: "power3.out" }, enterAt + 0.04)
            .to(incomingVisualParts?.caption || [], { autoAlpha: 1, y: 0, duration: 0.42, ease: "power3.out" }, enterAt + 0.18)
            .to(incomingVisualParts?.status || [], { autoAlpha: 1, y: 0, duration: 0.32 }, enterAt + 0.3)
            .to(incomingVisualParts?.title || [], { autoAlpha: 1, y: 0, duration: 0.36 }, enterAt + 0.38);
        } else {
          gsap.set([...incomingParts, incomingVisualParts?.image, incomingVisualParts?.caption, incomingVisualParts?.status, incomingVisualParts?.title].filter(Boolean), { clearProps: "all" });
        }
      }

      dots.forEach((dot, index) => dot.classList.toggle("is-active", index === next));
      if (!prefersReducedMotion) {
        transition.fromTo(dots, { autoAlpha: 0.3, scaleX: 0.72 }, { autoAlpha: 1, scaleX: 1, duration: 0.28, stagger: 0.045, ease: "power2.out" }, previous >= 0 ? 0.28 : 0.22);
      }
      active = next;
    };

    const indexFromProgress = (progress: number) => Math.min(Math.floor(progress * panels.length), panels.length - 1);
    show(0);

    const trigger = ScrollTrigger.create({
      trigger: root,
      start: "top top",
      end: "bottom bottom",
      invalidateOnRefresh: true,
      onUpdate: (self) => show(indexFromProgress(self.progress)),
      onRefresh: (self) => show(indexFromProgress(self.progress)),
    });

    show(indexFromProgress(trigger.progress));
    requestAnimationFrame(() => ScrollTrigger.refresh());
  }

  document.addEventListener("DOMContentLoaded", initReviewStory);
  if (document.readyState !== "loading") initReviewStory();
</script>

<style>
  .story-intro {
    --story-theme-duration: 0.75s;
    position: relative;
    overflow: hidden;
    padding: clamp(3.25rem, 5vw, 4.5rem) 0 clamp(0.75rem, 1.4vw, 1.25rem);
    background: #0f1213;
    color: #f5f5f1;
    transition:
      background-color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1),
      color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story-intro::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 85% 18%, rgba(105, 210, 84, 0.14), transparent 30rem);
    pointer-events: none;
  }

  .story-intro.is-light {
    background: #f5f5f1;
    color: #0f1213;
  }

  .story-intro-inner {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .story-intro p {
    margin: 0 0 0.8rem;
    color: #69d254;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story-intro.is-light p {
    color: #315b28;
  }

  .story-intro h2 {
    max-width: 44rem;
    margin: 0 auto;
    color: #f5f5f1;
    font-family: "Instrument Serif", Georgia, serif;
    font-size: clamp(2.8rem, 4.6vw, 4.25rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.045em;
    transition: color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story-intro.is-light h2 {
    color: #0f1213;
  }

  .story {
    --story-theme-duration: 0.75s;
    min-height: 400vh;
    background: #0f1213;
    color: #f5f5f1;
    transition:
      background-color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1),
      color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story.is-light {
    background: #f5f5f1;
    color: #0f1213;
  }

  .story-pin {
    position: sticky;
    top: 0;
    box-sizing: border-box;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 2vw, 2rem) 0;
    overflow: hidden;
  }

  .story-pin::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 85% 18%, rgba(105, 210, 84, 0.14), transparent 30rem);
    pointer-events: none;
  }

  .story-shell {
    position: relative;
    width: min(1320px, calc(100% - 2rem));
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(32rem, 1.24fr);
    gap: clamp(2.25rem, 4vw, 4.5rem);
    align-items: center;
  }

  .story-copy {
    position: relative;
    min-height: 31rem;
    display: flex;
    align-items: center;
  }

  .story-panel {
    position: absolute;
    inset-inline: 0;
    opacity: 0;
    pointer-events: none;
  }

  .story-panel.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .story-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(245, 245, 241, 0.58);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    transition: color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story.is-light .story-eyebrow {
    color: rgba(15, 18, 19, 0.58);
  }

  .story-eyebrow span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #69d254;
    color: #0f1213;
    letter-spacing: 0;
  }

  .story-panel h2 {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: #f5f5f1;
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.7rem, 4.2vw, 4.25rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
    transition: color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story.is-light .story-panel h2 {
    color: #0f1213;
  }

  .story-description {
    max-width: 34rem;
    margin-top: 1.35rem;
    color: rgba(245, 245, 241, 0.68);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.72;
    transition: color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story.is-light .story-description {
    color: rgba(15, 18, 19, 0.68);
  }

  .story-panel ul {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.6rem;
    list-style: none;
  }

  .story-panel li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: rgba(245, 245, 241, 0.78);
    font-size: 0.88rem;
    transition: color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story.is-light .story-panel li {
    color: rgba(15, 18, 19, 0.78);
  }

  .story-panel li i {
    width: 2.7rem;
    height: 1px;
    background: rgba(105, 210, 84, 0.58);
  }

  .story-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    gap: 0.45rem;
  }

  .story-progress span {
    width: 2.3rem;
    height: 2px;
    background: rgba(245, 245, 241, 0.16);
    transition:
      background var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1),
      width 0.3s ease;
  }

  .story.is-light .story-progress span {
    background: rgba(15, 18, 19, 0.16);
  }

  .story-progress span.is-active,
  .story.is-light .story-progress span.is-active {
    width: 4.5rem;
    background: #69d254;
  }

  .story-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1.08;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 1.9rem;
    background: #171b1c;
    box-shadow: 0 12px 38px rgba(0, 0, 0, 0.2);
    transition:
      border-color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story.is-light .story-stage {
    border-color: rgba(15, 18, 19, 0.12);
    box-shadow: 0 10px 32px rgba(15, 18, 19, 0.09);
  }

  .story-visual {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .story-visual.is-active {
    opacity: 1;
  }

  .story-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(10, 13, 14, 0.9) 100%);
  }

  .story-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-visual figcaption {
    position: absolute;
    z-index: 2;
    inset: auto 1.35rem 1.25rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    align-items: end;
    padding: 1rem 1.05rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 1rem;
    background: rgba(15, 18, 19, 0.82);
    color: #f5f5f1;
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(18px);
  }

  .visual-status {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: #69d254;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .visual-status i {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #69d254;
    box-shadow: 0 0 0 0.25rem rgba(105, 210, 84, 0.12);
  }

  .story-visual figcaption strong {
    color: #f5f5f1;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.35;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.32);
  }

  .story-visual figcaption small {
    color: rgba(245, 245, 241, 0.52);
    font-size: 0.68rem;
  }

  @media (min-width: 861px) and (max-width: 1080px) {
    .story-shell {
      grid-template-columns: minmax(0, 0.82fr) minmax(28rem, 1.18fr);
      gap: 2rem;
    }
  }

  @media (max-width: 860px) {
    .story-intro {
      padding: 3rem 0 1.25rem;
    }

    .story-intro h2 {
      font-size: 2.5rem;
      line-height: 1;
    }

    .story {
      min-height: auto;
    }

    .story-pin {
      position: static;
      display: block;
      padding: 3rem 0;
      overflow: visible;
    }

    .story-shell {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .story-copy {
      display: grid;
      gap: 1rem;
      min-height: auto;
    }

    .story-panel {
      position: relative;
      opacity: 1;
      pointer-events: auto;
      padding: 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 1.2rem;
      background: #171b1c;
      transition:
        background-color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1),
        border-color var(--story-theme-duration) cubic-bezier(0.22, 1, 0.36, 1);
    }

    .story.is-light .story-panel {
