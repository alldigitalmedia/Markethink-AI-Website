45|<section class="story" data-scroll-story>
46|  <div class="story-pin">
47|    <div class="story-shell">
48|      <div class="story-copy" aria-live="polite">
49|        {steps.map((step, index) => (
50|          <article class={`story-panel ${index === 0 ? "is-active" : ""}`} data-story-panel={index}>
51|            <p class="story-eyebrow"><span>{String(index + 1).padStart(2, "0")}</span>{step.eyebrow}</p>
52|            <h2>{step.title}</h2>
53|            <p class="story-description">{step.description}</p>
54|            <ul>
55|              {step.bullets.map((bullet) => <li><i aria-hidden="true"></i>{bullet}</li>)}
56|            </ul>
57|          </article>
58|        ))}
59|        <div class="story-progress" aria-hidden="true">
60|          {steps.map((_, index) => <span class={index === 0 ? "is-active" : ""} data-story-dot={index}></span>)}
61|        </div>
62|      </div>
63|
64|      <div class="story-stage">
65|        {steps.map((step, index) => (
66|          <figure class={`story-visual ${index === 0 ? "is-active" : ""}`} data-story-visual={index}>
67|            <img src={step.image} alt={step.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
68|            <figcaption>
69|              <span class="visual-status"><i></i>{step.eyebrow}</span>
70|              <strong>{step.title}</strong>
71|            </figcaption>
72|          </figure>
73|        ))}
74|      </div>
75|    </div>
76|  </div>
77|</section>
