  .logo-guide-section h3 { font-family: var(--font-display); font-weight: 400; }
  .logo-guide-section > p:not(.guide-eyebrow) { max-width: 760px; color: #d2d4d1; font-size: 1.08rem; line-height: 1.8; }
  .guide-eyebrow { margin: 0 0 .85rem; color: #69d254; font: 700 .76rem/1.2 var(--font-body); letter-spacing: .16em; text-transform: uppercase; }
