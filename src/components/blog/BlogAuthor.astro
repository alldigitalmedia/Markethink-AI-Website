---
import type { ResolvedBlogAuthor } from "../../data/blogAuthors";

type Props = {
  author: ResolvedBlogAuthor;
  lang?: "en" | "es";
  theme?: "light" | "dark";
};

const { author, lang = "en", theme = "light" } = Astro.props;
const isSpanish = lang === "es";
const profileHref = author.url?.startsWith("https://markethink.ai/")
  ? new URL(author.url).pathname
  : author.url;
const externalProfileUrl = author.sameAs.find((url) => url !== author.url);
---

<section
  class:list={["blog-author", { "blog-author--with-avatar": author.avatarImage, "blog-author--dark": theme === "dark" }]}
  data-blog-author
  aria-labelledby="blog-author-name"
>
  {
    author.avatarImage && (
      <img
        class="blog-author__avatar"
        src={author.avatarImage.path}
        alt=""
        width={author.avatarImage.width}
        height={author.avatarImage.height}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
    )
  }
  <div class="blog-author__content">
    <p class="blog-author__eyebrow">{isSpanish ? "Sobre el autor" : "About the author"}</p>
    <h2 id="blog-author-name">
      {profileHref ? <a class="blog-author__name-link" href={profileHref}>{author.name}</a> : author.name}
    </h2>
    <p class="blog-author__title">{author.title}</p>
    {author.bio && <p class="blog-author__bio">{author.bio}</p>}
    {
      externalProfileUrl && (
        <a class="blog-author__link" href={externalProfileUrl} rel="me external">
          {author.linkLabel ?? (isSpanish ? "Ver perfil del autor" : "View author profile")}
        </a>
      )
    }
  </div>
</section>

<style>
  .blog-author {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    width: 100%;
    min-width: 0;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding: clamp(1.6rem, 4vw, 2.25rem) 0 0;
    border-top: 1px solid rgba(49, 91, 40, 0.34);
    color: #0f1213;
  }

  .blog-author--with-avatar {
    grid-template-columns: 4.5rem minmax(0, 1fr);
  }

  .blog-author__avatar {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid rgba(49, 91, 40, 0.28);
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }

  .blog-author__content {
    min-width: 0;
  }

  .blog-author__eyebrow {
    margin: 0 0 0.75rem;
    color: #315b28;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .blog-author h2 {
    margin: 0;
    color: #0f1213;
    font: 600 clamp(1.5rem, 3vw, 1.75rem)/1.15 Inter, system-ui, sans-serif;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .blog-author__name-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(49, 91, 40, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .blog-author__name-link:hover {
    color: #315b28;
    text-decoration-color: currentColor;
  }

  .blog-author__title {
    margin: 0.35rem 0 0;
    color: #315b28;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .blog-author__bio {
    max-width: 42rem;
    margin: 0.9rem 0 0;
    color: #4e554f;
    font-size: clamp(1rem, 1.7vw, 1.0625rem);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .blog-author__link {
    display: inline-flex;
    margin-top: 1rem;
    color: #315b28;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .blog-author__link:hover {
    color: #0f1213;
  }

  .blog-author__name-link:focus-visible,
  .blog-author__link:focus-visible {
    outline: 3px solid #315b28;
    outline-offset: 4px;
    border-radius: 0.15rem;
  }

  .blog-author--dark {
    color: #f5f5f1;
  }

  .blog-author--dark .blog-author__eyebrow,
  .blog-author--dark .blog-author__title,
  .blog-author--dark .blog-author__link {
    color: #9be68d;
  }

  .blog-author--dark h2,
  .blog-author--dark .blog-author__name-link {
    color: #f5f5f1;
  }

  .blog-author--dark .blog-author__bio {
    color: rgba(245, 245, 241, 0.78);
  }

  .blog-author--dark .blog-author__name-link:hover,
  .blog-author--dark .blog-author__link:hover {
    color: #ffffff;
  }

  @media (max-width: 480px) {
    .blog-author--with-avatar {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .blog-author__avatar {
      width: 4rem;
      height: 4rem;
    }
  }

  @media (max-width: 350px) {
    .blog-author {
      padding-top: 1.4rem;
    }
  }
</style>
