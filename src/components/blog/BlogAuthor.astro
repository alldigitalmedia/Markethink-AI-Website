---
import type { ResolvedBlogAuthor } from "../../data/blogAuthors";

type Props = {
  author: ResolvedBlogAuthor;
};

const { author } = Astro.props;
---

<section
  class="blog-author"
  data-blog-author
  aria-labelledby="blog-author-name"
>
  <p class="blog-author__eyebrow">About the author</p>
  <h2 id="blog-author-name">{author.name}</h2>
  <p class="blog-author__title">{author.title}</p>
  {author.bio && <p class="blog-author__bio">{author.bio}</p>}
  {
    author.url && (
      <a class="blog-author__link" href={author.url} rel="me external">
        {author.linkLabel ?? "View author profile"}
      </a>
    )
  }
</section>

<style>
  .blog-author {
    width: 100%;
    min-width: 0;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding: clamp(1.6rem, 4vw, 2.25rem) 0 0;
    border-top: 1px solid rgba(49, 91, 40, 0.34);
    color: #0f1213;
  }

  .blog-author__eyebrow {
    margin: 0 0 0.75rem;
    color: #315b28;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .blog-author h2 {
    margin: 0;
    color: #0f1213;
    font: 600 clamp(1.5rem, 3vw, 1.75rem)/1.15 Inter, system-ui, sans-serif;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .blog-author__title {
    margin: 0.35rem 0 0;
    color: #315b28;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .blog-author__bio {
    max-width: 42rem;
    margin: 0.9rem 0 0;
    color: #4e554f;
    font-size: clamp(1rem, 1.7vw, 1.0625rem);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .blog-author__link {
    display: inline-flex;
    margin-top: 1rem;
    color: #315b28;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .blog-author__link:hover {
    color: #0f1213;
  }

  .blog-author__link:focus-visible {
    outline: 3px solid #315b28;
    outline-offset: 4px;
    border-radius: 0.15rem;
  }

  @media (max-width: 350px) {
    .blog-author {
      padding-top: 1.4rem;
    }
  }
</style>
