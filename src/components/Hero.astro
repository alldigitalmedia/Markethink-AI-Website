---
const trialHref = "/trial/";
const walkthroughHref = "/schedule-a-walkthrough/";
---

<section class="section-hero" id="hero">
  <figure class="hero-background" aria-hidden="true">
    <img
      src="/images/hero-phone-workspace.svg"
      width="1280"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </figure>

  <div class="container hero-content">
    <div class="hero-copy">
      <p class="hero-kicker"><span aria-hidden="true">✦</span> AI marketing system managed by expert marketers</p>

      <h1 class="hero-heading" aria-label="Grow your business with Markethink.">
        <span class="hero-heading-line">Grow your business</span><br />with <em>Markethink.</em>
      </h1>

      <p class="hero-description">
        <strong>An AI marketing system managed by expert marketers.</strong> It learns and remembers your business, runs your marketing day to day, connects campaigns to leads, CRM, follow-up, and conversion, and improves with every approval, correction, and result.
      </p>

      <ul class="hero-scope" aria-label="Marketing services and pipeline capabilities">
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect x="3" y="5" width="26" height="22" rx="3"></rect>
            <path d="M3 11h26"></path>
            <circle cx="16" cy="19" r="5"></circle>
            <path d="M11 19h10M16 14c1.4 1.5 2.1 3.2 2.1 5S17.4 22.5 16 24M16 14c-1.4 1.5-2.1 3.2-2.1 5s.7 3.5 2.1 5"></path>
          </svg>
          <span>Website</span>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M5 7h22a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H14l-6 4v-4H5a3 3 0 0 1-3-3V10a3 3 0 0 1 3-3Z"></path>
            <circle cx="10" cy="16" r="1.5"></circle>
            <circle cx="16" cy="16" r="1.5"></circle>
            <circle cx="22" cy="16" r="1.5"></circle>
            <path d="M11.5 16h3M17.5 16h3"></path>
          </svg>
          <span>Social</span>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M6 3h14l6 6v18H6Z"></path>
            <path d="M20 3v7h6M10 15h8M10 20h6M19 25l8-8 2 2-8 8-4 1Z"></path>
          </svg>
          <span>Content</span>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M4 13h6l13-6v18l-13-6H4Z"></path>
            <path d="M10 19l2 8H8l-2-8M26 12c2 1 3 2.3 3 4s-1 3-3 4"></path>
          </svg>
          <span>Campaigns</span>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="14" cy="18" r="10"></circle>
            <circle cx="14" cy="18" r="5"></circle>
            <path d="m14 18 9-9M20 9h5v5M24 22v6M21 25h6"></path>
          </svg>
          <span>Advertising</span>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="11" cy="10" r="4"></circle>
            <circle cx="23" cy="11" r="3"></circle>
            <path d="M3 27v-4c0-4 3-7 8-7s8 3 8 7v4M19 18c4 0 7 2 7 6v3M27 4v6M24 7h6"></path>
          </svg>
          <span>Leads</span>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <ellipse cx="16" cy="7" rx="11" ry="4"></ellipse>
            <path d="M5 7v8c0 2.2 5 4 11 4s11-1.8 11-4V7M5 15v8c0 2.2 5 4 11 4s11-1.8 11-4v-8"></path>
            <path d="M10 12h12M10 21h12"></path>
          </svg>
          <span>CRM</span>
        </li>
      </ul>

      <div class="button-group">
        <a href={walkthroughHref} class="button">
          Book a Walkthrough
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"></path></svg>
        </a>
        <a href={trialHref} class="button is-secondary">
          <span class="play-icon" aria-hidden="true">▶</span>
          Watch it work on your business
        </a>
      </div>
    </div>
    <div class="hero-mobile-visual-spacer" aria-hidden="true"></div>

  </div>
</section>

<style>
  .section-hero {
    min-height: min(100svh, 54rem);
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: clamp(8.2rem, 13vh, 9.4rem) 0 clamp(3.5rem, 6vh, 5rem);
    background: #f5f5f1;
    color: #0f1213;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 252, 0.96) 0%,
      rgba(255, 255, 252, 0.9) 27%,
      rgba(255, 255, 252, 0.55) 42%,
      rgba(255, 255, 252, 0.08) 56%,
      rgba(255, 255, 252, 0) 68%
    );
  }

  .hero-background img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(1260px, calc(100% - 2rem));
  }

  .hero-copy {
    max-width: min(32rem, 40%);
    transform: translateY(-0.75rem);
    text-align: left;
  }

  .hero-mobile-visual-spacer {
    display: none;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    margin: 0 0 1.35rem;
    padding: 0.56rem 0.88rem;
    border: 1px solid rgba(105, 210, 84, 0.26);
    border-radius: 999px;
    background: rgba(237, 244, 234, 0.72);
    color: #299b2c;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-heading {
    margin: 0;
    max-width: 38rem;
    color: #0a0d0e;
    font-size: clamp(3.5rem, 5.25vw, 5.65rem);
    line-height: 0.94;
    letter-spacing: -0.057em;
    text-wrap: balance;
  }

  .hero-heading-line {
    white-space: nowrap;
  }

  .hero-heading em {
    color: #35aa35;
    font-style: normal;
    letter-spacing: -0.05em;
  }

  .hero-description {
    max-width: 31.5rem;
    margin: clamp(1.4rem, 2.1vw, 1.8rem) 0 0;
    color: rgba(15, 18, 19, 0.68);
    font-size: clamp(1rem, 1.08vw, 1.15rem);
    font-weight: 500;
    line-height: 1.58;
    letter-spacing: -0.015em;
  }

  .hero-description strong {
    color: #0f1213;
    font-weight: 720;
  }

  .hero-scope {
    display: grid;
    grid-template-columns: repeat(4, minmax(6.5rem, max-content));
    gap: 1.05rem 1.45rem;
    margin: 1.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-scope li {
    display: grid;
    grid-template-columns: 1.65rem auto;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    color: #0f1213;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .hero-scope svg {
    width: 1.65rem;
    height: 1.65rem;
    overflow: visible;
    fill: none;
    stroke: #299b2c;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .button-group {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    flex-wrap: wrap;
    margin-top: clamp(1.75rem, 2.5vw, 2.25rem);
  }

  .button-group .button {
    gap: 0.72rem;
    min-height: 3.65rem;
    padding-inline: 1.7rem;
    border-radius: 0.72rem;
    font-size: 0.95rem;
    font-weight: 780;
  }

  .button-group .button > svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .button-group .button.is-secondary {
    color: #0f1213;
    border-color: rgba(41, 155, 44, 0.48);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 12px 28px rgba(15, 18, 19, 0.05);
  }

  .play-icon {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding-left: 0.08rem;
    border-radius: 999px;
    background: #35aa35;
    color: #ffffff;
    font-size: 0.62rem;
    line-height: 1;
  }

  @media (max-width: 1120px) {
    .section-hero {
      align-items: flex-start;
    }

    .hero-copy {
      max-width: min(33rem, 49%);
      transform: none;
    }

    .hero-background img {
      object-position: 58% center;
    }

    .hero-background::after {
      background: linear-gradient(
        90deg,
        rgba(255, 255, 252, 0.99) 0%,
        rgba(255, 255, 252, 0.94) 42%,
        rgba(255, 255, 252, 0.62) 58%,
        rgba(255, 255, 252, 0.08) 78%
      );
    }
  }

  @media (max-width: 860px) {
    .section-hero {
      min-height: auto;
      padding: 7.3rem 0 0;
    }

    .hero-content {
      width: min(100% - 1.35rem, 1260px);
    }

    .hero-copy {
      max-width: 42rem;
      margin: 0 auto;
      text-align: center;
    }

    .hero-description {
      margin-inline: auto;
    }

    .hero-scope,
    .button-group {
      justify-content: center;
    }

    .hero-mobile-visual-spacer {
      display: block;
      height: clamp(23rem, 88vw, 34rem);
    }

    .hero-background img {
      top: auto;
      bottom: 0;
      height: clamp(18rem, 68vw, 26rem);
      min-height: 0;
      object-fit: cover;
      object-position: 64% center;
      transform: none;
    }

    .hero-background::after {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 252, 1) 0%,
        rgba(255, 255, 252, 0.98) 47%,
        rgba(255, 255, 252, 0.74) 56%,
        rgba(255, 255, 252, 0.12) 68%,
        rgba(255, 255, 252, 0) 80%
      );
    }

  }

  @media (max-width: 760px) {
    .hero-kicker {
      max-width: 100%;
      margin-bottom: 1.05rem;
      font-size: 0.62rem;
      letter-spacing: 0.065em;
    }

    .hero-heading {
      font-size: clamp(2.7rem, 12vw, 4.35rem);
      line-height: 0.97;
    }

    .hero-description {
      margin-top: 1.15rem;
      font-size: 0.98rem;
      line-height: 1.55;
    }

    .hero-scope {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.95rem 1rem;
      max-width: 24rem;
      margin: 1.35rem auto 0;
      text-align: left;
    }

    .hero-scope li {
      grid-template-columns: 1.55rem auto;
      font-size: 0.78rem;
    }

    .hero-scope svg {
      width: 1.55rem;
      height: 1.55rem;
    }

    .button-group,
    .button-group .button {
      width: 100%;
    }

    .button-group {
      gap: 0.72rem;
      margin-top: 1.55rem;
    }

    .button-group .button {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero-mobile-visual-spacer {
      height: 19rem;
    }
  }

  @media (max-width: 390px) {
    .hero-heading {
      font-size: 2.65rem;
    }

    .hero-kicker {
      justify-content: center;
      border-radius: 1rem;
    }
  }
</style>
