---
const phases = [
  {
    number: "01",
    title: "Find what is stuck",
    description: "Review the offer, website, campaigns, content rhythm, lead flow, and follow-up to identify the first useful move.",
  },
  {
    number: "02",
    title: "Build the business foundation",
    description: "Organize the audience, positioning, voice, visual references, approval rules, and commercial priorities Markethink needs to work well.",
  },
  {
    number: "03",
    title: "Ship the first focused motion",
    description: "Build the campaign, website update, content sequence, or pipeline workflow that matters most for the agreed starting scope.",
  },
  {
    number: "04",
    title: "Establish the operating rhythm",
    description: "Create the review, approval, reporting, and next-step cadence that keeps marketing moving after the first launch.",
  },
];
---

<section class="first-month" id="first-30-days">
  <div class="container">
    <div class="month-heading animate-fade-up">
      <div>
        <p class="subtitle">YOUR FIRST 30 DAYS</p>
        <h2>Start with one useful marketing problem. Build from there.</h2>
      </div>
      <p>
        Packages depend on scope, but the first month follows a clear principle: understand the business, organize the work, ship a focused motion, and establish what happens next.
      </p>
    </div>

    <div class="phase-grid animate-stagger">
      {phases.map((phase) => (
        <article class="phase-card">
          <span class="phase-number">{phase.number}</span>
          <h3>{phase.title}</h3>
          <p>{phase.description}</p>
        </article>
      ))}
    </div>

    <div class="accountability-grid animate-fade-up">
      <div class="accountability-intro">
        <p class="subtitle">POWERED BY AI. MANAGED BY EXPERTS.</p>
        <h3>You are not left alone with another tool.</h3>
      </div>
      <div class="accountability-role">
        <span>AI supports</span>
        <strong>Research, drafts, production, organization, and consistency</strong>
      </div>
      <div class="accountability-role">
        <span>Expert marketers own</span>
        <strong>Strategy, review, judgment, priorities, and accountability</strong>
      </div>
      <div class="accountability-role">
        <span>You control</span>
        <strong>Approvals, corrections, commercial decisions, and final direction</strong>
      </div>
    </div>
  </div>
</section>

<style>
  .first-month {
    padding: clamp(5rem, 9vw, 7.5rem) 0;
    background: #f5f5f1;
    color: #0f1213;
  }

  .month-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.72fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: 2.6rem;
  }

  .month-heading .subtitle {
    margin-bottom: 0.85rem;
    color: rgba(15, 18, 19, 0.5);
  }

  .month-heading h2 {
    max-width: 44rem;
    font-size: clamp(2.7rem, 5vw, 4.65rem);
    line-height: 0.98;
  }

  .month-heading > p {
    color: rgba(15, 18, 19, 0.62);
    line-height: 1.72;
  }

  .phase-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .phase-card {
    position: relative;
    min-height: 18rem;
    padding: 1.2rem;
    border: 1px solid rgba(15, 18, 19, 0.09);
    border-radius: 1.2rem;
    background: #edf4ea;
  }

  .phase-card::after {
    content: "";
    position: absolute;
    left: calc(100% + 0.15rem);
    top: 2rem;
    width: 0.5rem;
    height: 1px;
    background: rgba(15, 18, 19, 0.25);
  }

  .phase-card:last-child::after {
    display: none;
  }

  .phase-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: #69d254;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .phase-card h3 {
    margin-top: 2.4rem;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .phase-card p {
    margin-top: 0.8rem;
    color: rgba(15, 18, 19, 0.62);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .accountability-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 1.2fr) repeat(3, minmax(0, 0.8fr));
    gap: 0;
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.3rem;
    background: #0f1213;
    color: #f5f5f1;
  }

  .accountability-grid > div {
    min-height: 12rem;
    padding: 1.25rem;
  }

  .accountability-grid > div + div {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .accountability-intro .subtitle {
    color: #69d254;
  }

  .accountability-intro h3 {
    margin-top: 1rem;
    font-size: 2.2rem;
    line-height: 1;
  }

  .accountability-role {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  .accountability-role span {
    color: #69d254;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .accountability-role strong {
    color: rgba(245, 245, 241, 0.74);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .phase-grid,
    .accountability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .accountability-grid > div:nth-child(3) {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .accountability-grid > div:nth-child(4) {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  @media (max-width: 700px) {
    .month-heading,
    .phase-grid,
    .accountability-grid {
      grid-template-columns: 1fr;
    }

    .month-heading {
      gap: 1rem;
    }

    .phase-card {
      min-height: auto;
    }

    .phase-card h3 {
      margin-top: 1.6rem;
    }

    .phase-card::after {
      display: none;
    }

    .accountability-grid > div {
      min-height: auto;
    }

    .accountability-grid > div + div,
    .accountability-grid > div:nth-child(3) {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
  }
</style>
