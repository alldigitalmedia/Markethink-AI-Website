---
const { animate = true } = Astro.props as { animate?: boolean };

const auditOutputs = [
  "Where your marketing is getting stuck",
  "What is disconnected from leads and follow-up",
  "What Markethink would build first",
];
---

<section class="audit-section" id="audit">
  <div class="container audit-grid">
    <div class:list={["audit-copy", { "animate-fade-up": animate }]}>
      <p class="subtitle">MARKETING SYSTEM AUDIT</p>
      <h2>See what your marketing operation needs next.</h2>
      <p class="audit-intro">
        Tell us where the business is trying to grow and what keeps slowing the work down. We will review the current operation and reply with the strongest place to start.
      </p>
      <div class="audit-output-list">
        <p>THE AUDIT WILL MAP</p>
        <ul>
          {auditOutputs.map((item) => (
            <li><span aria-hidden="true">✓</span>{item}</li>
          ))}
        </ul>
      </div>
      <p class="audit-note">Packages depend on scope. The audit is designed to make the right first move clear before we recommend an engagement.</p>
    </div>

    <form
      name="markethink-marketing-system-audit"
      method="POST"
      action="/thank-you/"
      netlify
      data-netlify="true"
      data-netlify-recaptcha="true"
      netlify-honeypot="bot-field"
      class:list={["audit-form", { "animate-fade-up": animate }]}
    >
      <input type="hidden" name="form-name" value="markethink-marketing-system-audit" />
      <input type="hidden" name="source" value="homepage-marketing-system-audit" />
      <p class="hidden-field">
        <label>Do not fill this out <input name="bot-field" /></label>
      </p>

      <div class="form-header">
        <p>Request your audit</p>
        <h3>Tell us where marketing is stuck.</h3>
      </div>

      <div class="field-grid">
        <label>
          <span>Full name</span>
          <input type="text" name="full_name" autocomplete="name" required />
        </label>
        <label>
          <span>Work email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>

      <div class="field-grid">
        <label>
          <span>Phone number</span>
          <input type="tel" name="phone" autocomplete="tel" required />
        </label>
        <label>
          <span>Company or website</span>
          <input type="text" name="company_or_website" autocomplete="organization" required />
        </label>
      </div>

      <label>
        <span>Which path best describes you?</span>
        <select name="buyer_path" required>
          <option value="">Select one</option>
          <option>Growing brand</option>
          <option>Agency or referral partner</option>
          <option>Not sure yet</option>
        </select>
      </label>

      <label>
        <span>What is the biggest bottleneck in your marketing right now?</span>
        <textarea name="marketing_bottleneck" rows="4" required></textarea>
      </label>

      <div class="form-recaptcha" data-netlify-recaptcha="true" style="min-height:78px;margin-bottom:14px"></div>

      <button type="submit" class="button form-button">Request My Marketing System Audit</button>
      <p class="form-note">Prefer a conversation? <a href="/schedule-a-walkthrough/">Book a focused walkthrough.</a> By submitting, you agree to our <a href="/privacy/">privacy policy</a>.</p>
    </form>
  </div>
</section>

<style>
  .audit-section {
    padding: clamp(5rem, 9vw, 8rem) 0;
    background: #0f1213;
    color: #f5f5f1;
  }

  .audit-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(24rem, 0.72fr);
    gap: clamp(2rem, 7vw, 5rem);
    align-items: start;
  }

  .audit-copy {
    position: sticky;
    top: 7rem;
  }

  .audit-copy .subtitle {
    margin-bottom: 0.9rem;
    color: #69d254;
  }

  .audit-copy h2 {
    max-width: 42rem;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.97;
  }

  .audit-intro {
    max-width: 36rem;
    margin-top: 1.25rem;
    color: rgba(245, 245, 241, 0.68);
    line-height: 1.75;
  }

  .audit-output-list {
    max-width: 36rem;
    margin-top: 2.2rem;
    padding: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.15rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .audit-output-list > p {
    color: rgba(245, 245, 241, 0.5);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .audit-output-list ul {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .audit-output-list li {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    color: rgba(245, 245, 241, 0.78);
  }

  .audit-output-list li span {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: #69d254;
    color: #0f1213;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .audit-note {
    max-width: 36rem;
    margin-top: 1rem;
    color: rgba(245, 245, 241, 0.45);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .audit-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.2rem, 3vw, 1.6rem);
    border-radius: 1.5rem;
    background: #f5f5f1;
    color: #0f1213;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.3);
  }

  .hidden-field {
    display: none;
  }

  .form-header {
    margin-bottom: 0.2rem;
  }

  .form-header p {
    color: #299b2c;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .form-header h3 {
    margin-top: 0.45rem;
    font-size: 2.35rem;
    line-height: 1;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .audit-form label {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
  }

  .audit-form label > span {
    color: rgba(15, 18, 19, 0.72);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .audit-form input,
  .audit-form select,
  .audit-form textarea {
    width: 100%;
    border: 1px solid rgba(15, 18, 19, 0.12);
    border-radius: 0.7rem;
    background: #ffffff;
    color: #0f1213;
    font-family: var(--font-body);
    font-size: 0.92rem;
    padding: 0.86rem 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .audit-form textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .audit-form input:focus,
  .audit-form select:focus,
  .audit-form textarea:focus {
    border-color: #69d254;
    box-shadow: 0 0 0 4px rgba(105, 210, 84, 0.16);
  }

  .form-button {
    width: 100%;
    min-height: 3.4rem;
    border: 0;
    cursor: pointer;
  }

  .form-note {
    color: rgba(15, 18, 19, 0.55);
    font-size: 0.78rem;
    text-align: center;
  }

  .form-note a {
    color: #299b2c;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18rem;
  }

  @media (max-width: 860px) {
    .audit-grid {
      grid-template-columns: 1fr;
    }

    .audit-copy {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .field-grid {
      grid-template-columns: 1fr;
    }

    .audit-copy h2 {
      font-size: 3rem;
    }

    .form-header h3 {
      font-size: 2rem;
    }
  }
</style>
