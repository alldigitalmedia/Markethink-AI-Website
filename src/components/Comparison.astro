---
const options = [
  {
    label: "SELF-SERVE AI TOOLS",
    title: "You still manage the work.",
    points: [
      "You supply the prompts and context",
      "Outputs stay disconnected from execution",
      "Strategy and quality control remain on your plate",
      "Lead follow-up happens somewhere else",
    ],
  },
  {
    label: "DISCONNECTED SERVICES",
    title: "The work moves in separate lanes.",
    points: [
      "Strategy, content, web, and leads live apart",
      "Approvals get repeated across people and tools",
      "Business knowledge stays fragmented",
      "Commercial follow-up is easy to lose",
    ],
  },
  {
    label: "MARKETHINK",
    title: "One connected marketing operation.",
    points: [
      "The system learns and remembers the business",
      "AI supports production volume and consistency",
      "Expert marketers direct, review, and stay accountable",
      "Campaigns connect to leads, CRM, and follow-up",
    ],
    featured: true,
  },
];
---

<section class="comparison-section" id="comparison">
  <div class="container">
    <div class="comparison-heading animate-fade-up">
      <p class="subtitle">WHY MARKETHINK</p>
      <h2>You do not need another disconnected marketing tool.</h2>
      <p>
        You need the strategy, production, approvals, pipeline, and business memory to work as one operation.
      </p>
    </div>

    <div class="option-grid animate-stagger">
      {options.map((option) => (
        <article class={`option-card ${option.featured ? "featured" : ""}`}>
          <p class="option-label">{option.label}</p>
          <h3>{option.title}</h3>
          <ul>
            {option.points.map((point) => (
              <li><span aria-hidden="true">{option.featured ? "✓" : "·"}</span>{point}</li>
            ))}
          </ul>
          {option.featured && <a href="#audit" class="button">Request an Audit</a>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding: clamp(5rem, 9vw, 7.5rem) 0;
    background: #edf4ea;
    color: #0f1213;
  }

  .comparison-heading {
    max-width: 50rem;
    margin-bottom: 2.5rem;
  }

  .comparison-heading .subtitle {
    margin-bottom: 0.85rem;
    color: rgba(15, 18, 19, 0.5);
  }

  .comparison-heading h2 {
    font-size: clamp(2.7rem, 5vw, 4.65rem);
    line-height: 0.98;
  }

  .comparison-heading > p:last-child {
    max-width: 41rem;
    margin-top: 1rem;
    color: rgba(15, 18, 19, 0.64);
    line-height: 1.7;
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .option-card {
    display: flex;
    flex-direction: column;
    min-height: 27rem;
    padding: 1.45rem;
    border: 1px solid rgba(15, 18, 19, 0.09);
    border-radius: 1.4rem;
    background: rgba(245, 245, 241, 0.8);
  }

  .option-card.featured {
    background: #0f1213;
    color: #f5f5f1;
    border-color: #0f1213;
    transform: translateY(-0.8rem);
    box-shadow: 0 26px 64px rgba(15, 18, 19, 0.16);
  }

  .option-label {
    color: rgba(15, 18, 19, 0.48);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .featured .option-label {
    color: #69d254;
  }

  .option-card h3 {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .option-card ul {
    display: grid;
    gap: 0.9rem;
    margin: 1.5rem 0 2rem;
    padding: 0;
    list-style: none;
  }

  .option-card li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    color: rgba(15, 18, 19, 0.64);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .featured li {
    color: rgba(245, 245, 241, 0.72);
  }

  .option-card li span {
    color: #299b2c;
    font-weight: 800;
  }

  .featured li span {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.08rem;
    border-radius: 50%;
    background: #69d254;
    color: #0f1213;
    font-size: 0.62rem;
  }

  .option-card .button {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (max-width: 860px) {
    .option-grid {
      grid-template-columns: 1fr;
    }

    .option-card {
      min-height: auto;
    }

    .option-card.featured {
      transform: none;
    }
  }
</style>
