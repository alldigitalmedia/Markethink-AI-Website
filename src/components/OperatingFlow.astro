---
interface Props {
  sectionId?: string;
  includeInstagram?: boolean;
}

const { sectionId = "how-it-works", includeInstagram = true } = Astro.props;

const stages = [
  {
    number: "01",
    title: "Plan",
    description: "We ingest your website, socials, and offers. Short intake in chat. Channels connected.",
    items: ["Website", "Socials", "Offers"],
    kind: "plan",
    icon: "✦",
  },
  {
    number: "02",
    title: "Ship",
    description: "Written, designed, and published in your brand voice.",
    items: ["Social content", "Landing pages", "Email campaigns"],
    kind: "ship",
    icon: "↗",
  },
  {
    number: "03",
    title: "Convert",
    description: "Capture, CRM, and follow-up running through the channels you connect.",
    items: ["Lead capture", "CRM", "Follow-up"],
    kind: "convert",
    icon: "◎",
  },
  {
    number: "04",
    title: "Learn",
    description: "Every approval, correction, and result compounds. Month 6 output is sharper than month 1.",
    items: ["Approvals", "Corrections", "Results"],
    kind: "learn",
    icon: "↻",
  },
];

const channelLogos = [
  { name: "LinkedIn", src: "/brand-logos/linkedin.svg" },
  { name: "Instagram", src: "/brand-logos/instagram.svg" },
  { name: "YouTube", src: "/brand-logos/youtube.svg" },
  { name: "Meta", src: "/brand-logos/meta.svg" },
  { name: "Google Ads", src: "/brand-logos/google-ads.svg" },
].filter((logo) => includeInstagram || logo.name !== "Instagram");
---

<section class="operating-flow" id={sectionId} data-operating-story>
  <div class="flow-glow flow-glow-one" aria-hidden="true"></div>
  <div class="flow-glow flow-glow-two" aria-hidden="true"></div>

  <div class="container">
    <div class="flow-heading animate-fade-up">
      <div>
        <p class="subtitle">WHAT MARKETHINK MANAGES</p>
        <h2><span>We do not sell you a tool.</span><em>We run your marketing.</em></h2>
      </div>
      <p>
        Finished, published work through the channels you connect.
      </p>
    </div>

    <div class="flow-workspace animate-fade-up">
      <div class="phone-column">
        <div class="phone-wrap">
          <span class="phone-button phone-button-silent" aria-hidden="true"></span>
          <span class="phone-button phone-button-volume-one" aria-hidden="true"></span>
          <span class="phone-button phone-button-volume-two" aria-hidden="true"></span>
          <span class="phone-button phone-button-power" aria-hidden="true"></span>

          <div class="phone-frame" aria-label="Illustrative Markethink request conversation">
            <div class="phone-screen">
              <div class="phone-status" aria-hidden="true">
                <span>9:41</span>
                <span class="dynamic-island"></span>
                <span class="status-icons"><i></i><i></i><b></b></span>
              </div>

              <div class="chat-header">
                <span class="back-arrow" aria-hidden="true">‹</span>
                <span class="markethink-avatar">M</span>
                <div>
                  <strong>Markethink</strong>
                  <span><i></i> Expert-managed system</span>
                </div>
                <span class="chat-menu" aria-hidden="true">•••</span>
              </div>

              <div class="phone-stage-indicator" aria-live="polite">
                {stages.map((stage) => (
                  <div class={stage.kind === "plan" ? "is-active" : ""} data-flow-screen={stage.kind} aria-hidden={stage.kind === "plan" ? "false" : "true"}>
                    <small>{stage.number} · {stage.title}</small>
                    <strong>{stage.kind === "plan" ? "Campaign brief ready" : stage.kind === "ship" ? "Channel work ready" : stage.kind === "convert" ? "Lead routed to follow-up" : "Approval memory updated"}</strong>
                    <span>{stage.description}</span>
                  </div>
                ))}
              </div>

              <div class="phone-stage-previews" aria-label="Plan, Ship, Convert, and Learn previews">
                <div class="phone-preview is-active" data-flow-preview="plan">
                  <small>Campaign brief</small>
                  <dl><div><dt>Offer</dt><dd>New service</dd></div><div><dt>Audience</dt><dd>Priority buyers</dd></div><div><dt>Channels</dt><dd>Web, social, email</dd></div><div><dt>Approval</dt><dd>Expert review, then you</dd></div></dl>
                  <b>Brief ready for review</b>
                </div>
                <div class="phone-preview" data-flow-preview="ship">
                  <small>Work ready to ship</small>
                  <div class="phone-preview-website">
                    <img src="/images/markethink-ship-real-website-mockup.svg" alt="Preview of a polished architecture studio website ready to publish" loading="lazy" />
                  </div>
                  <b>Social · Landing · Email</b>
                </div>
                <div class="phone-preview" data-flow-preview="convert">
                  <small>New inquiry</small>
                  <div class="phone-preview-lead"><i>↗</i><span><strong>Campaign response</strong><em>Lead captured with context</em></span><b>Ready</b></div>
                  <div class="phone-preview-route"><span>Lead</span><i>→</i><span>CRM</span><i>→</i><span>Follow-up</span></div>
                </div>
                <div class="phone-preview" data-flow-preview="learn">
                  <small>Approval memory</small>
                  <ul><li><i>✓</i><span>Headline approved</span></li><li><i>↗</i><span>Audience refined</span></li><li><i>+</i><span>Result added</span></li></ul>
                  <b>Active for the next campaign</b>
                </div>
              </div>

              <div class="chat-thread phone-chat-original">
                <p class="sample-label">Example request</p>
                <div class="chat-row chat-row-user">
                  <div class="chat-bubble chat-bubble-user">
                    What does your business sell, in one sentence?
                  </div>
                </div>

                <div class="chat-row chat-row-markethink">
                  <span class="mini-avatar">M</span>
                  <div class="chat-bubble chat-bubble-markethink">
                    <p>You get a private campaign preview built from your public brand. Nothing is published.</p>
                    <ul>
                      <li><span>✓</span> One campaign angle</li>
                      <li><span>✓</span> One finished creative in your voice</li>
                      <li><span>✓</span> One landing-page concept</li>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="quick-actions" aria-label="Example follow-up actions">
                <span>You control what ships</span>
                <span>Approvals from your phone</span>
                <span>Dashboard receipts</span>
              </div>

              <div class="message-bar" aria-hidden="true">
                <span>+</span>
                <p>Message Markethink...</p>
                <b>↑</b>
              </div>
            </div>
          </div>
        </div>
        <p class="phone-caption"><span></span> Approvals happen in your connected chat channel, and the dashboard is there when you want receipts.</p>
      </div>

      <div class="flow-bridge" aria-hidden="true">
        <span></span>
      </div>

      <div class="stage-grid animate-stagger" aria-label="How Markethink runs the work">
        {stages.map((stage) => (
          <article class={`stage-card stage-${stage.kind}${stage.kind === "plan" ? " is-active" : ""}`} tabindex="0" data-flow-step={stage.kind} aria-current={stage.kind === "plan" ? "step" : undefined}>
            <span class="stage-number" aria-hidden="true">{stage.number}</span>
            <div class="stage-copy">
              <span class="stage-icon" aria-hidden="true">{stage.icon}</span>
              <div>
                <h3>{stage.title}</h3>
                <p>{stage.description}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="expert-band animate-fade-up">
      <div class="expert-label">
        <span class="expert-mark" aria-hidden="true">✦</span>
        <div>
          <strong>Expert direction at every stage</strong>
          <span>A real marketing team owns strategy, review, judgment, and accountability.</span>
        </div>
      </div>
      <div class="approval-lane" aria-label="Review lane">
        <span><b>✓</b> Markethink prepares</span>
        <i aria-hidden="true"></i>
        <span><b>✓</b> Experts review</span>
        <i aria-hidden="true"></i>
        <span class="approval-you"><b></b> You approve</span>
      </div>
    </div>
  </div>
</section>


<script is:inline>
  (() => {
    const init = () => {
      document.querySelectorAll('[data-operating-story]').forEach((root) => {
        if (root.dataset.storyReady) return;
        root.dataset.storyReady = 'true';
        const steps = [...root.querySelectorAll('[data-flow-step]')];
        const screens = [...root.querySelectorAll('[data-flow-screen]')];
        const previews = [...root.querySelectorAll('[data-flow-preview]')];
        const grid = root.querySelector('.stage-grid');
        if (!steps.length || !screens.length || !grid) return;
        let active = 0;
        const setActive = (index) => {
          active = Math.max(0, Math.min(steps.length - 1, index));
          steps.forEach((step, i) => {
            step.classList.toggle('is-active', i === active);
            step.classList.toggle('is-passed', i < active);
            if (i === active) step.setAttribute('aria-current', 'step'); else step.removeAttribute('aria-current');
          });
          screens.forEach((screen, i) => {
            screen.classList.toggle('is-active', i === active);
            screen.setAttribute('aria-hidden', i === active ? 'false' : 'true');
          });
          previews.forEach((preview, i) => {
            preview.classList.toggle('is-active', i === active);
            preview.setAttribute('aria-hidden', i === active ? 'false' : 'true');
          });
          grid.style.setProperty('--flow-progress', String(active / Math.max(1, steps.length - 1)));
        };
        const update = () => {
          if (innerWidth <= 820) return;
          const anchor = innerHeight * .5;
          let nearest = 0, distance = Infinity;
          steps.forEach((step, i) => {
            const rect = step.getBoundingClientRect();
            const d = Math.abs(rect.top + rect.height / 2 - anchor);
            if (d < distance) { distance = d; nearest = i; }
          });
          setActive(nearest);
        };
        steps.forEach((step, i) => {
          step.addEventListener('pointerenter', () => setActive(i));
          step.addEventListener('focus', () => setActive(i));
          step.addEventListener('click', () => setActive(i));
        });
        setActive(0);
        update();
        addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update, { passive: true });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true }); else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style>
  .operating-flow {
    position: relative;
    overflow-x: clip;
    overflow-y: visible;
    padding: clamp(5.5rem, 9vw, 8rem) 0;
    background:
      radial-gradient(circle at 94% 2%, rgba(105, 210, 84, 0.11), transparent 30rem),
      linear-gradient(150deg, #0b0f10 0%, #101516 54%, #0b1011 100%);
    color: #f5f5f1;
    isolation: isolate;
  }

  .operating-flow::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
  }

  .flow-glow {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
  }

  .flow-glow-one {
    width: 26rem;
    height: 26rem;
    top: 20rem;
    left: -18rem;
    background: rgba(105, 210, 84, 0.08);
  }

  .flow-glow-two {
    width: 20rem;
    height: 20rem;
    right: -12rem;
    bottom: 6rem;
    background: rgba(237, 244, 234, 0.06);
  }

  .flow-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.7fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .flow-heading .subtitle {
    margin-bottom: 0.9rem;
    color: #69d254;
  }

  .flow-heading h2 {
    max-width: 46rem;
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.96;
  }

  .flow-heading > p {
    max-width: 31rem;
    color: rgba(245, 245, 241, 0.66);
    font-size: clamp(0.96rem, 1.2vw, 1.08rem);
    line-height: 1.75;
  }

  .flow-workspace {
    position: relative;
    display: grid;
    grid-template-columns: minmax(17rem, 0.72fr) 3.8rem minmax(0, 1.52fr);
    gap: 0;
    align-items: center;
  }

  .phone-column {
    position: relative;
    z-index: 3;
  }

  .phone-wrap {
    position: relative;
    width: min(100%, 21.5rem);
    margin-inline: auto;
    filter: drop-shadow(0 34px 55px rgba(0, 0, 0, 0.45));
  }

  .phone-frame {
    position: relative;
    aspect-ratio: 0.515 / 1;
    padding: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 3.2rem;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.62), rgba(100, 108, 111, 0.58) 12%, #080a0b 34%, #2a3032 76%, rgba(255, 255, 255, 0.5));
    box-shadow:
      inset 0 0 0 2px rgba(0, 0, 0, 0.9),
      inset 0 0 0 4px rgba(255, 255, 255, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.14),
      0 28px 70px rgba(0, 0, 0, 0.42),
      0 0 80px rgba(105, 210, 84, 0.05);
  }

  .phone-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 2.72rem;
    background:
      radial-gradient(circle at 85% 20%, rgba(105, 210, 84, 0.08), transparent 14rem),
      #0b0e0f;
  }

  .phone-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(125deg, rgba(255, 255, 255, 0.08), transparent 17%, transparent 78%, rgba(255, 255, 255, 0.03));
  }

  .phone-button {
    position: absolute;
    z-index: -1;
    width: 0.22rem;
    border-radius: 0.16rem 0 0 0.16rem;
    background: linear-gradient(to bottom, #484e50, #0d1011 42%, #363b3d);
  }

  .phone-button-silent { left: -0.18rem; top: 16%; height: 2.6rem; }
  .phone-button-volume-one { left: -0.22rem; top: 24%; height: 4rem; }
  .phone-button-volume-two { left: -0.22rem; top: 34%; height: 4rem; }
  .phone-button-power { right: -0.21rem; top: 27%; height: 5.1rem; border-radius: 0 0.16rem 0.16rem 0; }

  .phone-status {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    color: rgba(245, 245, 241, 0.9);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .dynamic-island {
    width: 5.8rem;
    height: 1.65rem;
    border-radius: 999px;
    background: #000;
    box-shadow: inset -0.45rem 0 0.85rem rgba(255, 255, 255, 0.03);
  }

  .status-icons {
    display: flex;
    justify-content: flex-end;
    align-items: end;
    gap: 0.2rem;
  }

  .status-icons i {
    display: block;
    width: 0.16rem;
    height: 0.3rem;
    background: #f5f5f1;
    box-shadow: 0.22rem -0.08rem #f5f5f1, 0.44rem -0.18rem #f5f5f1;
  }

  .status-icons i:nth-child(2) {
    width: 0.72rem;
    height: 0.42rem;
    margin-left: 0.45rem;
    border: 1px solid #f5f5f1;
    border-width: 1px 0 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
  }

  .status-icons b {
    width: 0.78rem;
    height: 0.42rem;
    border: 1px solid rgba(245, 245, 241, 0.9);
    border-radius: 0.12rem;
    box-shadow: inset -0.15rem 0 #f5f5f1;
  }

  .chat-header {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 0.85rem 0.9rem;
    border-block: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.025);
    backdrop-filter: blur(20px);
  }

  .back-arrow {
    color: rgba(245, 245, 241, 0.74);
    font-size: 1.65rem;
    font-weight: 300;
  }

  .markethink-avatar,
  .mini-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 0.68rem;
    background: #69d254;
    color: #0f1213;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .markethink-avatar { width: 2.1rem; height: 2.1rem; }
  .mini-avatar { width: 1.8rem; height: 1.8rem; margin-top: 0.1rem; }

  .chat-header > div {
    display: flex;
    flex-direction: column;
    gap: 0.14rem;
  }

  .chat-header strong { font-size: 0.79rem; }
  .chat-header > div > span { color: rgba(245, 245, 241, 0.48); font-size: 0.58rem; }
  .chat-header > div > span i { display: inline-block; width: 0.38rem; height: 0.38rem; margin-right: 0.25rem; border-radius: 50%; background: #69d254; }
  .chat-menu { color: rgba(245, 245, 241, 0.58); font-size: 0.76rem; letter-spacing: 0.1em; }

  .chat-thread {
    flex: 1;
    padding: 1rem 0.75rem 0.65rem;
    overflow: hidden;
  }

  .sample-label {
    margin-bottom: 0.8rem;
    color: rgba(245, 245, 241, 0.34);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .chat-row { display: flex; margin-bottom: 0.72rem; }
  .chat-row-user { justify-content: flex-end; }
  .chat-row-markethink { align-items: flex-start; gap: 0.45rem; }

  .chat-bubble {
    padding: 0.78rem;
    color: rgba(245, 245, 241, 0.84);
    font-size: clamp(0.62rem, 0.75vw, 0.72rem);
    line-height: 1.55;
  }

  .chat-bubble-user {
    max-width: 82%;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.9rem 0.9rem 0.25rem 0.9rem;
    background: rgba(255, 255, 255, 0.08);
  }

  .chat-bubble-markethink {
    max-width: calc(100% - 2.25rem);
    border: 1px solid rgba(105, 210, 84, 0.18);
    border-radius: 0.9rem 0.9rem 0.9rem 0.25rem;
    background: linear-gradient(145deg, rgba(105, 210, 84, 0.16), rgba(105, 210, 84, 0.07));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .chat-bubble-markethink p { margin-bottom: 0.6rem; }
  .chat-bubble-markethink ul { display: grid; gap: 0.34rem; padding: 0; list-style: none; }
  .chat-bubble-markethink li { display: flex; align-items: center; gap: 0.38rem; color: rgba(245, 245, 241, 0.72); font-size: 0.6rem; }
  .chat-bubble-markethink li span { display: grid; place-items: center; width: 0.8rem; height: 0.8rem; border-radius: 50%; background: #69d254; color: #0f1213; font-size: 0.5rem; font-weight: 900; }

  .quick-actions {
    display: flex;
    gap: 0.35rem;
    padding: 0 0.75rem 0.65rem;
    overflow: hidden;
  }

  .quick-actions span {
    flex: 0 0 auto;
    padding: 0.4rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    color: rgba(245, 245, 241, 0.58);
    font-size: 0.52rem;
    white-space: nowrap;
  }

  .message-bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0.7rem 0.75rem;
    padding: 0.42rem 0.48rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .message-bar > span { display: grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: 50%; background: rgba(255, 255, 255, 0.07); color: rgba(245, 245, 241, 0.62); }
  .message-bar p { color: rgba(245, 245, 241, 0.32); font-size: 0.58rem; }
  .message-bar b { display: grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: 50%; background: #69d254; color: #0f1213; font-size: 0.76rem; }

  .phone-caption {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: min(100%, 20.5rem);
    margin: 1rem auto 0;
    color: rgba(245, 245, 241, 0.48);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .phone-caption span { flex: 0 0 auto; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #69d254; box-shadow: 0 0 0 0.3rem rgba(105, 210, 84, 0.09); }

  .flow-bridge {
    position: relative;
    align-self: stretch;
  }

  .flow-bridge::before,
  .flow-bridge::after {
    content: "";
    position: absolute;
    top: 50%;
  }

  .flow-bridge::before { left: 0.2rem; right: 0.45rem; height: 1px; background: linear-gradient(90deg, rgba(105, 210, 84, 0.15), #69d254); }
  .flow-bridge::after { right: 0.3rem; width: 0.52rem; height: 0.52rem; border-top: 1px solid #69d254; border-right: 1px solid #69d254; transform: translateY(-50%) rotate(45deg); }
  .flow-bridge span { position: absolute; left: 48%; top: 50%; width: 0.44rem; height: 0.44rem; border-radius: 50%; background: #69d254; transform: translate(-50%, -50%); box-shadow: 0 0 0 0.35rem rgba(105, 210, 84, 0.1), 0 0 1rem rgba(105, 210, 84, 0.45); }

  .stage-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .stage-grid::before,
  .stage-grid::after {
    content: "";
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(105, 210, 84, 0.65), transparent);
  }

  .stage-grid::before { left: 50%; top: 24%; width: 1px; height: 52%; background: linear-gradient(transparent, rgba(105, 210, 84, 0.62), transparent); }
  .stage-grid::after { left: 22%; top: 50%; width: 56%; height: 1px; }

  .stage-card {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 22rem;
    overflow: hidden;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.35rem;
    background:
