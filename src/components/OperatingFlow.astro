---
const stages = [
  {
    number: "01",
    title: "Plan",
    description: "Turn the request into a focused brief with the offer, audience, channel, and approval rules already in context.",
    items: ["Campaign brief", "Audience", "Channel plan"],
  },
  {
    number: "02",
    title: "Ship",
    description: "Create the work across the channels the campaign needs, then route it through expert review and client approval.",
    items: ["Landing page", "Social and email", "Advertising"],
  },
  {
    number: "03",
    title: "Convert",
    description: "Connect the campaign to lead capture, CRM, follow-up, and the next commercial action instead of stopping at content.",
    items: ["Lead capture", "CRM", "Follow-up"],
  },
  {
    number: "04",
    title: "Learn",
    description: "Carry approvals, corrections, and results into the next campaign so the system gets more useful over time.",
    items: ["Approval memory", "Corrections", "Results"],
  },
];
---

<section class="operating-flow" id="how-it-works">
  <div class="container">
    <div class="flow-heading animate-fade-up">
      <div>
        <p class="subtitle">ONE REQUEST. ONE CONNECTED OPERATION.</p>
        <h2>Watch the work move from request to result.</h2>
      </div>
      <p>
        Markethink does more than create an asset. It keeps the campaign, approvals, leads, follow-up, and business context moving together.
      </p>
    </div>

    <div class="flow-shell animate-fade-up">
      <div class="request-card">
        <div class="request-topline">
          <span class="request-avatar" aria-hidden="true">M</span>
          <span>New marketing request</span>
          <span class="live-dot">Received</span>
        </div>
        <div class="request-message">
          <p>“We need a campaign for our new offer. Build the landing page, social launch, email, and lead follow-up.”</p>
        </div>
        <div class="context-list" aria-label="Context already available">
          <span>Offer context</span>
          <span>Brand voice</span>
          <span>Past approvals</span>
          <span>Pipeline goal</span>
        </div>
      </div>

      <div class="flow-connector" aria-hidden="true">
        <span></span>
      </div>

      <div class="stage-grid animate-stagger">
        {stages.map((stage) => (
          <article class="stage-card">
            <div class="stage-head">
              <span>{stage.number}</span>
              <h3>{stage.title}</h3>
            </div>
            <p>{stage.description}</p>
            <ul>
              {stage.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="expert-band">
        <div class="expert-label">
          <span class="expert-mark" aria-hidden="true">✦</span>
          <div>
            <strong>Expert direction at every stage</strong>
            <span>A real marketing team owns strategy, review, judgment, and accountability.</span>
          </div>
        </div>
        <div class="approval-lane" aria-label="Review lane">
          <span>Markethink prepares</span>
          <i aria-hidden="true"></i>
          <span>Experts review</span>
          <i aria-hidden="true"></i>
          <span>You approve</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .operating-flow {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 9vw, 8rem) 0;
    background: #0f1213;
    color: #f5f5f1;
  }

  .operating-flow::before {
    content: "";
    position: absolute;
    width: 34rem;
    height: 34rem;
    top: -18rem;
    right: -12rem;
    border-radius: 50%;
    background: rgba(105, 210, 84, 0.09);
    filter: blur(60px);
    pointer-events: none;
  }

  .flow-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.7fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .flow-heading .subtitle {
    margin-bottom: 0.9rem;
    color: #69d254;
  }

  .flow-heading h2 {
    max-width: 43rem;
    font-size: clamp(2.7rem, 5vw, 4.8rem);
    line-height: 0.98;
  }

  .flow-heading > p {
    max-width: 31rem;
    color: rgba(245, 245, 241, 0.68);
    line-height: 1.75;
  }

  .flow-shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(16rem, 0.58fr) 3.5rem minmax(0, 1.45fr);
    gap: 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.75rem;
    background: #171b1c;
    box-shadow: 0 36px 100px rgba(0, 0, 0, 0.28);
  }

  .request-card {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.35rem;
    padding: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.25rem;
    background: #0f1213;
  }

  .request-topline {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.65rem;
    color: rgba(245, 245, 241, 0.65);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .request-avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    background: #69d254;
    color: #0f1213;
    font-size: 0.8rem;
    letter-spacing: 0;
  }

  .live-dot {
    color: #69d254;
    text-transform: none;
    letter-spacing: 0;
  }

  .request-message {
    position: relative;
    padding: 1.15rem;
    border-radius: 1rem 1rem 1rem 0.25rem;
    background: #f5f5f1;
    color: #0f1213;
  }

  .request-message p {
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .context-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .context-list span,
  .stage-card li {
    border: 1px solid rgba(105, 210, 84, 0.2);
    border-radius: 999px;
    background: rgba(105, 210, 84, 0.08);
    color: rgba(245, 245, 241, 0.74);
    font-size: 0.7rem;
    padding: 0.42rem 0.62rem;
  }

  .flow-connector {
    position: relative;
    min-height: 100%;
  }

  .flow-connector::before,
  .flow-connector::after {
    content: "";
    position: absolute;
    top: 50%;
  }

  .flow-connector::before {
    left: 0.65rem;
    right: 0.45rem;
    height: 1px;
    background: #69d254;
  }

  .flow-connector::after {
    right: 0.25rem;
    width: 0.55rem;
    height: 0.55rem;
    border-top: 1px solid #69d254;
    border-right: 1px solid #69d254;
    transform: translateY(-45%) rotate(45deg);
  }

  .flow-connector span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #69d254;
    box-shadow: 0 0 0 0.35rem rgba(105, 210, 84, 0.12);
  }

  .stage-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .stage-card {
    position: relative;
    min-height: 15rem;
    padding: 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.15rem;
    background: rgba(255, 255, 255, 0.035);
  }

  .stage-card:nth-child(3) {
    background: rgba(105, 210, 84, 0.08);
    border-color: rgba(105, 210, 84, 0.24);
  }

  .stage-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .stage-head > span {
    color: #69d254;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .stage-head h3 {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .stage-card > p {
    min-height: 5rem;
    color: rgba(245, 245, 241, 0.66);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .stage-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .expert-band {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: center;
    margin-top: 1rem;
    padding: 1rem 1.15rem;
    border-radius: 1.1rem;
    background: #edf4ea;
    color: #0f1213;
  }

  .expert-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .expert-label > div {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }

  .expert-label strong {
    font-size: 0.9rem;
  }

  .expert-label span:not(.expert-mark) {
    color: rgba(15, 18, 19, 0.62);
    font-size: 0.78rem;
  }

  .expert-mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: #69d254;
  }

  .approval-lane {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: rgba(15, 18, 19, 0.72);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .approval-lane i {
    width: 1.4rem;
    height: 1px;
    background: rgba(15, 18, 19, 0.24);
  }

  @media (max-width: 960px) {
    .flow-heading {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .flow-shell {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .flow-connector {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .operating-flow {
      padding: 4.75rem 0;
    }

    .flow-heading h2 {
      font-size: 2.75rem;
    }

    .stage-grid {
      grid-template-columns: 1fr;
    }

    .stage-card {
      min-height: auto;
    }

    .stage-card > p {
      min-height: auto;
    }

    .expert-band,
    .approval-lane {
      align-items: flex-start;
      flex-direction: column;
    }

    .approval-lane {
      gap: 0.4rem;
      padding-left: 3.15rem;
    }

    .approval-lane i {
      width: 1px;
      height: 0.65rem;
    }
  }
</style>
