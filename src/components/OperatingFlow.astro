---
interface Props {
  sectionId?: string;
  includeInstagram?: boolean;
}

const { sectionId = "how-it-works", includeInstagram = true } = Astro.props;

const stages = [
  {
    number: "01",
    title: "Plan",
    description: "Turn the request into a focused brief with the offer, audience, channel, and approval rules already in context.",
    items: ["Campaign brief", "Audience", "Channel plan"],
    kind: "plan",
  },
  {
    number: "02",
    title: "Ship",
    description: "Create the work across the channels the campaign needs, then route it through expert review and client approval.",
    items: ["Landing page", "Social and email", "Advertising"],
    kind: "ship",
  },
  {
    number: "03",
    title: "Convert",
    description: "Connect the campaign to lead capture, CRM, follow-up, and the next commercial action instead of stopping at content.",
    items: ["Lead capture", "CRM", "Follow-up"],
    kind: "convert",
  },
  {
    number: "04",
    title: "Learn",
    description: "Carry approvals, corrections, and results into the next campaign so the system gets more useful over time.",
    items: ["Approval memory", "Corrections", "Results"],
    kind: "learn",
  },
];

const channelLogos = [
  { name: "LinkedIn", src: "/brand-logos/linkedin.svg" },
  { name: "Instagram", src: "/brand-logos/instagram.svg" },
  { name: "YouTube", src: "/brand-logos/youtube.svg" },
  { name: "Meta", src: "/brand-logos/meta.svg" },
  { name: "Google Ads", src: "/brand-logos/google-ads.svg" },
].filter((logo) => includeInstagram || logo.name !== "Instagram");
---

<section class="operating-flow" id={sectionId}>
  <div class="flow-glow flow-glow-one" aria-hidden="true"></div>
  <div class="flow-glow flow-glow-two" aria-hidden="true"></div>

  <div class="container">
    <div class="flow-heading animate-fade-up">
      <div>
        <p class="subtitle">ONE REQUEST. ONE CONNECTED OPERATION.</p>
        <h2>Watch the work move from request to result.</h2>
      </div>
      <p>
        Markethink does more than create an asset. It keeps the campaign, approvals, leads, follow-up, and business context moving together.
      </p>
    </div>

    <div class="flow-workspace animate-fade-up">
      <div class="phone-column">
        <div class="phone-wrap">
          <span class="phone-button phone-button-silent" aria-hidden="true"></span>
          <span class="phone-button phone-button-volume-one" aria-hidden="true"></span>
          <span class="phone-button phone-button-volume-two" aria-hidden="true"></span>
          <span class="phone-button phone-button-power" aria-hidden="true"></span>

          <div class="phone-frame" aria-label="Illustrative Markethink request conversation">
            <div class="phone-screen">
              <div class="phone-status" aria-hidden="true">
                <span>9:41</span>
                <span class="dynamic-island"></span>
                <span class="status-icons"><i></i><i></i><b></b></span>
              </div>

              <div class="chat-header">
                <span class="back-arrow" aria-hidden="true">‹</span>
                <span class="markethink-avatar">M</span>
                <div>
                  <strong>Markethink</strong>
                  <span><i></i> Expert-managed system</span>
                </div>
                <span class="chat-menu" aria-hidden="true">•••</span>
              </div>

              <div class="chat-thread">
                <p class="sample-label">Example request</p>
                <div class="chat-row chat-row-user">
                  <div class="chat-bubble chat-bubble-user">
                    We need to launch a new service. Build the landing page, social campaign, email, and lead follow-up.
                  </div>
                </div>

                <div class="chat-row chat-row-markethink">
                  <span class="mini-avatar">M</span>
                  <div class="chat-bubble chat-bubble-markethink">
                    <p>Understood. We’ll turn it into one connected campaign and bring each decision back for approval.</p>
                    <ul>
                      <li><span>✓</span> Campaign brief prepared</li>
                      <li><span>✓</span> Assets routed for expert review</li>
                      <li><span>✓</span> Lead capture and follow-up mapped</li>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="quick-actions" aria-label="Example follow-up actions">
                <span>Looks good</span>
                <span>Add detail</span>
                <span>Change audience</span>
              </div>

              <div class="message-bar" aria-hidden="true">
                <span>+</span>
                <p>Message Markethink...</p>
                <b>↑</b>
              </div>
            </div>
          </div>
        </div>
        <p class="phone-caption"><span></span> One request enters with the business context already attached.</p>
      </div>

      <div class="flow-bridge" aria-hidden="true">
        <span></span>
      </div>

      <div class="stage-grid animate-stagger">
        {stages.map((stage) => (
          <article class={`stage-card stage-${stage.kind}`}>
            <div class="stage-shine" aria-hidden="true"></div>
            <div class="stage-head">
              <span>{stage.number}</span>
              <h3>{stage.title}</h3>
            </div>
            <p>{stage.description}</p>

            {stage.kind === "plan" && (
              <div class="stage-visual brief-card" aria-label="Illustrative campaign brief">
                <div class="brief-title">
                  <span>Campaign brief</span>
                  <i aria-hidden="true">✓</i>
                </div>
                <dl>
                  <div><dt>Offer</dt><dd>New service</dd></div>
                  <div><dt>Audience</dt><dd>Priority buyers</dd></div>
                  <div><dt>Channels</dt><dd>Web, social, email</dd></div>
                  <div><dt>Approval</dt><dd>Expert review, then you</dd></div>
                </dl>
              </div>
            )}

            {stage.kind === "ship" && (
              <div class="stage-visual ship-visual">
                <div class="mini-landing" aria-label="Illustrative landing page preview">
                  <span class="mini-nav"><b>m</b><i></i><i></i></span>
                  <strong>A clearer way<br />to grow.</strong>
                  <span class="mini-cta">Get started</span>
                </div>
                <div class="channel-logos" aria-label="Example marketing channels">
                  {channelLogos.map((logo) => (
                    <span class="logo-tile" title={logo.name}>
                      <img src={logo.src} alt={logo.name} loading="lazy" decoding="async" />
                    </span>
                  ))}
                </div>
              </div>
            )}

            {stage.kind === "convert" && (
              <div class="stage-visual convert-visual" aria-label="Illustrative lead routing workflow">
                <div class="lead-card">
                  <span class="lead-icon" aria-hidden="true">↗</span>
                  <div><strong>New inquiry</strong><span>Captured from campaign</span></div>
                  <b>Ready</b>
                </div>
                <div class="routing-row">
                  <span><i>01</i> Lead capture</span>
                  <b aria-hidden="true">→</b>
                  <span><i>02</i> CRM</span>
                  <b aria-hidden="true">→</b>
                  <span><i>03</i> Follow-up</span>
                </div>
              </div>
            )}

            {stage.kind === "learn" && (
              <div class="stage-visual learn-visual" aria-label="Illustrative approval memory">
                <div class="memory-head"><span>Approval memory</span><b>Active</b></div>
                <ul>
                  <li><span>✓</span><p><strong>Headline approved</strong><small>Saved for the next campaign</small></p></li>
                  <li><span>↗</span><p><strong>Audience refined</strong><small>Correction carried forward</small></p></li>
                  <li><span>+</span><p><strong>Result added</strong><small>Next plan starts sharper</small></p></li>
                </ul>
              </div>
            )}

            <ul class="stage-tags">
              {stage.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="expert-band">
        <div class="expert-label">
          <span class="expert-mark" aria-hidden="true">✦</span>
          <div>
            <strong>Expert direction at every stage</strong>
            <span>A real marketing team owns strategy, review, judgment, and accountability.</span>
          </div>
        </div>
        <div class="approval-lane" aria-label="Review lane">
          <span><b>✓</b> Markethink prepares</span>
          <i aria-hidden="true"></i>
          <span><b>✓</b> Experts review</span>
          <i aria-hidden="true"></i>
          <span class="approval-you"><b></b> You approve</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .operating-flow {
    position: relative;
    overflow: hidden;
    padding: clamp(5.5rem, 9vw, 8rem) 0;
    background:
      radial-gradient(circle at 94% 2%, rgba(105, 210, 84, 0.11), transparent 30rem),
      linear-gradient(150deg, #0b0f10 0%, #101516 54%, #0b1011 100%);
    color: #f5f5f1;
    isolation: isolate;
  }

  .operating-flow::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
  }

  .flow-glow {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
  }

  .flow-glow-one {
    width: 26rem;
    height: 26rem;
    top: 20rem;
    left: -18rem;
    background: rgba(105, 210, 84, 0.08);
  }

  .flow-glow-two {
    width: 20rem;
    height: 20rem;
    right: -12rem;
    bottom: 6rem;
    background: rgba(237, 244, 234, 0.06);
  }

  .flow-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.7fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .flow-heading .subtitle {
    margin-bottom: 0.9rem;
    color: #69d254;
  }

  .flow-heading h2 {
    max-width: 46rem;
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.96;
  }

  .flow-heading > p {
    max-width: 31rem;
    color: rgba(245, 245, 241, 0.66);
    font-size: clamp(0.96rem, 1.2vw, 1.08rem);
    line-height: 1.75;
  }

  .flow-workspace {
    position: relative;
    display: grid;
    grid-template-columns: minmax(17rem, 0.72fr) 3.8rem minmax(0, 1.52fr);
    gap: 0;
    align-items: center;
  }

  .phone-column {
    position: relative;
    z-index: 3;
  }

  .phone-wrap {
    position: relative;
    width: min(100%, 21.5rem);
    margin-inline: auto;
    filter: drop-shadow(0 34px 55px rgba(0, 0, 0, 0.45));
  }

  .phone-frame {
    position: relative;
    aspect-ratio: 0.515 / 1;
    padding: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 3.2rem;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.62), rgba(100, 108, 111, 0.58) 12%, #080a0b 34%, #2a3032 76%, rgba(255, 255, 255, 0.5));
    box-shadow:
      inset 0 0 0 2px rgba(0, 0, 0, 0.9),
      inset 0 0 0 4px rgba(255, 255, 255, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.14),
      0 28px 70px rgba(0, 0, 0, 0.42),
      0 0 80px rgba(105, 210, 84, 0.05);
  }

  .phone-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 2.72rem;
    background:
      radial-gradient(circle at 85% 20%, rgba(105, 210, 84, 0.08), transparent 14rem),
      #0b0e0f;
  }

  .phone-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(125deg, rgba(255, 255, 255, 0.08), transparent 17%, transparent 78%, rgba(255, 255, 255, 0.03));
  }

  .phone-button {
    position: absolute;
    z-index: -1;
    width: 0.22rem;
    border-radius: 0.16rem 0 0 0.16rem;
    background: linear-gradient(to bottom, #484e50, #0d1011 42%, #363b3d);
  }

  .phone-button-silent { left: -0.18rem; top: 16%; height: 2.6rem; }
  .phone-button-volume-one { left: -0.22rem; top: 24%; height: 4rem; }
  .phone-button-volume-two { left: -0.22rem; top: 34%; height: 4rem; }
  .phone-button-power { right: -0.21rem; top: 27%; height: 5.1rem; border-radius: 0 0.16rem 0.16rem 0; }

  .phone-status {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    color: rgba(245, 245, 241, 0.9);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .dynamic-island {
    width: 5.8rem;
    height: 1.65rem;
    border-radius: 999px;
    background: #000;
    box-shadow: inset -0.45rem 0 0.85rem rgba(255, 255, 255, 0.03);
  }

  .status-icons {
    display: flex;
    justify-content: flex-end;
    align-items: end;
    gap: 0.2rem;
  }

  .status-icons i {
    display: block;
    width: 0.16rem;
    height: 0.3rem;
    background: #f5f5f1;
    box-shadow: 0.22rem -0.08rem #f5f5f1, 0.44rem -0.18rem #f5f5f1;
  }

  .status-icons i:nth-child(2) {
    width: 0.72rem;
    height: 0.42rem;
    margin-left: 0.45rem;
    border: 1px solid #f5f5f1;
    border-width: 1px 0 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
  }

  .status-icons b {
    width: 0.78rem;
    height: 0.42rem;
    border: 1px solid rgba(245, 245, 241, 0.9);
    border-radius: 0.12rem;
    box-shadow: inset -0.15rem 0 #f5f5f1;
  }

  .chat-header {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 0.85rem 0.9rem;
    border-block: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.025);
    backdrop-filter: blur(20px);
  }

  .back-arrow {
    color: rgba(245, 245, 241, 0.74);
    font-size: 1.65rem;
    font-weight: 300;
  }

  .markethink-avatar,
  .mini-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 0.68rem;
    background: #69d254;
    color: #0f1213;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .markethink-avatar { width: 2.1rem; height: 2.1rem; }
  .mini-avatar { width: 1.8rem; height: 1.8rem; margin-top: 0.1rem; }

  .chat-header > div {
    display: flex;
    flex-direction: column;
    gap: 0.14rem;
  }

  .chat-header strong { font-size: 0.79rem; }
  .chat-header > div > span { color: rgba(245, 245, 241, 0.48); font-size: 0.58rem; }
  .chat-header > div > span i { display: inline-block; width: 0.38rem; height: 0.38rem; margin-right: 0.25rem; border-radius: 50%; background: #69d254; }
  .chat-menu { color: rgba(245, 245, 241, 0.58); font-size: 0.76rem; letter-spacing: 0.1em; }

  .chat-thread {
    flex: 1;
    padding: 1rem 0.75rem 0.65rem;
    overflow: hidden;
  }

  .sample-label {
    margin-bottom: 0.8rem;
    color: rgba(245, 245, 241, 0.34);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .chat-row { display: flex; margin-bottom: 0.72rem; }
  .chat-row-user { justify-content: flex-end; }
  .chat-row-markethink { align-items: flex-start; gap: 0.45rem; }

  .chat-bubble {
    padding: 0.78rem;
    color: rgba(245, 245, 241, 0.84);
    font-size: clamp(0.62rem, 0.75vw, 0.72rem);
    line-height: 1.55;
  }

  .chat-bubble-user {
    max-width: 82%;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.9rem 0.9rem 0.25rem 0.9rem;
    background: rgba(255, 255, 255, 0.08);
  }

  .chat-bubble-markethink {
    max-width: calc(100% - 2.25rem);
    border: 1px solid rgba(105, 210, 84, 0.18);
    border-radius: 0.9rem 0.9rem 0.9rem 0.25rem;
    background: linear-gradient(145deg, rgba(105, 210, 84, 0.16), rgba(105, 210, 84, 0.07));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .chat-bubble-markethink p { margin-bottom: 0.6rem; }
  .chat-bubble-markethink ul { display: grid; gap: 0.34rem; padding: 0; list-style: none; }
  .chat-bubble-markethink li { display: flex; align-items: center; gap: 0.38rem; color: rgba(245, 245, 241, 0.72); font-size: 0.6rem; }
  .chat-bubble-markethink li span { display: grid; place-items: center; width: 0.8rem; height: 0.8rem; border-radius: 50%; background: #69d254; color: #0f1213; font-size: 0.5rem; font-weight: 900; }

  .quick-actions {
    display: flex;
    gap: 0.35rem;
    padding: 0 0.75rem 0.65rem;
    overflow: hidden;
  }

  .quick-actions span {
    flex: 0 0 auto;
    padding: 0.4rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    color: rgba(245, 245, 241, 0.58);
    font-size: 0.52rem;
    white-space: nowrap;
  }

  .message-bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0.7rem 0.75rem;
    padding: 0.42rem 0.48rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .message-bar > span { display: grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: 50%; background: rgba(255, 255, 255, 0.07); color: rgba(245, 245, 241, 0.62); }
  .message-bar p { color: rgba(245, 245, 241, 0.32); font-size: 0.58rem; }
  .message-bar b { display: grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: 50%; background: #69d254; color: #0f1213; font-size: 0.76rem; }

  .phone-caption {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: min(100%, 20.5rem);
    margin: 1rem auto 0;
    color: rgba(245, 245, 241, 0.48);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .phone-caption span { flex: 0 0 auto; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #69d254; box-shadow: 0 0 0 0.3rem rgba(105, 210, 84, 0.09); }

  .flow-bridge {
    position: relative;
    align-self: stretch;
  }

  .flow-bridge::before,
  .flow-bridge::after {
    content: "";
    position: absolute;
    top: 50%;
  }

  .flow-bridge::before { left: 0.2rem; right: 0.45rem; height: 1px; background: linear-gradient(90deg, rgba(105, 210, 84, 0.15), #69d254); }
  .flow-bridge::after { right: 0.3rem; width: 0.52rem; height: 0.52rem; border-top: 1px solid #69d254; border-right: 1px solid #69d254; transform: translateY(-50%) rotate(45deg); }
  .flow-bridge span { position: absolute; left: 48%; top: 50%; width: 0.44rem; height: 0.44rem; border-radius: 50%; background: #69d254; transform: translate(-50%, -50%); box-shadow: 0 0 0 0.35rem rgba(105, 210, 84, 0.1), 0 0 1rem rgba(105, 210, 84, 0.45); }

  .stage-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .stage-grid::before,
  .stage-grid::after {
    content: "";
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(105, 210, 84, 0.65), transparent);
  }

  .stage-grid::before { left: 50%; top: 24%; width: 1px; height: 52%; background: linear-gradient(transparent, rgba(105, 210, 84, 0.62), transparent); }
  .stage-grid::after { left: 22%; top: 50%; width: 56%; height: 1px; }

  .stage-card {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 22rem;
    overflow: hidden;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.35rem;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.018)),
      rgba(22, 28, 29, 0.64);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.06),
      0 18px 45px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(24px) saturate(125%);
    -webkit-backdrop-filter: blur(24px) saturate(125%);
  }

  .stage-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 78% 0%, rgba(105, 210, 84, 0.12), transparent 16rem);
    transition: opacity 0.35s ease;
  }

  .stage-card:hover { border-color: rgba(105, 210, 84, 0.28); transform: translateY(-3px); }
  .stage-card:hover::after { opacity: 1; }

  .stage-shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.055), transparent 24%);
  }

  .stage-head { position: relative; display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.7rem; }
  .stage-head > span { color: #69d254; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.08em; }
  .stage-head h3 { font-family: var(--font-body); font-size: 1.38rem; font-weight: 650; }
  .stage-card > p { position: relative; min-height: 4.45rem; color: rgba(245, 245, 241, 0.62); font-size: 0.82rem; line-height: 1.62; }

  .stage-visual {
    position: relative;
    min-height: 7.75rem;
    margin-top: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.9rem;
    background: rgba(4, 7, 8, 0.35);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.035);
  }

  .brief-card { padding: 0.8rem; background: linear-gradient(145deg, rgba(245, 245, 241, 0.94), rgba(237, 244, 234, 0.88)); color: #0f1213; }
  .brief-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
