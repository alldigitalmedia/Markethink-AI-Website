---
interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props;
const isSpanish = lang === "es";

const exploreLinks = isSpanish ? [
  { label: "Inicio", href: "/es/" },
  { label: "Cómo funciona", href: "/es/#how-it-works" },
  { label: "Trabajo real", href: "/es/trabajo-real/" },
  { label: "Por qué Markethink", href: "/es/#why-markethink" },
  { label: "Ideas", href: "/blog/" },
] : [
  { label: "Home", href: "/" },
  { label: "How it works", href: "/#how-it-works" },
  { label: "Real work", href: "/shipped/" },
  { label: "Why Markethink", href: "/#why-markethink" },
  { label: "Insights", href: "/blog/" },
];

const connectLinks = isSpanish ? [
  { label: "Solicitar una demo", href: "/es/solicitar-demo/" },
  { label: "Contacto", href: "mailto:hello@markethink.ai" },
  { label: "Ingresar", href: "https://dashboard.markethink.ai/" },
] : [
  { label: "Book A Demo", href: "/schedule-a-walkthrough/" },
  { label: "Contact", href: "mailto:hello@markethink.ai" },
  { label: "Log in", href: "https://dashboard.markethink.ai/" },
];

const companyLinks = isSpanish ? [
  { label: "Privacidad", href: "/privacy/", external: false },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/markethink-ai/", external: true },
  { label: "Instagram", href: "https://www.instagram.com/markethink.ai/", external: true },
] : [
  { label: "Privacy", href: "/privacy/", external: false },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/markethink-ai/", external: true },
  { label: "Instagram", href: "https://www.instagram.com/markethink.ai/", external: true },
];
---

<div class="site-footer-wrap">
  <footer class="site-footer">
    <div class="site-footer-brand">
      <a href={isSpanish ? "/es/" : "/"} aria-label={isSpanish ? "Inicio de Markethink" : "Markethink home"}><img src="/images/logo.svg" alt="Markethink" /></a>
      <p>{isSpanish ? "Markethink es un sistema de marketing con IA gestionado por expertos. Aprende tu negocio, ejecuta el marketing día a día y conecta las campañas con prospectos y seguimiento." : "Markethink is an AI marketing system managed by expert marketers. It learns your business, runs marketing day to day, and connects campaigns to leads and follow-up."}</p>
    </div>
    <nav class="site-footer-nav" aria-label={isSpanish ? "Navegación del pie" : "Footer navigation"}>
      <div>
        <strong>{isSpanish ? "Explora" : "Explore"}</strong>
        {exploreLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <div>
        <strong>{isSpanish ? "Conecta" : "Connect"}</strong>
        {connectLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <div>
        <strong>{isSpanish ? "Empresa" : "Company"}</strong>
        {companyLinks.map((link) => <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>{link.label}</a>)}
        <span>{isSpanish ? "Impulsado por IA" : "Powered by AI"}</span>
        <span>{isSpanish ? "Gestionado por expertos" : "Managed by experts"}</span>
      </div>
    </nav>
    <div class="site-footer-bottom">
      <span>© Markethink</span>
      <strong>{isSpanish ? "Tu operación de marketing, impulsada por IA y gestionada por expertos." : "Your marketing operation, powered by AI and managed by experts."}</strong>
    </div>
  </footer>
</div>

<style>
  .site-footer-wrap {
    --footer-transition-depth: clamp(54px, 7vw, 96px);
    width: 100vw;
    margin-top: calc(var(--footer-transition-depth) * -1);
    margin-left: calc(50% - 50vw);
    padding: calc(var(--footer-transition-depth) * 2) max(14px, calc((100vw - 1440px) / 2)) 0;
    box-sizing: border-box;
    background: linear-gradient(
      180deg,
      rgba(15, 18, 19, 0) 0%,
      rgba(15, 18, 19, 0.2) 22%,
      rgba(15, 18, 19, 0.82) 60%,
      #0F1213 100%
    );
    pointer-events: none;
    position: relative;
    z-index: 2;
  }

  .site-footer {
    width: 100%;
    max-width: 1172px;
    margin: 0 auto;
    display: grid;
    pointer-events: auto;
    grid-template-columns: minmax(280px, 1.05fr) minmax(480px, 1.4fr);
    gap: clamp(28px, 4vw, 58px);
    padding: clamp(22px, 2.6vw, 32px) clamp(34px, 4vw, 54px) clamp(18px, 2vw, 26px);
    border-radius: 32px 32px 0 0;
    background: rgba(245, 245, 241, 0.97);
    color: #0F1213;
    box-shadow: 0 -24px 70px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(16px) saturate(112%);
    -webkit-backdrop-filter: blur(16px) saturate(112%);
  }

  .site-footer-brand img {
    display: block;
    width: 158px;
    height: auto;
  }

  .site-footer-brand p {
    max-width: 470px;
    margin: 12px 0 0;
    color: #525854;
    line-height: 1.5;
    font-size: 15px;
  }

  .site-footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .site-footer-nav > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
  }

  .site-footer-nav strong {
    margin-bottom: 4px;
    font-size: 13px;
  }

  .site-footer-nav a,
  .site-footer-nav span {
    color: #525854;
    text-decoration: none;
    font-size: 13px;
    line-height: 1.3;
  }

  .site-footer-nav a:hover,
  .site-footer-nav a:focus-visible {
    color: #315b28;
  }

  .site-footer-bottom {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding-top: 14px;
    border-top: 1px solid #d7ddd3;
    color: #686B6C;
    font-size: 12px;
  }

  .site-footer-bottom strong {
    color: #315b28;
    font-weight: 700;
    text-align: right;
  }

  @media (max-width: 980px) {
    .site-footer {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .site-footer-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .site-footer-bottom {
      margin-top: 2px;
    }
  }

  @media (max-width: 680px) {
    .site-footer-wrap {
      --footer-transition-depth: 64px;
      padding-right: 10px;
      padding-left: 10px;
    }

    .site-footer {
      padding: 26px 24px 20px;
      border-radius: 26px 26px 0 0;
      gap: 24px;
    }

    .site-footer-nav {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .site-footer-nav > div:last-child {
      grid-column: 1 / -1;
    }

    .site-footer-bottom {
      display: grid;
      gap: 9px;
    }

    .site-footer-bottom strong {
      text-align: left;
    }

    .site-footer-brand p {
      font-size: 14px;
    }
  }
</style>
