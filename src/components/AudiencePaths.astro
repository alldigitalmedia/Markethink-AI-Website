---
const paths = [
  {
    modifier: "brands",
    eyebrow: "FOR GROWING BRANDS",
    title: "A marketing operation that keeps shipping.",
    description: "Run campaigns, content, website updates, advertising, and lead follow-up without building every capability in-house.",
    points: [
      "Give every campaign the same business context",
      "Keep approvals and next steps from getting buried",
      "Connect marketing activity to leads and follow-up",
    ],
    cta: "Request an Audit",
    href: "#audit",
  },
  {
    modifier: "agencies",
    eyebrow: "FOR AGENCIES",
    title: "More delivery capacity without more chaos.",
    description: "Give each client a dedicated marketing system while your team keeps the relationship, strategy, and commercial direction.",
    points: [
      "Organize brand context and approvals by client",
      "Expand website, campaign, content, and lead delivery",
      "Create a consistent operating rhythm across accounts",
    ],
    cta: "Explore Agency Delivery",
    href: "/schedule-a-walkthrough/",
  },
];
---

<section class="audience-paths" id="who-its-for">
  <div class="container">
    <div class="audience-heading animate-fade-up">
      <p class="subtitle">BUILT FOR TWO GROWTH PATHS</p>
      <h2>One system. Different ways to grow.</h2>
      <p>Markethink can run the marketing operation behind a growing brand or expand the delivery capacity behind an agency.</p>
    </div>

    <div class="path-grid animate-stagger">
      {paths.map((path) => (
        <article class={`path-card path-card-${path.modifier}`}>
          <p class="path-eyebrow">{path.eyebrow}</p>
          <h3>{path.title}</h3>
          <p class="path-description">{path.description}</p>
          <ul>
            {path.points.map((point) => (
              <li><span aria-hidden="true">✓</span>{point}</li>
            ))}
          </ul>
          <a href={path.href} class={`button ${path.modifier === "agencies" ? "is-secondary" : ""}`}>{path.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .audience-paths {
    padding: clamp(5rem, 9vw, 7.5rem) 0;
    background: #f5f5f1;
    color: #0f1213;
  }

  .audience-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.75fr);
    column-gap: 3rem;
    align-items: end;
    margin-bottom: 2.6rem;
  }

  .audience-heading .subtitle {
    grid-column: 1 / -1;
    margin-bottom: 0.85rem;
    color: rgba(15, 18, 19, 0.5);
  }

  .audience-heading h2 {
    max-width: 40rem;
    font-size: clamp(2.7rem, 5vw, 4.65rem);
    line-height: 0.98;
  }

  .audience-heading > p:last-child {
    max-width: 30rem;
    color: rgba(15, 18, 19, 0.62);
    line-height: 1.72;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .path-card {
    display: flex;
    flex-direction: column;
    min-height: 31rem;
    padding: clamp(1.45rem, 3vw, 2.2rem);
    border-radius: 1.6rem;
  }

  .path-card-brands {
    border: 1px solid rgba(15, 18, 19, 0.08);
    background: #edf4ea;
    color: #0f1213;
  }

  .path-card-agencies {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #0f1213;
    color: #f5f5f1;
  }

  .path-eyebrow {
    color: #299b2c;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .path-card-agencies .path-eyebrow {
    color: #69d254;
  }

  .path-card h3 {
    max-width: 32rem;
    margin-top: 1.1rem;
    font-size: clamp(2.3rem, 4vw, 3.6rem);
    line-height: 1;
  }

  .path-description {
    max-width: 33rem;
    margin-top: 1rem;
    color: rgba(15, 18, 19, 0.64);
    line-height: 1.7;
  }

  .path-card-agencies .path-description {
    color: rgba(245, 245, 241, 0.66);
  }

  .path-card ul {
    display: grid;
    gap: 0.85rem;
    margin: 2rem 0 2.2rem;
    padding: 0;
    list-style: none;
  }

  .path-card li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    line-height: 1.55;
  }

  .path-card li span {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.45rem;
    height: 1.45rem;
    margin-top: 0.05rem;
    border-radius: 50%;
    background: #69d254;
    color: #0f1213;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .path-card .button {
    align-self: flex-start;
    margin-top: auto;
  }

  .path-card-agencies .button.is-secondary {
    color: #f5f5f1;
  }

  @media (max-width: 780px) {
    .audience-heading,
    .path-grid {
      grid-template-columns: 1fr;
    }

    .audience-heading {
      gap: 1rem;
    }

    .path-card {
      min-height: auto;
    }
  }
</style>
